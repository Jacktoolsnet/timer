---
import { languages } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props;
const target = '/' + lang + '/';
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8" /><meta name="robots" content="noindex, follow" /><link rel="canonical" href={new URL(target, Astro.site)} /><meta http-equiv="refresh" content={'0;url=' + target} /><title>jacktools.net</title><script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script></head><body><a href={target}>→ Timer</a></body></html>
