---
import '../styles/global.css';
import { colorSchemes } from '../lib/engine';
import { getDictionary, languages, languageNames, type Language } from '../lib/i18n';
interface Props { lang: Language; title: string; description: string; route: string; noindex?: boolean; legal?: boolean }
const { lang, title, description, route, noindex = false, legal = false } = Astro.props;
const t = getDictionary(lang);
const canonical = new URL(Astro.url.pathname === '/' ? '/en/timer/' : Astro.url.pathname, Astro.site);
const alternateLanguages = legal ? (['en', 'de'] as const) : languages;
---
<!doctype html>
<html lang={lang} data-palette="terracotta" data-style="warm">
  <head>
    <meta charset="UTF-8" />
    {Astro.url.pathname === '/' && <script is:inline>
      // Only negotiate language on the neutral entry URL, never on localized pages.
      const supportedLanguages = ['en', 'de', 'es', 'fr'];
      const browserLanguages = navigator.languages?.length ? navigator.languages : [navigator.language || 'en'];
      let preferredLanguage = browserLanguages
        .map(language => language.toLowerCase().split('-')[0])
        .find(language => supportedLanguages.includes(language)) || 'en';
      try {
        const saved = JSON.parse(localStorage.getItem('jacktools.timer.appearance.v1') || 'null');
        if (supportedLanguages.includes(saved?.language)) preferredLanguage = saved.language;
      } catch {}
      window.location.replace('/' + preferredLanguage + '/timer/' + window.location.search + window.location.hash);
    </script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f5ee" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title} · Jacktools</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternateLanguages.map(l => <link rel="alternate" hreflang={l} href={new URL('/' + l + '/' + route + '/', Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/en/' + route + '/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title + ' · Jacktools'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      try {
        const s = JSON.parse(localStorage.getItem('jacktools.timer.settings.v1') || 'null');
        if (s?.remember === true) {
          if (s.dark === true) document.documentElement.dataset.theme = 'dark';
          if (['terracotta', 'blue', 'green', 'orange', 'red', 'violet', 'teal', 'rose'].includes(s.colorScheme)) {
            document.documentElement.dataset.palette = s.colorScheme;
          }
        }
      } catch {}
      try {
        const saved = JSON.parse(localStorage.getItem('jacktools.timer.appearance.v1') || 'null');
        if (saved) {
          if (typeof saved.dark === 'boolean') document.documentElement.dataset.theme = saved.dark ? 'dark' : 'light';
          if (['terracotta', 'blue', 'green', 'orange', 'red', 'violet', 'teal', 'rose'].includes(saved.colorScheme)) document.documentElement.dataset.palette = saved.colorScheme;
          if (['warm', 'minimal', 'technical', 'soft'].includes(saved.style)) document.documentElement.dataset.style = saved.style;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt' : lang === 'es' ? 'Ir al contenido' : lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={'/' + lang + '/timer/'} aria-label="Jacktools Timer">
          <span class="brand-icon"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="18" r="10"/><path d="M16 18v-6m-3-9h6m-3 0v5m9 2 3-3"/></svg></span>
          <span>jacktools<span class="brand-dot">.</span>net <span class="brand-product">/ timer</span></span>
        </a>
        <div class="header-tools">
          <details class="language-dropdown" id="language-dropdown">
            <summary id="language" aria-label={t.language + ': ' + languageNames[lang]}>
              <svg class="language-globe" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18M12 3c-5 5-5 13 0 18"/></svg>
              <span>{languageNames[lang]}</span>
              <svg class="language-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"/></svg>
            </summary>
            <nav class="language-menu" aria-label={t.language}>
              {alternateLanguages.map(l => <a href={'/' + l + '/' + route + '/'} lang={l} hreflang={l} aria-current={l === lang ? 'page' : undefined}>
                <span class="language-code" aria-hidden="true">{l.toUpperCase()}</span>
                <span>{languageNames[l]}</span>
                {l === lang && <svg class="language-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4 10-10"/></svg>}
              </a>)}
            </nav>
          </details>
          <details class="palette-dropdown" id="palette-dropdown">
            <summary aria-label={t.colorScheme} title={t.colorScheme}>
              <span id="active-palette" class="palette-swatch" data-color="terracotta" aria-hidden="true"></span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"/></svg>
            </summary>
            <div class="palette-menu">
            <fieldset class="palette-grid">
              <legend class="sr-only">{t.colorScheme}</legend>
              {colorSchemes.map(color => <label class="palette-option" title={t[color]}>
                <input type="radio" name="colorScheme" value={color} aria-label={t[color]} checked={color === 'terracotta'} />
                <span class="palette-chip"><span class="palette-swatch" data-color={color} aria-hidden="true"></span></span>
              </label>)}
            </fieldset>
            <fieldset class="style-picker">
              <legend>{t.styleLabel}</legend>
              {(['warm', 'minimal', 'technical', 'soft'] as const).map(style => <label title={t[style]}>
                <input type="radio" name="visualStyle" aria-label={t[style]} value={style} checked={style === 'warm'} />
                <span data-style-preview={style}>
                  {style === 'warm' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19h5m-2.5 0 5-14 5 14M15 19h5M10 13h6"/></svg>}
                  {style === 'minimal' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 12h10M5 18h14"/></svg>}
                  {style === 'technical' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 6-5 6 5 6m8-12 5 6-5 6M14 4l-4 16"/></svg>}
                  {style === 'soft' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="7"/><path d="M8 9c0-1 1-2 2-2"/></svg>}
                </span>
              </label>)}
            </fieldset>
            </div>
          </details>
          <button class="theme-button" id="theme" aria-label={t.theme} aria-pressed="false" title={t.theme}><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.3A8.6 8.6 0 0 1 8.7 4 8.6 8.6 0 1 0 20 15.3Z"/></svg><svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div><a class="footer-brand" href={'/' + lang + '/timer/'}>jacktools.net</a><p>{t.footer}</p></div>
        <nav aria-label={t.legal}><a href={'/' + (lang === 'de' ? 'de' : 'en') + '/legal/'}>{t.legal}{!['de','en'].includes(lang) && ' (EN)'}</a><a href={'/' + (lang === 'de' ? 'de' : 'en') + '/privacy/'}>{t.privacy}{!['de','en'].includes(lang) && ' (EN)'}</a><button id="privacy-open">{t.preferences}</button></nav>
      </footer>
    </div>
    <dialog id="privacy-dialog" aria-labelledby="privacy-title">
      <div class="dialog-inner"><span class="eyebrow">JACKTOOLS / PRIVACY</span><h2 id="privacy-title">{t.privacyTitle}</h2><p>{t.privacyBody}</p><p class="notice">{t.privacyNote}</p><p>{t.legalLanguage}</p><p id="privacy-status" role="status"></p><div class="dialog-actions"><button class="secondary" id="clear-storage" data-message={t.cleared} data-error={t.storageError}>{t.clear}</button><form method="dialog"><button class="primary">{t.close}</button></form></div></div>
    </dialog>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
