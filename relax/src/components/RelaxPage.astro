---
import Layout from '../layouts/Layout.astro';
import NumberStepper from './NumberStepper.astro';
import {dictionaries} from '../lib/relax-i18n';
import type {Language} from '../lib/i18n';
interface Props {lang:Language}
const {lang}=Astro.props,t=dictionaries[lang];
---
<Layout lang={lang} title={lang==='de'?'Relax – ruhige Klänge und sanfte Formen':t.title} description={t.intro} route="">
 <section class="intro"><h1>{t.title}</h1><p class="intro-copy">{t.intro}</p></section>
 <div class="workspace" id="relax-app">
  <section class="timer-card relax-card">
   <div class="relax-top"><span>Relax</span><button id="focus" class="icon-text" aria-label={t.focus} title={t.focus} aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg><span>{t.focus}</span></button></div>
   <div id="sound-stage" aria-hidden="true"><div class="ambient-glow"></div><div id="sound-shapes"></div><span class="scene-word">relax</span></div>
   <p id="state" role="status">{t.ready}</p>
   <div class="timer-controls"><button id="start" class="primary" aria-label={t.start} title={t.start}><svg viewBox="0 0 24 24" aria-hidden="true"><path id="start-icon" d="m8 5 11 7-11 7Z" fill="currentColor" stroke="none"/></svg></button><button id="end-session" class="secondary" aria-label={t.end} title={t.end} disabled><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1" fill="currentColor" stroke="none"/></svg></button></div>
   <p class="relax-meta"><span id="session">{t.remaining} 15:00</span></p><progress id="session-progress" value="0" max="900" aria-label={t.remaining}></progress>
   <p id="wake-status" role="status"></p><p id="audio-status" role="status"></p>
   <div class="relax-safety"><p>{t.reminder}</p><button id="safety-open" class="safety-link">{t.safetyLink}</button></div>
  </section>
  <section class="settings-card"><h2>{t.settings}</h2><form id="relax-form">
   <div class="relax-field instrument-field"><span id="instrument-label">{lang==='de'?'Instrument':lang==='es'?'Instrumento':'Instrument'}</span><details id="instrument-dropdown"><summary aria-labelledby="instrument-label instrument-value"><span id="instrument-value">{t.chimes}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><fieldset class="instrument-options" aria-labelledby="instrument-label">{(['chimes','bowls','kalimba','handpan'] as const).map(key=><label><input type="radio" name="instrument" value={key} checked={key==='chimes'}/><span class="instrument-option-copy"><strong>{t[key]}</strong><small>{t.instrumentDescriptions[key]}</small></span><svg class="instrument-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></label>)}</fieldset></details></div>
   <label class="relax-check"><span>{t.instrumentAnimation}</span><span class="storage-switch"><input id="instrumentAnimation" type="checkbox" role="switch" checked/><span class="storage-switch-track" aria-hidden="true"></span></span></label>
   <label class="relax-field">{t.instrumentVolume}<input id="instrumentVolume" type="range" min="0" max="100" value="45"/><output id="instrumentVolume-value">45 %</output></label>
   <label class="relax-field">{t.pitch}<input id="pitch" type="range" min="-12" max="12" step="1" value="0" aria-describedby="pitch-hint"/><output id="pitch-value">{t.pitchOriginal}</output><span class="pitch-scale"><span>{t.pitchLow}</span><span>{t.pitchHigh}</span></span><small id="pitch-hint">{t.pitchHint}</small></label>
   <label class="relax-field">{t.density}<input id="density" type="range" min="1" max="10" value="5"/><small>{t.densityHint}</small></label>
   <div class="relax-field"><label for="minutes">{t.duration}</label><NumberStepper id="minutes" label={t.duration} min={0} max={180} step={1} value={15} decrease={t.decrease} increase={t.increase}/><small>{t.unlimited}</small></div>
   <fieldset class="ambient-settings"><legend>{lang==='de'?'Hintergrundklänge':lang==='es'?'Sonidos de fondo':lang==='fr'?'Fonds sonores':'Background sounds'}</legend>
   {(['rain','wind','noise'] as const).map(key=><div class="layer-settings"><label class="relax-check"><span>{t[key]}</span><span class="storage-switch"><input id={key} type="checkbox" role="switch"/><span class="storage-switch-track" aria-hidden="true"></span></span></label><label class="relax-field">{t[key]} · {t.volume}<input id={key+'Volume'} type="range" min="0" max="100" value={key==='rain'?25:20}/><output id={key+'Volume-value'}>{key==='rain'?25:20} %</output></label>{key==='rain'&&<label class="relax-check"><span>{t.rainAnimation}</span><span class="storage-switch"><input id="rainAnimation" type="checkbox" role="switch"/><span class="storage-switch-track" aria-hidden="true"></span></span></label>}{key==='rain'&&<label class="relax-field">{t.rainDensity}<input id="rainDensity" type="range" min="1" max="10" step="1" value="5" aria-describedby="rain-density-hint"/><output id="rainDensity-value">5 / 10</output><small id="rain-density-hint">{t.rainDensityHint}</small></label>}{key==='wind'&&<label class="relax-check"><span>{t.windAnimation}</span><span class="storage-switch"><input id="windAnimation" type="checkbox" role="switch"/><span class="storage-switch-track" aria-hidden="true"></span></span></label>}{key==='wind'&&<label class="relax-field">{t.windActivity}<input id="windActivity" type="range" min="1" max="10" step="1" value="5" aria-describedby="wind-activity-hint"/><output id="windActivity-value">5 / 10</output><small id="wind-activity-hint">{t.windActivityHint}</small></label>}</div>)}
   <fieldset class="noise-picker"><legend>{t.noiseType}</legend>{(['pink','brown','white'] as const).map((key,i)=><label><input type="radio" name="noiseType" value={key} checked={i===0}/><span>{t.noiseNames[i]}</span></label>)}</fieldset><p class="form-hint">{t.noiseHint}</p>
   </fieldset>
   {(['motion','awake','background'] as const).map(key=><label class="relax-check"><span>{t[key]}</span><span class="storage-switch"><input id={key} type="checkbox" role="switch" checked={key!=='awake'}/><span class="storage-switch-track" aria-hidden="true"></span></span></label>)}
   <p class="form-hint">{t.backgroundHint}</p>
  </form></section>
 </div>
 <p class="local-note">{t.local}</p>
 <section class="guide"><div class="guide-heading"><h2>{t.guide}</h2></div><div class="guide-grid">{t.steps.map((step,i)=><article><span class="step-number">0{i+1}</span><h3>{step}</h3><p>{t.tips[i]}</p></article>)}</div></section>
 <dialog id="first-start-dialog" aria-labelledby="first-safety-title"><div class="dialog-inner"><h2 id="first-safety-title">{t.safetyTitle}</h2><p>{t.firstHint}</p><p class="notice">{t.safePlace}</p><div class="dialog-actions"><button id="safety-continue" class="primary" autofocus>{t.continueLabel}</button><form method="dialog"><button class="secondary">{t.closeLabel}</button></form></div></div></dialog>
 <dialog id="safety-dialog" aria-labelledby="safety-title"><div class="dialog-inner"><h2 id="safety-title">{t.safetyLink}</h2><p>{t.firstHint}</p><p>{t.safePlace}</p><ul>{t.safetyDetails.map(text=><li>{text}</li>)}</ul><p><a href="https://www.who.int/news-room/questions-and-answers/item/deafness-and-hearing-loss-safe-listening" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">WHO · Safe listening ↗</a></p><form method="dialog" class="dialog-actions"><button class="primary" autofocus>{t.closeLabel}</button></form></div></dialog>
 <script src="../scripts/relax.ts"></script>
</Layout>
