---
import {waveDirections,type Layer} from '../lib/relax';
import {dictionaries} from '../lib/relax-i18n';
import type {Language} from '../lib/i18n';
interface Props {lang:Language; layers:Layer[]}
const {lang,layers}=Astro.props,t=dictionaries[lang];
---
   {layers.map(key=><fieldset class="settings-tile layer-settings"><legend>{t[key]}</legend><label class="relax-check"><span>{t[key]}</span><span class="storage-switch"><input id={key} type="checkbox" role="switch"/><span class="storage-switch-track" aria-hidden="true"></span></span></label><label class="relax-field">{t[key]} · {t.volume}<input id={key+'Volume'} type="range" min="0" max="100" value={key==='rain'?25:20}/><output id={key+'Volume-value'}>{key==='rain'?25:20} %</output></label>{key==='rain'&&<label class="relax-check"><span>{t.rainAnimation}</span><span class="storage-switch"><input id="rainAnimation" type="checkbox" role="switch"/><span class="storage-switch-track" aria-hidden="true"></span></span></label>}{key==='rain'&&<label class="relax-field">{t.rainDensity}<input id="rainDensity" type="range" min="1" max="10" step="1" value="5" aria-describedby="rain-density-hint"/><output id="rainDensity-value">5 / 10</output><small id="rain-density-hint">{t.rainDensityHint}</small></label>}{key==='wind'&&<label class="relax-check"><span>{t.windAnimation}</span><span class="storage-switch"><input id="windAnimation" type="checkbox" role="switch"/><span class="storage-switch-track" aria-hidden="true"></span></span></label>}{key==='wind'&&<label class="relax-field">{t.windActivity}<input id="windActivity" type="range" min="1" max="10" step="1" value="5" aria-describedby="wind-activity-hint"/><output id="windActivity-value">5 / 10</output><small id="wind-activity-hint">{t.windActivityHint}</small></label>}{(key==='fire'||key==='stream')&&<>
<label class="relax-check"><span>{t[key==='fire'?'fireAnimation':'streamAnimation']}</span><span class="storage-switch"><input id={key+'Animation'} type="checkbox" role="switch"/><span class="storage-switch-track" aria-hidden="true"></span></span></label>
<label class="relax-field">{t[key==='fire'?'fireDensity':'streamFlow']}<input id={key==='fire'?'fireDensity':'streamFlow'} type="range" min="1" max="10" step="1" value="5"/><output id={key==='fire'?'fireDensity-value':'streamFlow-value'}>5 / 10</output><small>{t[key==='fire'?'fireDensityHint':'streamFlowHint']}</small></label>
{key==='stream'&&<div class="relax-field"><span id="wave-direction-label">{t.waveDirection}</span><details id="wave-direction-dropdown" class="sound-dropdown"><summary aria-labelledby="wave-direction-label wave-direction-value"><span id="wave-direction-value">{t.waveDirectionNames[0]}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><fieldset class="instrument-options" aria-labelledby="wave-direction-label">{waveDirections.map((direction,i)=><label><input type="radio" name="waveDirection" value={direction} checked={i===0}/><span class="instrument-option-copy"><strong>{t.waveDirectionNames[i]}</strong></span><svg class="instrument-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></label>)}</fieldset></details></div>}
</>}{key==='noise'&&<>   <fieldset class="noise-picker"><legend>{t.noiseType}</legend>{(['pink','brown','white'] as const).map((key,i)=><label><input type="radio" name="noiseType" value={key} checked={i===0}/><span>{t.noiseNames[i]}</span></label>)}</fieldset><p class="form-hint">{t.noiseHint}</p></>}</fieldset>)}
