---
import {animateScene,animatedScenes} from '../lib/animated-backgrounds';
const assets=import.meta.glob('../../public/backgrounds/*.svg',{query:'?raw',import:'default',eager:true}) as Record<string,string>;
---
{animatedScenes.map(scene=><Fragment set:html={animateScene(assets[`../../public/backgrounds/${scene}.svg`]!,scene)}/>)}
