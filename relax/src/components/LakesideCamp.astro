---
import artwork from '../../public/backgrounds/lakeside-camp.svg?raw';
// Derive both fire states from the original illustration, avoiding duplicate artwork.
let svg=artwork;
const start=svg.indexOf('<path d="M760 872');
const flames=svg.slice(start,svg.lastIndexOf('</svg>'));
const smoke=`<g class="camp-smoke" fill="#c5c9be" filter="url(#camp-smoke-soft)">${Array.from({length:5},(_,i)=>`<g class="camp-smoke-wisp" style="--smoke-delay:${-i*2.4}s"><ellipse cx="${807+(i%2?8:-8)}" cy="772" rx="19" ry="30"/><ellipse cx="${813+(i%2?-6:6)}" cy="750" rx="14" ry="23"/></g>`).join('')}</g>`;
svg=svg.slice(0,start)+`${smoke}<g class="camp-static-fire">${flames}</g><g class="camp-animated-fire">${flames}</g></svg>`;
svg=svg.replace('</defs>', '<filter id="camp-smoke-soft" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="8"/></filter></defs>');
svg=svg.replace('<svg ', '<svg id="lakeside-camp-scene" aria-hidden="true" focusable="false" data-fire-animated="false" data-fire-paused="true" ')
 .replaceAll('id="sky"','id="camp-sky"').replaceAll('url(#sky)','url(#camp-sky)')
 .replaceAll('id="sun-glow"','id="camp-sun-glow"').replaceAll('url(#sun-glow)','url(#camp-sun-glow)');
---
<Fragment set:html={svg}/>
