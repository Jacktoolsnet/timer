---
import {instrumentIds,instrumentNames,instrumentLabel,defaultInstruments,trackLabels} from '../lib/instruments';
import {songCopy} from '../lib/song';
import {styleIds,styleCopy} from '../lib/presets';
import BackgroundIcon from './BackgroundIcon.astro';
import ToolInformation from '../../../shared/ToolInformation.astro';
import {content} from '../lib/content';
import OrbitIcon from './OrbitIcon.astro';
import CenterIcon from './CenterIcon.astro';
import StyleIcon from './StyleIcon.astro';
import ActionIcon from './ActionIcon.astro';
import GrooveIcon from './GrooveIcon.astro';
import {grooveChoices,grooveCopy} from '../lib/groove';
import Layout from '../layouts/Layout.astro';
import {copy,pitchCopy,noteEffectCopy,animationCopy,dynamicsCopy,directionCopy,centerCopy,backgroundCopy,orbitCopy} from '../lib/sound-i18n';
import type {Language} from '../lib/i18n';
import '../styles/sound.css';
interface Props {lang:Language}
const {lang}=Astro.props,t=copy[lang],info=content[lang];
const hideControls={de:'Steuerelemente ausblenden',en:'Hide controls',es:'Ocultar controles',fr:'Masquer les commandes'};
const musicTitle={de:'Musikrichtung',en:'Music style',es:'Estilo musical',fr:'Style musical'};
const instrumentsTitle={de:'Instrumente',en:'Instruments',es:'Instrumentos',fr:'Instruments'};
---
<Layout lang={lang} title={info.title} description={info.description} route="">
<div slot="header-focus" class="header-focus-actions"><button id="hide-focus-controls" class="icon-action" aria-label={hideControls[lang]} title={hideControls[lang]}><ActionIcon name="hide"/></button><button id="focus" class="icon-action" aria-label={t.focus} title={t.focus} aria-pressed="false"><ActionIcon name="focus"/><ActionIcon name="exit"/></button></div>
<section class="intro"><p class="eyebrow">JACKTOOLS / SOUND · PROTOTYPE</p><h1>{t.title}</h1><p class="intro-copy">{t.description}</p></section>
<section class="sound-app" id="sound-app">
 <canvas id="sound-atmosphere" width="1100" height="760" aria-hidden="true"></canvas>
 
 <div class="sound-grid">
  <div class="orbit-wrap"><canvas id="orbit" width="700" height="700" aria-label={t.steps}></canvas></div>
  <div class="flow-side"><div class="draw-wrap"><canvas id="drawing" width="700" height="440" aria-label={t.hint}></canvas><span id="draw-hint">{t.hint}</span></div><div class="sound-transport"><button id="play" class="primary icon-action" aria-label={t.play} title={t.play} aria-pressed="false"><ActionIcon name="play"/><ActionIcon name="pause"/></button><label>{t.tempo}<input id="tempo" type="range" min="40" max="180" value="100"/><output id="tempo-value">100 BPM</output></label><label>{t.volume}<input id="volume" type="range" min="0" max=".7" step=".01" value=".3"/></label><div class="sound-adjustments"><label class="pitch-control" for="transpose"><span>{pitchCopy[lang].label}</span><input id="transpose" type="range" min="-12" max="12" step="1" value="0" aria-valuetext={'0 '+pitchCopy[lang].unit}/><output id="transpose-value" for="transpose">0 {pitchCopy[lang].unit}</output></label><label class="note-effect-control" for="note-effect"><span>{noteEffectCopy[lang]}</span><input id="note-effect" type="range" min="0" max="150" step="5" value="100" aria-valuetext="100 %"/><output id="note-effect-value" for="note-effect">100 %</output></label></div><button id="evolve" class="icon-action" aria-label={t.evolve} title={t.evolve} aria-pressed="false" aria-describedby="evolution-status"><ActionIcon name="evolve"/></button><button id="random" class="icon-action" aria-label={t.random} title={t.random}><ActionIcon name="random"/></button><button id="reset" class="icon-action" aria-label={t.reset} title={t.reset}><ActionIcon name="reset"/></button><button id="clear" class="icon-action" aria-label={t.clear} title={t.clear}><ActionIcon name="clear"/></button></div><div id="song-structure" hidden aria-label={songCopy[lang].title}><div class="song-readout"><span id="song-label"></span><span id="song-bar"></span></div><div id="song-parts"></div></div></div>
 </div>

 <p id="evolution-status" role="status"></p>
 <p id="wake-status" role="status"></p>
 <p id="audio-status" role="status"></p>
</section>
<section class="music-tile" aria-labelledby="music-title"><h2 id="music-title">{musicTitle[lang]}</h2><div class="style-controls"><div class="style-tiles" role="group" aria-label={styleCopy[lang].label}>{styleIds.map((id,i)=><button type="button" class="style-tile" data-style-preset={id} aria-pressed={id==='electronic'?"true":"false"} aria-describedby="style-status"><span class="style-icon"><StyleIcon name={id}/></span><span>{styleCopy[lang].names[i]}</span><span class="style-check" aria-hidden="true">✓</span></button>)}</div><p>{styleCopy[lang].hint}</p></div><p id="style-status" role="status"></p><div class="groove-controls"><h3>{grooveCopy[lang].title}</h3><div class="groove-tiles" role="group" aria-label={grooveCopy[lang].title}>{grooveChoices.map(choice=><button type="button" class="groove-tile" data-groove={choice} aria-pressed={choice==='auto'?'true':'false'}><GrooveIcon name={choice}/><span>{grooveCopy[lang][choice]}</span></button>)}</div><p id="groove-status" role="status"><span id="meter-value">4/4</span><span id="groove-pending"></span></p></div></section>
<section class="instruments-tile" aria-labelledby="instruments-title"><h2 id="instruments-title">{instrumentsTitle[lang]}</h2>
 <div class="instrument-list">{defaultInstruments.map((id,i)=>{const name=instrumentNames[lang][instrumentIds.indexOf(id)];return <details class="instrument" data-track={i} data-enabled="true"><summary><span class={'dot dot-'+i}></span><span class="instrument-name">{name}</span><span class="count"></span></summary><div class="track-settings"><label>{trackLabels[lang].enable}<span class="sound-switch"><input class="track-enabled" type="checkbox" role="switch" checked/><span class="sound-switch-track" aria-hidden="true"></span></span></label><label>{instrumentLabel[lang]}<select class="instrument-select" name={`instrument-${i}`}>{instrumentIds.map((id,n)=><option value={id} selected={id===defaultInstruments[i]}>{instrumentNames[lang][n]}</option>)}</select></label><label>{directionCopy[lang].label}<select class="track-direction" name={`direction-${i}`}>{(['forward','reverse','random'] as const).map(mode=><option value={mode}>{directionCopy[lang][mode]}</option>)}</select></label><label>{t.mute}<span class="sound-switch"><input type="checkbox" class="mute" role="switch"/><span class="sound-switch-track" aria-hidden="true"></span></span></label><label class="track-volume-label"><span>{t.volume}</span><output class="track-volume-value">65 %</output><input class="track-volume" type="range" min="0" max="1" step=".05" value=".65"/></label><label title={dynamicsCopy[lang].hint}>{dynamicsCopy[lang].random}<span class="sound-switch"><input class="random-dynamics" type="checkbox" role="switch"/><span class="sound-switch-track" aria-hidden="true"></span></span></label><div class="steps" role="group" aria-label={name}>{Array.from({length:16},(_,s)=><button data-step={s} aria-label={name+' · '+(s+1)} aria-pressed="false">{s+1}</button>)}</div></div></details>})}</div>
</section>
<section class="animations-tile" aria-labelledby="animations-title"><h2 id="animations-title">{orbitCopy[lang].title}</h2><div class="animation-categories"><article class="animation-category"><h3 class="center-picker-label">{animationCopy[lang].orbit}</h3><div class="center-tiles orbit-tiles" role="group" aria-label={animationCopy[lang].orbit}>{(['comet','dot','pulse','random','off'] as const).map(mode=><button type="button" class="center-tile" data-orbit-mode={mode} aria-pressed={mode==='comet'?"true":"false"}><OrbitIcon name={mode}/><span>{orbitCopy[lang][mode]}</span></button>)}</div></article><article class="animation-category"><h3 class="center-picker-label">{animationCopy[lang].background}</h3><div class="center-tiles" role="group" aria-label={animationCopy[lang].background}>{(['clouds','aurora','stars','waves','random','off'] as const).map(mode=><button type="button" class="center-tile" data-background-mode={mode} aria-pressed={mode==='clouds'?"true":"false"}><BackgroundIcon name={mode}/><span>{backgroundCopy[lang][mode]}</span></button>)}</div></article><article class="animation-category"><h3 class="center-picker-label">{animationCopy[lang].center}</h3><div class="center-tiles" role="group" aria-label={animationCopy[lang].center}>{(['ring','filled','sun','sine','bars','random','off'] as const).map(mode=><button type="button" class="center-tile" data-center-mode={mode} aria-pressed={mode==='ring'?"true":"false"}><CenterIcon name={mode}/><span>{centerCopy[lang][mode]}</span></button>)}</div></article></div></section>
<ToolInformation tool="sound" lang={lang}/><section class="faq sound-faq" aria-labelledby="sound-faq-title"><h2 id="sound-faq-title">{info.faqTitle}</h2>{info.faq.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}<p class="usage-link"><a href={`/${lang}/usage/`}>{info.guide} →</a></p></section>
<script src="../scripts/sound.ts"></script>
</Layout>
