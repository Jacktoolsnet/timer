---
import AdBanner from '../../../shared/AdBanner.astro';
import SongLibrary from './SongLibrary.astro';
import {libraryStyles,libraryCopy} from '../lib/song-library';
import {scriptCopy} from '../lib/song-script';
import {videoPadCopy,videoPadModes} from '../lib/video-pad';
import AnimationSettings from './AnimationSettings.astro';
import {animationSettingsCopy} from '../lib/animation-settings';
import NoteEditor from './NoteEditor.astro';
import {noteEditorCopy} from '../lib/note-score';
import {videoAnimationKeys,videoAnimationCopy} from '../lib/video-animations';
import {videoCreditsCopy} from '../lib/video-credits';
import {videoInfoCopy,defaultVideoInfo} from '../lib/video-info';
import {recordingCopy} from '../lib/recording-copy';
import InstrumentIcon from './InstrumentIcon.astro';
import {instrumentGroups,pickerCopy,type InstrumentGroup} from '../lib/instrument-picker';
import {fileCopy} from '../lib/file-copy';
import {padNumbers} from '../lib/orbit-layout';
import {trackRateCopy,trackRates} from '../lib/track-rate';
import {gridCopy,gridSizes} from '../lib/track-grid';
import {rhythmCopy} from '../lib/tap-rhythm';
import {gestureCopy} from '../lib/pad-gestures';
import {dances,danceIds,danceCopy} from '../lib/dances';
import DanceIcon from './DanceIcon.astro';
import {instrumentIds,instrumentNames,instrumentLabel,defaultInstruments,trackLabels} from '../lib/instruments';
import {songCopy} from '../lib/song';
import {styleIds,styleCopy} from '../lib/presets';
import ToolInformation from '../../../shared/ToolInformation.astro';
import {content} from '../lib/content';
import StyleIcon from './StyleIcon.astro';
import ActionIcon from './ActionIcon.astro';
import OrbitSets from './OrbitSets.astro';
import {orbitSetCopy} from '../lib/orbit-project';
import GrooveIcon from './GrooveIcon.astro';
import {grooveChoices,grooveCopy} from '../lib/groove';
import Layout from '../layouts/Layout.astro';
import {copy,pitchCopy,noteEffectCopy,dynamicsCopy,directionCopy} from '../lib/sound-i18n';
import {languages,languageNames,type Language} from '../lib/i18n';
import '../styles/sound.css';
interface Props {lang:Language}
const {lang}=Astro.props,t=copy[lang],info=content[lang],files=fileCopy[lang];
const hideControls={de:'Steuerelemente ausblenden',en:'Hide controls',es:'Ocultar controles',fr:'Masquer les commandes'};
const picker=pickerCopy[lang],groups=Object.keys(instrumentGroups) as InstrumentGroup[];
const controlsTitle={de:'Tempo & Klang',en:'Tempo & sound',es:'Tempo y sonido',fr:'Tempo et son'};
const musicTitle={de:'Musikrichtung',en:'Music style',es:'Estilo musical',fr:'Style musical'};
const instrumentsTitle={de:'Instrumente',en:'Instruments',es:'Instrumentos',fr:'Instruments'};
---
<Layout lang={lang} title={info.title} description={info.description} route="">
<div slot="header-focus" class="header-focus-actions"><button id="files-open" type="button" aria-label={files.title} title={files.title} aria-haspopup="dialog"><ActionIcon name="files"/></button><button id="hide-focus-controls" class="icon-action" aria-label={hideControls[lang]} title={hideControls[lang]}><ActionIcon name="hide"/></button><button id="focus" class="icon-action" aria-label={t.focus} title={t.focus} aria-pressed="false"><ActionIcon name="focus"/><ActionIcon name="exit"/></button></div>
<SongLibrary lang={lang}/><dialog id="files-dialog" aria-labelledby="files-title">
 <div class="files-heading"><h2 id="files-title">{files.title}</h2><button id="files-close" class="icon-action" aria-label={files.close} title={files.close}><ActionIcon name="cancel"/></button></div>
 <section class="file-project file-card" aria-labelledby="json-project-title">
  <div class="file-card-heading"><span class="file-type-badge">JSON</span><h3 id="json-project-title">{files.json}</h3></div>
  <p>{recordingCopy[lang].projectHint}</p>
  <div class="file-actions"><button id="json-export" class="icon-action" aria-label={files.export} title={files.export}><ActionIcon name="download"/></button><button id="json-import" class="icon-action" aria-label={files.import} title={files.import}><ActionIcon name="upload"/></button></div>
  <details class="file-details"><summary>{recordingCopy[lang].details}</summary><p>{files.jsonHint}</p></details>
  <input id="json-file" type="file" accept=".json,application/json" hidden/><p id="file-status" role="status"></p>
 </section>
 <section class="file-script script-project" aria-labelledby="script-title">
  <div class="file-card-heading"><span class="file-type-badge">SONG</span><h3 id="script-title">{scriptCopy[lang].title}</h3></div>
  <p>{scriptCopy[lang].hint}</p>
  <label class="script-label" for="song-script-text">{scriptCopy[lang].text}</label><textarea id="song-script-text" rows="6" spellcheck="false" maxlength="1048576"></textarea>
  <div class="file-actions">{(['load','file','example','export','leave'] as const).map(action=><button id={`song-script-${action}`} type="button" class="icon-action" aria-label={scriptCopy[lang][action]} title={scriptCopy[lang][action]} disabled={action==='export'||action==='leave'}><ActionIcon name={action==='load'?'done':action==='file'?'upload':action==='example'?'play':action==='export'?'download':'cancel'}/></button>)}</div>
  <input id="song-script-upload" type="file" accept=".json,application/json" hidden/>
  <a class="script-guide" href="/song-script-guide.md" download>{scriptCopy[lang].guide}</a>
  <p>{scriptCopy[lang].editing}</p><p id="song-script-status" role="status">{scriptCopy[lang].inactive}</p>
 </section>
 <section class="file-recording" aria-labelledby="recording-heading">
  <div class="file-card-heading"><span class="file-heading-icon"><ActionIcon name="record"/></span><h3 id="recording-heading">{recordingCopy[lang].recording}</h3></div>
  <p class="recording-shared-hint">{recordingCopy[lang].shared}</p>
  <fieldset id="recording-options"><legend>{recordingCopy[lang].setup}</legend>{(['restart','random','fullscreen'] as const).map(option=><label>{recordingCopy[lang][option]}<span class="sound-switch"><input id={`recording-${option}`} type="checkbox" role="switch" disabled={option==='random'}/><span class="sound-switch-track" aria-hidden="true"></span></span></label>)}<label class="recording-duration-label" for="recording-duration"><span id="recording-duration-label">{recordingCopy[lang].duration}</span><output id="recording-duration-value" for="recording-duration">10 {recordingCopy[lang].minutes}</output><input id="recording-duration" aria-labelledby="recording-duration-label" aria-valuetext={`10 ${recordingCopy[lang].minutes}`} type="range" min="1" max="10" step="1" value="10"/></label><p class="recording-start-hint">{recordingCopy[lang].hint}</p></fieldset>
  <h4 class="recording-format-heading">{recordingCopy[lang].formats}</h4>
  <div class="recording-formats">
   <article class="recording-format" aria-labelledby="wav-format-title"><div class="file-card-heading"><span class="file-type-badge">WAV</span><h4 id="wav-format-title">{files.wavTitle}</h4></div><p>{recordingCopy[lang].audio}</p><button id="wav-record" class="icon-action recording-launch" aria-label={files.wavRecord} title={files.wavRecord} aria-pressed="false"><ActionIcon name="audio"/></button><details class="file-details"><summary>{recordingCopy[lang].details}</summary><p>{files.wavHint}</p></details><p id="wav-support" role="status"></p></article>
   <article class="recording-format" aria-labelledby="mp4-format-title"><div class="file-card-heading"><span class="file-type-badge">MP4</span><h4 id="mp4-format-title">{files.video}</h4></div><p>{recordingCopy[lang].video}</p><fieldset id="video-format"><legend>{recordingCopy[lang].aspect}</legend>{(['landscape','portrait'] as const).map(format=><label class="video-format-tile"><input type="radio" name="video-format" value={format} checked={format==='landscape'}/><span class={`video-format-icon ${format}`} aria-hidden="true"></span><span>{recordingCopy[lang][format]}</span><b>{format==='landscape'?'16:9':'9:16'}</b></label>)}</fieldset><output id="video-resolution" aria-live="polite">1280 × 720</output><fieldset id="video-pad"><legend>{videoPadCopy[lang].label}</legend><div class="video-pad-options">{videoPadModes.map(mode=><label class="video-pad-tile"><input type="radio" name="video-pad" value={mode} checked={mode==='none'}/><ActionIcon name={mode==='none'?'video':mode==='tap'?'rhythm':'audio'}/><span>{videoPadCopy[lang][mode]}</span></label>)}</div><p>{videoPadCopy[lang].hint}</p></fieldset><details class="video-animation-options"><summary>{videoAnimationCopy[lang].title}</summary><p>{videoAnimationCopy[lang].hint}</p>{videoAnimationKeys.map(key=><label class="video-info-switch">{videoAnimationCopy[lang][key]}<span class="sound-switch"><input id={`video-animation-${key}`} type="checkbox" role="switch"/><span class="sound-switch-track" aria-hidden="true"></span></span></label>)}</details><div class="video-info"><label class="video-info-switch">{videoInfoCopy[lang].label}<span class="sound-switch"><input id="video-info-enabled" type="checkbox" role="switch"/><span class="sound-switch-track" aria-hidden="true"></span></span></label><div id="video-info-options" hidden><fieldset id="video-caption-language"><legend>{videoInfoCopy[lang].language}</legend>{languages.map(language=><label class="video-language-tile"><input type="radio" name="video-caption-language" value={language} checked={language==='en'}/><span>{languageNames[language]}</span></label>)}</fieldset><label class="video-title-label" for="video-info-title">{videoInfoCopy[lang].title}<input id="video-info-title" type="text" maxlength="80" placeholder={videoInfoCopy[lang].placeholder} autocomplete="off"/></label>{(['showTitle','style','tempo','section','signature'] as const).map(key=><label class="video-info-switch">{videoInfoCopy[lang][key]}<span class="sound-switch"><input id={`video-info-${key}`} type="checkbox" role="switch" checked={defaultVideoInfo[key]}/><span class="sound-switch-track" aria-hidden="true"></span></span></label>)}</div></div><fieldset id="video-length-mode"><legend>{videoCreditsCopy[lang].mode}</legend><label><input type="radio" name="video-length-mode" value="fixed" checked/>{videoCreditsCopy[lang].fixed}</label><label><input type="radio" name="video-length-mode" value="song" disabled/>{videoCreditsCopy[lang].song}</label><p>{videoCreditsCopy[lang].songHint}</p><output id="video-song-duration" aria-live="polite"></output></fieldset><div class="video-credits"><div id="video-song-rights" hidden><p id="video-song-rights-hint"></p><pre id="video-song-rights-text"></pre></div><label class="video-info-switch">{videoCreditsCopy[lang].enabled}<span class="sound-switch"><input id="video-credits-enabled" type="checkbox" role="switch"/><span class="sound-switch-track" aria-hidden="true"></span></span></label><div id="video-credits-options" hidden><label for="video-credits-text">{videoCreditsCopy[lang].text}</label><textarea id="video-credits-text" maxlength="600" rows="5" placeholder={videoCreditsCopy[lang].fallback}></textarea><p>{videoCreditsCopy[lang].hint}</p></div></div><button id="video-record" class="icon-action recording-launch" aria-label={files.record} title={files.record} aria-pressed="false"><ActionIcon name="video"/></button><details class="file-details"><summary>{recordingCopy[lang].details}</summary><p>{files.videoHint}</p></details><p id="video-support" role="status"></p></article>
  </div>
 </section>
</dialog>
<dialog id="instrument-dialog" aria-labelledby="instrument-picker-title">
 <div class="files-heading"><h2 id="instrument-picker-title">{picker.choose}</h2><button id="instrument-picker-close" type="button" aria-label={picker.close} title={picker.close}><ActionIcon name="cancel"/></button></div>
 <p id="instrument-picker-track"></p><label class="picker-rate-label">{trackRateCopy[lang].label}<select id="picker-track-rate" name="picker-rate"><option value="auto">{trackRateCopy[lang].auto}</option>{trackRates.map(rate=><option value={rate}>{rate===.5?'½×':rate+'×'}</option>)}</select></label><p id="picker-rate-status" role="status"></p>
 <div class="instrument-group-tabs" role="tablist" aria-label={picker.groups}>{groups.map((group,i)=><button type="button" role="tab" id={`instrument-tab-${group}`} data-instrument-group={group} aria-controls={`instrument-panel-${group}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{picker[group]}</button>)}</div>
 {groups.map((group,i)=><div id={`instrument-panel-${group}`} role="tabpanel" aria-labelledby={`instrument-tab-${group}`} class="instrument-picker-grid" hidden={i!==0}>{instrumentGroups[group].map(id=><button type="button" data-pick-instrument={id} aria-pressed="false"><InstrumentIcon name={id}/><span>{instrumentNames[lang][instrumentIds.indexOf(id)]}</span></button>)}</div>)}
</dialog>
<div id="recording-sessions"><aside id="video-session" hidden aria-label={files.video}><span id="video-status" role="status"></span><output id="video-time" aria-live="off" aria-label={files.recording}>00:00</output><button id="video-stop" class="icon-action" aria-label={files.stop} title={files.stop}><ActionIcon name="stop"/></button><a id="video-download" hidden>{files.download}</a><button id="video-dismiss" class="icon-action" aria-label={files.close} title={files.close} hidden><ActionIcon name="cancel"/></button></aside>
<aside id="wav-session" hidden aria-label={files.wavTitle}><span id="wav-status" role="status"></span><output id="wav-time" aria-live="off" aria-label={files.wavRecording}>00:00</output><button id="wav-stop" class="icon-action" aria-label={files.stop} title={files.stop}><ActionIcon name="stop"/></button><a id="wav-download" hidden>{files.wavDownload}</a><button id="wav-dismiss" class="icon-action" aria-label={files.close} title={files.close} hidden><ActionIcon name="cancel"/></button></aside>
</div>
<section class="intro"><p class="eyebrow">JACKTOOLS / SOUND · PROTOTYPE</p><h1>{t.title}</h1><p class="intro-copy">{t.description}</p></section>
<section class="sound-app" id="sound-app">
 <canvas id="sound-atmosphere" width="1100" height="760" aria-hidden="true"></canvas>
 
 <div class="sound-grid">
  <div class="orbit-wrap"><canvas id="orbit" width="700" height="700" aria-label={t.steps}></canvas></div>
  <div class="flow-side"><div class="pad-mode-controls" role="group" aria-label={rhythmCopy[lang].group}><button type="button" id="orbit-sets-open" aria-pressed="false" aria-controls="orbit-sets-panel" aria-label={orbitSetCopy[lang].title} title={orbitSetCopy[lang].title}><ActionIcon name="orbits"/></button><button type="button" data-pad-mode="draw" aria-label={rhythmCopy[lang].draw} title={rhythmCopy[lang].draw} aria-pressed="true"><ActionIcon name="draw"/></button><button type="button" data-pad-mode="rhythm" aria-label={rhythmCopy[lang].rhythm} title={rhythmCopy[lang].rhythm} aria-pressed="false"><ActionIcon name="rhythm"/></button><button type="button" data-pad-mode="notes" aria-label={noteEditorCopy[lang].mode} title={noteEditorCopy[lang].mode} aria-pressed="false"><ActionIcon name="audio"/></button><button type="button" id="music-settings-open" aria-label={animationSettingsCopy[lang].music} title={animationSettingsCopy[lang].music} aria-controls="animation-settings" aria-pressed="false"><StyleIcon name="classical"/></button><button type="button" id="animation-settings-open" aria-label={animationSettingsCopy[lang].title} title={animationSettingsCopy[lang].title} aria-controls="animation-settings" aria-pressed="false"><ActionIcon name="settings"/></button></div><AnimationSettings lang={lang}>
<section slot="controls" class="controls-tile" aria-labelledby="controls-title"><h2 id="controls-title">{controlsTitle[lang]}</h2><div class="slider-controls"><label class="transport-range" for="tempo"><span>{t.tempo}</span><input id="tempo" type="range" min="40" max="220" value="100"/><output id="tempo-value" for="tempo">100 BPM</output></label><label class="transport-range" for="volume"><span>{t.volume}</span><input id="volume" type="range" min="0" max=".7" step=".01" value=".3" aria-valuetext="43 %"/><output id="volume-value" for="volume">43 %</output></label><div class="sound-adjustments"><label class="pitch-control" for="transpose"><span>{pitchCopy[lang].label}</span><input id="transpose" type="range" min="-12" max="12" step="1" value="0" aria-valuetext={'0 '+pitchCopy[lang].unit}/><output id="transpose-value" for="transpose">0 {pitchCopy[lang].unit}</output></label><label class="note-effect-control" for="note-effect"><span>{noteEffectCopy[lang]}</span><input id="note-effect" type="range" min="0" max="150" step="5" value="100" aria-valuetext="100 %"/><output id="note-effect-value" for="note-effect">100 %</output></label></div></div></section>
<section slot="music" class="music-tile" aria-label={musicTitle[lang]}><div class="style-controls"><div class="style-tiles" role="group" aria-label={styleCopy[lang].label}>{styleIds.map((id,i)=><div class="style-choice"><button type="button" class="style-tile" data-style-preset={id} aria-pressed={id==='electronic'?"true":"false"} aria-describedby="style-status"><span class="style-icon"><StyleIcon name={id}/></span><span>{styleCopy[lang].names[i]}</span><span class="style-check" aria-hidden="true">✓</span></button>{libraryStyles.includes(id)&&<button type="button" class="style-library-open" data-library-open={id} aria-haspopup="dialog" aria-label={libraryCopy[lang].open+' · '+styleCopy[lang].names[i]} title={libraryCopy[lang].open}><ActionIcon name="files"/></button>}</div>)}</div><p>{styleCopy[lang].hint}</p></div><p id="style-status" role="status"></p><div class="groove-controls" hidden><h3>{grooveCopy[lang].title}</h3><div class="groove-tiles" role="group" aria-label={grooveCopy[lang].title}>{grooveChoices.map(choice=><button type="button" class="groove-tile" data-groove={choice} aria-pressed={choice==='auto'?'true':'false'}><GrooveIcon name={choice}/><span>{grooveCopy[lang][choice]}</span></button>)}</div><p id="groove-status" role="status"><span id="meter-value">4/4</span><span id="groove-pending"></span></p></div></section>
</AnimationSettings><OrbitSets lang={lang}/><NoteEditor lang={lang}/><div class="draw-wrap"><div id="rhythm-zones" hidden aria-hidden="true">{defaultInstruments.map((id,i)=><span data-lane={i}><b>{padNumbers[i]}</b><span class="pad-instrument">{instrumentNames[lang][instrumentIds.indexOf(id)]}</span><span class="note-bands">{Array.from({length:8},(_,n)=><span data-note={7-n}><b>{8-n}</b></span>)}</span></span>)}</div><canvas id="drawing" width="700" height="700" tabindex="0" aria-label={gestureCopy[lang].hint} aria-describedby="gesture-keyboard"></canvas></div><div id="rhythm-controls" hidden><div class="rhythm-actions"><span id="pad-instrument-actions" hidden><button type="button" id="pad-mute" aria-label={picker.mute} title={picker.mute} aria-pressed="false"><ActionIcon name="mute"/><ActionIcon name="unmute"/></button><button type="button" id="pad-instrument" aria-label={picker.choose} title={picker.choose} aria-haspopup="dialog"><ActionIcon name="audio"/></button></span><button type="button" id="rhythm-done" aria-label={rhythmCopy[lang].done} title={rhythmCopy[lang].done} disabled><ActionIcon name="done"/></button><button type="button" id="rhythm-cancel" aria-label={rhythmCopy[lang].cancel} title={rhythmCopy[lang].cancel} disabled><ActionIcon name="cancel"/></button><button type="button" id="rhythm-record" aria-label={rhythmCopy[lang].record} title={rhythmCopy[lang].record}><ActionIcon name="record"/></button><button type="button" id="rhythm-clear" aria-label={rhythmCopy[lang].clear} title={rhythmCopy[lang].clear}><ActionIcon name="clear"/></button></div><p id="rhythm-status" class="gesture-keyboard" role="status"></p><progress id="rhythm-progress" hidden value="0" max="32" aria-label={rhythmCopy[lang].progress}></progress></div><span id="gesture-keyboard" class="gesture-keyboard">{gestureCopy[lang].help+' '+gestureCopy[lang].keyboard}</span><div class="sound-transport"><button id="play" class="primary icon-action" aria-label={t.play} title={t.play} aria-pressed="false"><ActionIcon name="play"/><ActionIcon name="pause"/></button><button id="evolve" class="icon-action" aria-label={t.evolve} title={t.evolve} aria-pressed="false" aria-describedby="evolution-status"><ActionIcon name="evolve"/></button><button id="random" class="icon-action" aria-label={t.random} title={t.random}><ActionIcon name="random"/></button><button id="reset" class="icon-action" aria-label={t.reset} title={t.reset}><ActionIcon name="reset"/></button><button id="clear" class="icon-action" aria-label={t.clear} title={t.clear}><ActionIcon name="clear"/></button></div><div id="song-structure" hidden aria-label={songCopy[lang].title}><div class="song-readout"><span id="song-label"></span><span id="song-bar"></span></div><div id="song-parts"></div></div></div>
 </div>

 <p id="evolution-status" role="status"></p>
 <p id="wake-status" role="status"></p>
 <p id="audio-status" role="status"></p>
</section>

<section class="dances-tile" hidden aria-labelledby="dances-title"><div class="dance-heading"><h2 id="dances-title">{danceCopy[lang].title}</h2><button type="button" class="dance-free" data-dance="" aria-pressed="true">{danceCopy[lang].off}</button></div><p class="dance-hint">{danceCopy[lang].hint}</p>{(['standard','latin','social'] as const).map(group=><div class="dance-group"><h3>{danceCopy[lang][group]}</h3><div class="dance-tiles" role="group" aria-label={danceCopy[lang][group]}>{danceIds.filter(id=>dances[id].group===group).map(id=><button type="button" class="dance-tile" data-dance={id} aria-pressed="false" aria-describedby="dance-status"><DanceIcon name={id}/><span>{danceCopy[lang].names[danceIds.indexOf(id)]}</span><small>{dances[id].beats}/4 · {dances[id].preset.bpm} BPM</small></button>)}</div></div>)}<p id="dance-status" role="status"></p><p class="dance-note">{danceCopy[lang].note}</p></section>

<section class="instruments-tile" aria-labelledby="instruments-title"><h2 id="instruments-title">{instrumentsTitle[lang]}</h2>
 <div class="instrument-list">{defaultInstruments.map((id,i)=>{const name=instrumentNames[lang][instrumentIds.indexOf(id)];return <details class="instrument" data-track={i} data-enabled="true"><summary><span class={'dot dot-'+i}></span><span class="instrument-name">{name}</span><span class="count"></span></summary><div class="track-settings"><label>{trackLabels[lang].enable}<span class="sound-switch"><input class="track-enabled" type="checkbox" role="switch" checked/><span class="sound-switch-track" aria-hidden="true"></span></span></label><label>{instrumentLabel[lang]}<select class="instrument-select" name={`instrument-${i}`}>{instrumentIds.map((id,n)=><option value={id} selected={id===defaultInstruments[i]}>{instrumentNames[lang][n]}</option>)}</select></label><label>{gridCopy[lang].label}<select class="track-grid" name={`grid-${i}`}><option value="auto">{gridCopy[lang].auto}</option>{gridSizes.map(size=><option value={size}>{size}</option>)}</select></label><p class="grid-status" role="status"></p><label>{trackRateCopy[lang].label}<select class="track-rate" name={`rate-${i}`}><option value="auto">{trackRateCopy[lang].auto}</option>{trackRates.map(rate=><option value={rate}>{rate===.5?'½×':rate+'×'}</option>)}</select></label><p class="rate-status" role="status"></p><label>{directionCopy[lang].label}<select class="track-direction" name={`direction-${i}`}>{(['forward','reverse','random'] as const).map(mode=><option value={mode}>{directionCopy[lang][mode]}</option>)}</select></label><label>{t.mute}<span class="sound-switch"><input type="checkbox" class="mute" role="switch"/><span class="sound-switch-track" aria-hidden="true"></span></span></label><label class="track-volume-label"><span>{t.volume}</span><output class="track-volume-value">65 %</output><input class="track-volume" type="range" min="0" max="1" step=".05" value=".65"/></label><label title={dynamicsCopy[lang].hint}>{dynamicsCopy[lang].random}<span class="sound-switch"><input class="random-dynamics" type="checkbox" role="switch"/><span class="sound-switch-track" aria-hidden="true"></span></span></label><div class="steps" role="group" aria-label={name}>{Array.from({length:16},(_,s)=><button data-step={s} aria-label={name+' · '+(s+1)} aria-pressed="false">{s+1}</button>)}</div></div></details>})}</div>
</section>

<AdBanner lang={lang} />
<ToolInformation tool="sound" lang={lang}/><section class="faq sound-faq" aria-labelledby="sound-faq-title"><h2 id="sound-faq-title">{info.faqTitle}</h2>{info.faq.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}<p class="usage-link"><a href={`/${lang}/usage/`}>{info.guide} →</a></p></section>
<script src="../scripts/sound.ts"></script>
</Layout>
