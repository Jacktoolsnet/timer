---
import type {Language} from '../lib/i18n';
import {visualizationCopy} from '../lib/visualization';
import {animationSettingsCopy} from '../lib/animation-settings';
import ActionIcon from './ActionIcon.astro';
import OrbitIcon from './OrbitIcon.astro';
interface Props {lang:Language}
const {lang}=Astro.props,c=visualizationCopy[lang];
---
<div class="visualization-switch" role="group" aria-label={c.title}>
 <div class="visualization-option"><button type="button" data-visualization="orbit" aria-pressed="true"><OrbitIcon name="dot"/><span>{c.orbit}</span></button><button type="button" id="orbit-settings-open" class="settings-icon" aria-label={animationSettingsCopy[lang].orbit} title={animationSettingsCopy[lang].orbit}><ActionIcon name="settings"/></button></div>
 <div class="visualization-option"><button type="button" data-visualization="landscape" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 8c5-7 9 7 20 0M2 13c6-7 11 7 20 0M2 18c7-7 12 7 20 0"/></svg><span>{c.landscape}</span></button></div>
 <div class="visualization-option"><button type="button" data-visualization="stream" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M7 3v18M3 7h18M3 12h18M3 17h18M12 5h5v4h-5zm3 10h6v4h-6z"/></svg><span>{c.stream}</span></button></div>
 <div class="visualization-option"><button type="button" data-visualization="constellation" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m5 6 7 5 7-7M12 11l5 8"/><circle cx="5" cy="6" r="2"/><circle cx="12" cy="11" r="2"/><circle cx="19" cy="4" r="2"/><circle cx="17" cy="19" r="2"/></svg><span>{c.constellation}</span></button></div>
 <div class="visualization-option"><button type="button" data-visualization="flower" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M12 9C4-3 20-3 12 9Zm3 2c9-8 13 7 2 3Zm-1 5c6 10-10 10-4 0Zm-5-2C-2 18 2 3 11 11Z"/><circle cx="12" cy="12" r="3"/></svg><span>{c.flower}</span></button></div>
</div>
