---
import type {Language} from '../lib/i18n';
import {animationSettingsCopy} from '../lib/animation-settings';
import {animationCopy,orbitCopy,centerCopy,backgroundCopy} from '../lib/sound-i18n';
import {constellationVariantCopy,streamVariantCopy,landscapeVariantCopy,visualizationCopy} from '../lib/visualization';
import StyleIcon from './StyleIcon.astro';
import VisualizationPicker from './VisualizationPicker.astro';
import ActionIcon from './ActionIcon.astro';
import OrbitIcon from './OrbitIcon.astro';
import CenterIcon from './CenterIcon.astro';
import BackgroundIcon from './BackgroundIcon.astro';
interface Props {lang:Language}
const {lang}=Astro.props,c=animationSettingsCopy[lang];
---
<section id="animation-settings" hidden aria-labelledby="animation-settings-title">
 <div class="animation-settings-heading">
  <button type="button" id="animation-settings-back" class="animation-settings-icon" aria-label={c.back} title={c.back} hidden><ActionIcon name="back"/></button>
  <h2 id="animation-settings-title" tabindex="-1">{c.title}</h2>
  <button type="button" id="animation-settings-close" class="animation-settings-icon" aria-label={c.close} title={c.close}><ActionIcon name="cancel"/></button>
 </div>
 <div data-animation-panel="home" data-panel-title={c.title}>
  <div class="animation-settings-home">
   <button type="button" class="animation-home-tile" data-animation-open="controls"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 6h6m4 0h8M3 12h12m4 0h2M3 18h2m4 0h12"/><circle cx="11" cy="6" r="2"/><circle cx="17" cy="12" r="2"/><circle cx="7" cy="18" r="2"/></svg><span>{c.controls}</span></button>
   <button type="button" class="animation-home-tile" data-animation-open="music"><StyleIcon name="classical"/><span>{c.music}</span><small id="animation-current-music"></small></button>
   <button type="button" class="animation-home-tile" data-animation-open="sound"><ActionIcon name="audio"/><span>{c.sound}</span><small id="animation-current-sound">{visualizationCopy[lang].orbit}</small></button>
   <button type="button" class="animation-home-tile" data-animation-open="background"><BackgroundIcon name="clouds"/><span>{c.background}</span><small id="animation-current-background">{backgroundCopy[lang].clouds}</small></button>
  </div>
 </div>
 <div data-animation-panel="controls" data-panel-title={c.controls} hidden><div class="settings-content"><slot name="controls"/></div></div>
 <div data-animation-panel="music" data-panel-title={c.music} hidden><div class="settings-content"><slot name="music"/></div></div>
 <div data-animation-panel="sound" data-panel-title={c.sound} hidden><VisualizationPicker lang={lang}/></div>
 <div data-animation-panel="constellation" data-panel-title={c.constellation} hidden>
  <div class="center-tiles" role="group" aria-label={c.constellation}>
   <button type="button" class="center-tile" data-constellation-variant="stars" aria-pressed="true"><BackgroundIcon name="stars"/><span>{constellationVariantCopy[lang].stars}</span></button>
   <button type="button" class="center-tile" data-constellation-variant="nebula" aria-pressed="false"><BackgroundIcon name="clouds"/><span>{constellationVariantCopy[lang].nebula}</span></button>
  </div>
 </div>
 <div data-animation-panel="stream" data-panel-title={c.stream} hidden>
  <div class="center-tiles" role="group" aria-label={c.stream}>
   <button type="button" class="center-tile" data-stream-variant="notes" aria-pressed="true"><ActionIcon name="audio"/><span>{streamVariantCopy[lang].notes}</span></button>
   <button type="button" class="center-tile" data-stream-variant="clouds" aria-pressed="false"><BackgroundIcon name="stars"/><span>{streamVariantCopy[lang].clouds}</span></button>
  </div>
 </div>
 <div data-animation-panel="landscape" data-panel-title={c.landscape} hidden>
  <div class="center-tiles" role="group" aria-label={c.landscape}>
   <button type="button" class="center-tile" data-landscape-variant="rivers" aria-pressed="true"><BackgroundIcon name="waves"/><span>{landscapeVariantCopy[lang].rivers}</span></button>
   <button type="button" class="center-tile" data-landscape-variant="delta" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M12 2v5m0 0L5 15m7-8 7 8M12 7v8M3 19c3-3 5 3 8 0s5 3 10 0M2 23c3-3 6 3 9 0s6 3 11 0"/></svg><span>{landscapeVariantCopy[lang].delta}</span></button>
  </div>
 </div>
 <div data-animation-panel="orbit" data-panel-title={c.orbit} hidden>
  <div class="animation-settings-branches">
   <button type="button" class="animation-home-tile" data-animation-open="orbit-trail"><OrbitIcon name="comet"/><span>{animationCopy[lang].orbit}</span></button>
   <button type="button" class="animation-home-tile" data-animation-open="orbit-center"><CenterIcon name="ring"/><span>{animationCopy[lang].center}</span></button>
  </div>
 </div>
 <div data-animation-panel="orbit-trail" data-panel-title={animationCopy[lang].orbit} hidden>
  <div class="center-tiles" role="group" aria-label={animationCopy[lang].orbit}>{(['comet','dot','pulse','radar','random','off'] as const).map(mode=><button type="button" class="center-tile" data-orbit-mode={mode} aria-pressed={mode==='comet'?"true":"false"}><OrbitIcon name={mode}/><span>{orbitCopy[lang][mode]}</span></button>)}</div>
 </div>
 <div data-animation-panel="orbit-center" data-panel-title={animationCopy[lang].center} hidden>
  <div class="center-tiles" role="group" aria-label={animationCopy[lang].center}>{(['ring','filled','sun','sine','bars','random','off'] as const).map(mode=><button type="button" class="center-tile" data-center-mode={mode} aria-pressed={mode==='ring'?"true":"false"}><CenterIcon name={mode}/><span>{centerCopy[lang][mode]}</span></button>)}</div>
 </div>
 <div data-animation-panel="flower" data-panel-title={c.flower} hidden>
  <div class="center-tiles" role="group" aria-label={animationCopy[lang].center}>{(['ring','filled','sun','sine','bars','random','off'] as const).map(mode=><button type="button" class="center-tile" data-flower-center-mode={mode} aria-pressed={mode==='ring'?"true":"false"}><CenterIcon name={mode}/><span>{centerCopy[lang][mode]}</span></button>)}</div>
 </div>
 <div data-animation-panel="background" data-panel-title={c.background} hidden>
  <div class="center-tiles" role="group" aria-label={c.background}>{(['clouds','aurora','stars','waves','random','off'] as const).map(mode=><button type="button" class="center-tile" data-background-mode={mode} aria-pressed={mode==='clouds'?"true":"false"}><BackgroundIcon name={mode}/><span>{backgroundCopy[lang][mode]}</span></button>)}</div>
 </div>
</section>
