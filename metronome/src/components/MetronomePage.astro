---
import Layout from '../layouts/Layout.astro';
import {copy,settingsCopy,animationCopy} from '../lib/metronome-i18n';
import type {Language} from '../lib/i18n';
import '../styles/metronome.css';
interface Props {lang:Language}
const {lang}=Astro.props;
const t=copy[lang];
const groups=settingsCopy[lang];
const animations=animationCopy[lang];
---
<Layout lang={lang} title={t.title} description={t.intro} route="">
 <section class="intro"><p class="eyebrow">JACKTOOLS / {t.title}</p><h1>{t.heading}</h1><p class="intro-copy">{t.intro}</p></section>
 <section id="metronome-app" class="metronome-card" aria-label={t.title}>
  <div class="instrument-top"><button id="focus" aria-pressed="false">{t.focus} ⛶</button></div>
  <div class="instrument-stage" data-view="orbit" aria-hidden="true">
   <svg class="orbit-art" viewBox="0 0 360 360"><defs><radialGradient id="halo"><stop stop-color="currentColor" stop-opacity=".1"/><stop offset="1" stop-color="currentColor" stop-opacity="0"/></radialGradient></defs><circle cx="180" cy="180" r="176" fill="url(#halo)"/><circle class="outer-ring" cx="180" cy="180" r="145"/><circle class="inner-ring" cx="180" cy="180" r="120"/><g id="orbit-marks"></g><g id="orbit-arm"><circle class="orb-halo" cx="180" cy="35" r="16"/><circle class="orb" cx="180" cy="35" r="6"/></g></svg>
   <svg class="pendulum-art" viewBox="0 0 360 360"><path class="pendulum-case" d="M144 43h72l56 275H88Z"/><path class="pendulum-scale" d="M133 126h94m-101 34h108m-115 34h122m-129 34h136m-143 34h150"/><g id="pendulum-arm"><path d="M180 284V66"/><rect x="167" y="104" width="26" height="38" rx="8"/><circle cx="180" cy="284" r="9"/></g></svg>
   <div class="beat-strip" id="beat-strip"></div>
   <svg class="ball-art" viewBox="0 0 360 360"><path class="ball-floor" d="M18 250H342"/><g id="ball-stations"></g><ellipse id="ball-shadow" cx="30" cy="250" rx="14" ry="3"/><circle id="bouncing-ball" cx="30" cy="238" r="12"/></svg>
   <div class="beat-readout"><span class="beat-tile"><span class="beat-caption">{t.beat}</span><span id="current-beat">1</span></span><span id="bar-label"><span class="bar-caption">{t.bar}</span> <span id="current-bar">1</span></span></div>
  </div>
  <p id="play-status" role="status">{t.ready}</p>
  <div class="tempo-control"><button id="slower" aria-label={t.tempo+' −1'}>−</button><label><span class="sr-only">{t.tempo}</span><input id="bpm" type="number" min="20" max="300" step="1" value="90" inputmode="numeric"/><span>BPM</span></label><button id="faster" aria-label={t.tempo+' +1'}>+</button></div>
  <input class="tempo-slider" id="tempo-range" type="range" min="20" max="300" value="90" aria-label={t.tempo}/>
  <div class="transport"><button class="primary" id="start" aria-pressed="false">▶ {t.start}</button><button class="secondary" id="tap">{t.tap}<span id="tap-count"></span></button></div>
  <p class="instrument-hint">{t.tapHint}</p>
  <p class="keyboard-hint">{t.statusHint}</p><p id="audio-error" role="status"></p>
 </section>
 <aside class="settings-card metronome-settings-card" aria-labelledby="metronome-settings-title">
  <h2 id="metronome-settings-title">{groups.settings}</h2>
  <form id="metronome-settings">
   <fieldset class="metronome-settings-group"><legend>{groups.rhythm}</legend>
    <div class="beats-field"><label for="beats">{t.beats}</label><div class="number-stepper"><button type="button" id="beats-minus" aria-label={t.beats+' −1'}>−</button><input id="beats" name="beats" type="number" min="1" max="12" step="1" value="4" inputmode="numeric"/><button type="button" id="beats-plus" aria-label={t.beats+' +1'}>+</button></div></div>
    <label>{t.subdivision}<select id="subdivision" name="subdivision">{t.subOptions.map((label,i)=><option value={i+1}>{label}</option>)}</select></label>
    <p class="accents-label" id="accents-label">{t.accents}</p>
    <div id="beat-buttons" class="beat-buttons" role="group" aria-labelledby="accents-label"></div><p class="form-hint">{t.accentHint}</p>
   </fieldset>
   <fieldset class="metronome-settings-group"><legend>{t.sound}</legend>
    <label>{t.sound}<select id="sound" name="sound">{['wood','digital','soft','silent'].map((value,i)=><option value={value}>{t.sounds[i]}</option>)}</select></label>
    <label>{t.volume}<input id="volume" type="range" min="0" max="100" value="50"/></label>
   </fieldset>
   <fieldset class="metronome-settings-group"><legend>{groups.display}</legend>
    <p class="view-label">{groups.display}</p>
    <div class="view-picker" role="group" aria-label={groups.display}><button type="button" data-view="orbit" aria-pressed="true">{t.orbit}</button><button type="button" data-view="pendulum" aria-pressed="false">{t.pendulum}</button><button type="button" data-view="strip" aria-pressed="false">{animations.strip}</button><button type="button" data-view="ball" aria-pressed="false">{animations.ball}</button></div>
    <label class="toggle-row"><span><strong>{t.reduced}</strong></span><input id="reduced" type="checkbox" role="switch"/><span class="toggle" aria-hidden="true"></span></label>
   </fieldset>
   <fieldset class="metronome-practice-group"><legend>{groups.practice}</legend>
    <label class="toggle-row"><span><strong>{t.gap}</strong></span><input id="gap" type="checkbox" role="switch"/><span class="toggle" aria-hidden="true"></span></label>
    <div class="gap-options" hidden><label>{t.audibleBars}<input id="audible-bars" type="number" min="1" max="16" value="3"/></label><label>{t.silentBars}<input id="silent-bars" type="number" min="1" max="8" value="1"/></label><label class="toggle-row"><span><strong>{t.hideGap}</strong></span><input id="hide-gap" type="checkbox" role="switch"/><span class="toggle" aria-hidden="true"></span></label></div>
   </fieldset>
  </form>
 </aside>
 <p class="local-note">{t.local}</p>
 <section class="guide metronome-guide"><div class="guide-heading"><h2>{t.guide}</h2></div><div class="guide-grid">{t.steps.map((step,i)=><article><span class="step-number">0{i+1}</span><h3>{step}</h3><p>{t.tips[i]}</p></article>)}</div><p class="timing-note">{t.note} {t.saved}</p></section>
 <noscript><p class="notice">{t.js}</p></noscript>
 <script src="../scripts/metronome.ts"></script>
</Layout>
