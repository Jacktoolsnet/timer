{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build: Company",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix company run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: Timer",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix timer run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: Clock",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix clock run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: Metronome",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix metronome run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: Stopwatch",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix stopwatch run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: Breathe",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix breathe run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: Relax",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix relax run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: Calculator",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix calculator run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: SceneScript",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix scenescript run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: Lava",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix lava run build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build: MessageDrop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "build"
      ],
      "cwd": "${workspaceFolder}/../messagedrop/platform/messagedrop",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": false
    },
    {
      "name": "Build: Alle Seiten",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build-all.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": false,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
