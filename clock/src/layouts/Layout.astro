---
import '../styles/global.css';
import { colorSchemes } from '../lib/engine';
import { getDictionary, languages, languageNames, type Language } from '../lib/i18n';
interface Props { lang: Language; title: string; description: string; route: string; noindex?: boolean; legal?: boolean }
const { lang, title, description, route, noindex = false, legal = false } = Astro.props;
const t = getDictionary(lang);
const canonical = new URL(Astro.url.pathname === '/' ? '/en/' : Astro.url.pathname, Astro.site);
const alternateLanguages = legal ? (['en', 'de'] as const) : languages;
---
<!doctype html>
<html lang={lang} data-palette="terracotta" data-style="warm" data-font-size="0">
  <head>
    <meta charset="UTF-8" />
    {Astro.url.pathname === '/' && <script is:inline>
      // Only negotiate language on the neutral entry URL, never on localized pages.
      const supportedLanguages = ['en', 'de', 'es', 'fr'];
      const browserLanguages = navigator.languages?.length ? navigator.languages : [navigator.language || 'en'];
      let preferredLanguage = browserLanguages
        .map(language => language.toLowerCase().split('-')[0])
        .find(language => supportedLanguages.includes(language)) || 'en';
      try {
        const saved = JSON.parse(localStorage.getItem('jacktools.clock.storage-consent.v1') === 'yes' ? localStorage.getItem('jacktools.clock.appearance.v1') || 'null' : 'null');
        if (supportedLanguages.includes(saved?.language)) preferredLanguage = saved.language;
      } catch {}
      window.location.replace('/' + preferredLanguage + '/' + window.location.search + window.location.hash);
    </script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f5ee" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title} · Jacktools</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternateLanguages.map(l => <link rel="alternate" hreflang={l} href={new URL('/' + l + '/' + (route ? route + '/' : ''), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/en/' + (route ? route + '/' : ''), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title + ' · Jacktools'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      try {
        const s = JSON.parse(localStorage.getItem('jacktools.clock.storage-consent.v1') === 'yes' ? localStorage.getItem('jacktools.clock.settings.v1') || 'null' : 'null');
        if (s?.remember === true) {
          if (s.dark === true) document.documentElement.dataset.theme = 'dark';
          if (['terracotta', 'blue', 'green', 'orange', 'red', 'violet', 'teal', 'rose'].includes(s.colorScheme)) {
            document.documentElement.dataset.palette = s.colorScheme;
          }
        }
      } catch {}
      try {
        const saved = JSON.parse(localStorage.getItem('jacktools.clock.storage-consent.v1') === 'yes' ? localStorage.getItem('jacktools.clock.appearance.v1') || 'null' : 'null');
        if (saved) {
          if (typeof saved.dark === 'boolean') document.documentElement.dataset.theme = saved.dark ? 'dark' : 'light';
          if (['terracotta', 'blue', 'green', 'orange', 'red', 'violet', 'teal', 'rose'].includes(saved.colorScheme)) document.documentElement.dataset.palette = saved.colorScheme;
          if (Number.isInteger(saved.fontSize) && saved.fontSize >= 0 && saved.fontSize <= 3) document.documentElement.dataset.fontSize = String(saved.fontSize);
          if (['warm', 'minimal', 'technical', 'soft'].includes(saved.style)) document.documentElement.dataset.style = saved.style;
        }
      } catch {}
    </script>
  </head>
  <body class:list={{ "legal-document": legal }}>
    <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt' : lang === 'es' ? 'Ir al contenido' : lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={'/' + lang + '/'} aria-label="Jacktools Clock">
          <span class="brand-icon"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12"/><path d="M16 7v1m9 8h-1m-8 9v-1m-9-8h1M16 10v6l5 3"/></svg></span>
          <span class="brand-wordmark">jacktools<span class="brand-dot">.</span>net<span class="brand-product">/clock</span></span>
        </a>
        <div class="header-tools">
          <details class="palette-dropdown" id="palette-dropdown">
            <summary class="preferences-trigger" aria-label={t.menuSettings} title={t.menuSettings}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 3-.5 2-2 .9-1.8-.6-2 3.4 1.5 1.4v2.8L3.7 14l2 3.4 1.8-.6 2 .9.5 2.3h4l.5-2.3 2-.9 1.8.6 2-3.4-1.5-1.1v-2.8l1.5-1.4-2-3.4-1.8.6-2-.9L14 3Z"/><circle cx="12" cy="11.5" r="3"/></svg>
            </summary>
            <div class="palette-menu preferences-panel">
              <div class="preferences-heading"><h2>{t.menuSettings}</h2><button id="preferences-close" type="button" aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
              <section class="preferences-language" aria-labelledby="language-heading">
                <h3 id="language-heading">{t.language}</h3>
            <nav class="language-menu" aria-label={t.language}>
              {alternateLanguages.map(l => <a href={'/' + l + '/' + (route ? route + '/' : '')} lang={l} hreflang={l} aria-current={l === lang ? 'page' : undefined}>
                <span class="language-code" aria-hidden="true">{l.toUpperCase()}</span>
                <span>{languageNames[l]}</span>
                {l === lang && <svg class="language-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4 10-10"/></svg>}
              </a>)}
            </nav>
              </section>
              <section class="preferences-theme" aria-labelledby="appearance-heading">
                <h3 id="appearance-heading">{t.appearance}</h3>
                <div class="theme-segments" role="group" aria-label={t.appearance}>
                  <button type="button" id="theme-light" class="theme-light" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>{t.lightMode}</button>
                  <button type="button" id="theme" class="theme-dark" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.3A8.6 8.6 0 0 1 8.7 4 8.6 8.6 0 1 0 20 15.3Z"/></svg>{t.darkMode}</button>
                </div>
              </section>
            <fieldset class="palette-grid">
              <legend>{t.colorScheme}</legend>
              {colorSchemes.map(color => <label class="palette-option" title={t[color]}>
                <input type="radio" name="colorScheme" value={color} aria-label={t[color]} checked={color === 'terracotta'} />
                <span class="palette-chip"><span class="palette-swatch" data-color={color} aria-hidden="true"></span></span>
              </label>)}
            </fieldset>
            <fieldset class="style-picker">
              <legend>{t.styleLabel}</legend>
              {(['warm', 'minimal', 'technical', 'soft'] as const).map(style => <label title={t[style]}>
                <input type="radio" name="visualStyle" aria-label={t[style]} value={style} checked={style === 'warm'} />
                <span data-style-preview={style}>
                  {style === 'warm' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19h5m-2.5 0 5-14 5 14M15 19h5M10 13h6"/></svg>}
                  {style === 'minimal' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 12h10M5 18h14"/></svg>}
                  {style === 'technical' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 6-5 6 5 6m8-12 5 6-5 6M14 4l-4 16"/></svg>}
                  {style === 'soft' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="7"/><path d="M8 9c0-1 1-2 2-2"/></svg>}
                </span>
              </label>)}
            </fieldset>
            <div class="font-size-picker">
              <label for="font-size">{t.fontSize}<output id="font-size-value" for="font-size">100 %</output></label>
              <input id="font-size" type="range" min="0" max="3" step="1" value="0" aria-valuetext="100 %" />
              <div class="font-size-steps" aria-hidden="true"><span>100 %</span><span>110 %</span><span>120 %</span><span>130 %</span></div>
            </div>
            <div class="storage-choice"><label><span class="storage-switch"><input type="checkbox" role="switch" id="remember-preferences" aria-describedby="remember-hint" /><span class="storage-switch-track" aria-hidden="true"></span></span> <span>{t.rememberPreferences}</span></label><p id="remember-hint">{t.rememberHint}</p><p id="storage-status" role="status"></p></div>
            </div>
          </details>

        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <section class="support-section" aria-labelledby="support-title">
          <div><h2 id="support-title">{t.supportTitle}</h2><p>{t.supportBody}</p></div>
          <div class="support-actions">
            <a href="https://buymeacoffee.com/jacktoolsnet" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"><span aria-hidden="true">☕</span>{t.supportCoffee}<span aria-hidden="true">↗</span></a>
            <a href="https://app.messagedrop.de" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">{t.supportVisit}<span aria-hidden="true">↗</span></a>
          </div>
        </section>
        <div><a class="footer-brand" href={'/' + lang + '/'}>jacktools.net</a><p>{t.footer}</p></div>
        <nav aria-label={t.legal}><a href={'/' + (lang === 'de' ? 'de' : 'en') + '/legal/'}>{t.legal}{!['de','en'].includes(lang) && ' (EN)'}</a><a href={'/' + (lang === 'de' ? 'de' : 'en') + '/privacy/'}>{t.privacy}{!['de','en'].includes(lang) && ' (EN)'}</a><a href={'/' + (lang === 'de' ? 'de' : 'en') + '/usage/'}>{t.usage}{!['de','en'].includes(lang) && ' (EN)'}</a><button id="privacy-open">{t.preferences}</button></nav>
        <p class="footer-credit">{t.creditBefore} ❤️ ☕ {t.creditAnd} 🍫 {t.creditAfter} <a href="https://jacktools.net" rel="noreferrer" referrerpolicy="no-referrer"><strong>jacktools.net</strong></a></p>
      </footer>
    </div>
    <dialog id="privacy-dialog" aria-labelledby="privacy-title">
      <div class="dialog-inner"><span class="eyebrow">JACKTOOLS / PRIVACY</span><h2 id="privacy-title">{t.privacyTitle}</h2><p>{t.privacyBody}</p><p class="notice">{t.privacyNote}</p><p id="privacy-status" role="status"></p><div class="dialog-actions"><button class="secondary" id="clear-storage" data-message={t.cleared} data-error={t.storageError}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6" /></svg><span>{t.clear}</span></button><form method="dialog"><button class="primary">{t.close}</button></form></div></div>
    </dialog>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
