---
import {tvText} from '../lib/tv-text';
import type {Language} from '../lib/i18n';
import '../styles/tv.css';
const api=import.meta.env.DEV?'':import.meta.env.PUBLIC_BACKEND_URL||'https://backend.jacktools.net';
if(!import.meta.env.DEV){const url=new URL(api);if(url.protocol!=='https:'||url.username||url.password||url.search||url.hash||url.pathname!=='/')throw new Error('Invalid TV backend URL: production requires an HTTPS origin');}
const {lang,receiver=false}=Astro.props as {lang:Language;receiver?:boolean};const t=tvText[lang];
---
<div id="clock-tv" data-receiver={String(receiver)} data-text={JSON.stringify(t)} data-api={api}>
{receiver?<>
 <section id="tv-receiver-panel" class="tv-panel" aria-label={t.title}>
  <span class="tv-icon tv-pairing-info" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="3"/><path d="M8 21h8m-4-4v4"/></svg></span>
  <h1 id="tv-title" class="tv-pairing-info">{t.title}</h1><p class="tv-pairing-info">{t.waiting}</p>
  <canvas id="tv-qr" aria-label="QR" role="img" hidden></canvas><output id="tv-code"></output>
  <div id="tv-proposal" hidden><div class="tv-clock-preview"><iframe id="tv-preview" title={t.preview} tabindex="-1" allow="camera 'none'; microphone 'none'; geolocation 'none'; screen-wake-lock 'none'"></iframe></div><p id="tv-sender-name"></p></div>
  <div class="tv-actions"><button id="tv-approve" class="primary" hidden>{t.approve}</button><button id="tv-reject" class="secondary" hidden>{t.reject}</button><button id="tv-retry" class="secondary" hidden>{t.retry}</button></div>
  <p id="tv-status" role="status" aria-live="polite"></p><div id="tv-validity" class="tv-validity tv-pairing-info" hidden><div><span id="tv-validity-label">{t.codeValidFor}</span><output id="tv-countdown" aria-live="off"></output></div><progress id="tv-validity-progress" max="600" value="600" aria-label={t.codeValidFor}></progress></div>
 </section>
 <div id="tv-controls" class="tv-controls header-focus-actions" hidden><button id="tv-stop" class="icon-text" aria-label={t.stop} title={t.stop}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7H7a5 5 0 0 0 0 10h2m6-10h2a5 5 0 0 1 0 10h-2M8 12h8M3 3l18 18"/></svg></button><span id="tv-live-status" role="status"></span></div>
</>:<>

 <dialog id="tv-dialog" aria-labelledby="tv-title" aria-describedby="tv-pair-hint"><div class="dialog-inner"><h2 id="tv-title">{t.title}</h2><p id="tv-pair-hint"><span>{t.open}</span><a class="tv-receiver-url" href={import.meta.env.DEV?'/stream/':'https://clock.jacktools.net/stream/'} target="_blank" rel="noopener noreferrer"><span>clock.jacktools.net<strong>/stream</strong></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7m0-7L10 14M10 3H3v18h18v-7"/></svg></a><span>{t.enterCode}</span></p>
 <form id="tv-pair-form">
  <button id="tv-scan" class="secondary tv-scan-button" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/><rect x="7" y="7" width="10" height="10" rx="2"/><circle cx="12" cy="12" r="2"/></svg>{t.scan}</button>
  <div id="tv-code-entry"><label><span class="sr-only">{t.code}</span><input id="tv-pair-code" autofocus placeholder={t.code} inputmode="numeric" pattern="[0-9]{8}" maxlength="12" autocomplete="off" required /></label>
   <div id="tv-keypad" class="tv-keypad" role="group" aria-label={t.keypad}>
    {[1,2,3,4,5,6,7,8,9].map(digit=><button type="button" data-key={String(digit)}>{digit}</button>)}
    <button type="button" data-key="clear" aria-label={t.clear} title={t.clear}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7"/></svg></button>
    <button type="button" data-key="0">0</button>
    <button type="button" data-key="backspace" aria-label={t.backspace} title={t.backspace}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5-7 7 7 7h12V5ZM12 9l6 6m0-6-6 6"/></svg></button>
   </div>
  </div>
  <button id="tv-send" class="primary" type="submit">{t.send}</button>
 </form>
 <p id="tv-status" role="status" aria-live="polite"></p><div class="dialog-actions"><button id="tv-detach" class="secondary" hidden>{t.detach}</button><button id="tv-close" class="secondary">{t.close}</button></div></div></dialog>
 <dialog id="tv-scanner-dialog" aria-labelledby="tv-scanner-title" aria-describedby="tv-scanner-status"><div class="dialog-inner"><h2 id="tv-scanner-title">{t.scanTitle}</h2><div class="tv-scanner-preview"><video id="tv-scanner-video" autoplay playsinline muted aria-label={t.scanHint}></video><span aria-hidden="true"></span></div><p id="tv-scanner-status" role="status" aria-live="polite"></p><div class="dialog-actions"><button id="tv-scanner-retry" type="button" class="secondary" hidden>{t.scan}</button><button id="tv-scanner-close" type="button" class="secondary" autofocus>{t.close}</button></div></div></dialog>
</>}
</div>
