---
import { alarmToneIds } from '../lib/alarm-tones';
import { alarmText } from '../lib/alarm-text';
import type { Language } from '../lib/i18n';
interface Props { lang: Language }
const t=alarmText[Astro.props.lang];
---
<fieldset id="clock-alarm" class="clock-alarm-group" data-text={JSON.stringify(t)}>
 <legend>{t.title}</legend>
 <div class="clock-alarm-fields">
 <div><label class="alarm-time-field" for="alarm-time">{t.time}</label>
 <div class="alarm-time-picker-wrap"><div class="alarm-time-input-row"><input id="alarm-time" type="text" inputmode="numeric" value="07:00" maxlength="5" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" aria-label={t.time}/><button id="alarm-time-open" type="button" aria-label={t.chooseTime} aria-expanded="false" aria-controls="alarm-time-picker"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></button></div>
 <div id="alarm-time-picker" hidden><label>{t.hour}<select name="alarmHour">{Array.from({length:24},(_,i)=><option value={String(i).padStart(2,'0')} selected={i===7}>{String(i).padStart(2,'0')}</option>)}</select></label><label>{t.minute}<select name="alarmMinute">{Array.from({length:60},(_,i)=><option value={String(i).padStart(2,'0')}>{String(i).padStart(2,'0')}</option>)}</select></label><button id="alarm-time-done" class="secondary" type="button">{t.done}</button></div></div><p id="alarm-zone" class="form-hint"></p><label class="toggle-row"><span><strong>{t.enabled}</strong></span><input id="alarm-enabled" type="checkbox" role="switch"/><span class="toggle" aria-hidden="true"></span></label></div>
 <div><label class="alarm-time-field" for="alarm-volume">{t.volume}<span class="clock-transparency-control"><input id="alarm-volume" type="range" min="0" max="100" value="50"/><output id="alarm-volume-value" for="alarm-volume">50 %</output></span></label><label class="toggle-row"><span><strong>{t.vibration}</strong></span><input id="alarm-vibration" type="checkbox" role="switch" aria-describedby="alarm-vibration-hint"/><span class="toggle" aria-hidden="true"></span></label><p id="alarm-vibration-hint" class="form-hint">{t.vibrationHint}</p></div>
 <div><label>{t.tone}<select id="alarm-tone" name="alarmTone">{alarmToneIds.map((id,index)=><option value={id}>{t.toneNames[index]}</option>)}</select></label><button id="alarm-test" class="secondary" type="button">{t.test}</button><p id="alarm-status" class="settings-status" role="status"></p><p id="alarm-audio-status" class="settings-status" role="status"></p></div>
 </div>
 <p class="form-hint alarm-warning">{t.warning}</p><p class="form-hint">{t.settingsHint}</p>
</fieldset>
