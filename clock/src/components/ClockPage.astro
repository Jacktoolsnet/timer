---
import {toolSeo} from '../../../shared/seo';
import { analogDesigns, analogDesignText, dialMarkup, analogPreview, analogDesignStyles } from '../lib/analog-designs';
import { clockGuide } from '../lib/clock-guide';
import Layout from '../layouts/Layout.astro';
import { getDictionary, type Language } from '../lib/i18n';
import ClockAlarm from './ClockAlarm.astro';
import { alarmText } from '../lib/alarm-text';
import AnimatedBackgrounds from './AnimatedBackgrounds.astro';
import AnimatedAurora from './AnimatedAurora.astro';
import SeasonalBackground from './SeasonalBackground.astro';
import { clockText } from '../lib/clock-text';
import { clockBackgrounds, backgroundText, locationText } from '../lib/clock-backgrounds';
interface Props { lang: Language }
const {lang}=Astro.props; const t=getDictionary(lang);const c=clockText[lang];const guide=clockGuide[lang];
const groups={de:{display:'Uhr & Datum',behavior:'Zeit & Verhalten'},en:{display:'Clock & date',behavior:'Time & behavior'},es:{display:'Reloj y fecha',behavior:'Hora y comportamiento'},fr:{display:'Horloge et date',behavior:'Heure et comportement'}}[lang];
const alarm=alarmText[lang];
const designs=analogDesignText[lang];
const backgrounds=backgroundText[lang];const location=locationText[lang];
const seo=toolSeo.clock[lang];
---
<Layout lang={lang} title={seo.title} description={seo.description} route="">
<section class="intro"><p class="eyebrow">{c.title}</p><h1>{seo.heading}</h1><p class="intro-copy">{seo.description}</p></section>
<div id="clock-app" data-text={JSON.stringify({...t,...c})}>
<div class="workspace">
<section class="timer-card clock-card">
<SeasonalBackground />
<AnimatedAurora />
<AnimatedBackgrounds />
<p id="clock-alarm-badge" class="clock-alarm-badge" hidden></p>
<div class="card-top"><button id="clock-focus" class="icon-text" aria-label={t.focusMode} aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg><span>{t.focusMode}</span></button></div>
<div class="clock-display" data-view="analog">
<style is:inline set:html={analogDesignStyles} />
<svg class="analog-face" data-design="standard" id="analog-clock" viewBox="0 0 320 320" role="img" aria-label={c.analog}>
<g id="dial-face" set:html={dialMarkup('standard')} />
<foreignObject id="alarm-analog-indicator" x="99" y="207" width="122" height="44" style="display:none" aria-hidden="true"><div class="alarm-dial-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="7"/><path d="m5 3-3 3m17-3 3 3M12 9v4l3 2M7 19l-2 3m12-3 2 3"/></svg><span id="alarm-analog-time">07:00</span><span id="alarm-analog-flips" hidden aria-hidden="true"></span></div></foreignObject>
<line id="hour-hand" x1="160" y1="170" x2="160" y2="83"/><line id="minute-hand" x1="160" y1="176" x2="160" y2="48"/><line id="second-hand" x1="160" y1="187" x2="160" y2="32"/><circle cx="160" cy="160" r="5" class="hub"/>
</svg>
<div class="clock-readout"><div id="flip-clock" aria-hidden="true"></div><p id="flip-context" aria-hidden="true"></p><time id="digital-clock" aria-live="off">--:--</time><div id="alarm-readout-indicator" class="alarm-readout-indicator" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="7"/><path d="m5 3-3 3m17-3 3 3M12 9v4l3 2M7 19l-2 3m12-3 2 3"/></svg><span id="alarm-readout-time"></span><span id="alarm-mini-flips" aria-hidden="true"></span></div><p id="clock-date"></p><div id="styled-date" hidden></div><p id="clock-zone"></p></div>
</div>
<p id="wake-status" class="timer-status" role="status"></p><noscript>{t.js}</noscript>
</section>
<aside class="settings-card"><h2>{t.settings}</h2><form id="clock-settings" class="clock-settings">
<fieldset class="clock-settings-group"><legend>{groups.display}</legend>
<label>{t.appearance}<select name="view">{(['analog','digital','combined','flip','analogFlip'] as const).map(v=><option value={v} selected={v==='analog'}>{c[v]}</option>)}</select></label>
<label>{designs.label}<select name="analogDesign">{analogDesigns.map((id,index)=><option value={id} data-preview={analogPreview(id)}>{designs.names[index]}</option>)}</select></label>
<label>{c.dateAppearance}<select name="dateView">{(['textDate','calendarDate','elegantDate','flipDate'] as const).map(v=><option value={v} selected={v==='calendarDate'}>{c[v]}</option>)}</select></label>
<label>{c.date}<select name="date">{(['off','short','medium','long'] as const).map(v=><option value={v} selected={v==='long'}>{c[v]}</option>)}</select></label>
{(['seconds','numbers','smooth'] as const).map(k=><label class="toggle-row"><span><strong>{c[k]}</strong></span><input type="checkbox" role="switch" name={k} checked={k==='seconds'||k==='numbers'} /><span class="toggle" aria-hidden="true"></span></label>)}
</fieldset>
<fieldset class="clock-settings-group"><legend>{backgrounds.label}</legend>
<label>{backgrounds.label}<select name="background"><option value="none">{backgrounds.none}</option>{clockBackgrounds.map((id,index)=><option value={id} data-preview={'/backgrounds/'+id+'.svg'}>{backgrounds.names[index]}</option>)}<option value="seasonal" data-preview="/backgrounds/seasonal-preview.svg">{backgrounds.seasonal}</option></select></label>
<label id="clock-background-animation" class="toggle-row" hidden><span><strong>{backgrounds.animate}</strong></span><input type="checkbox" role="switch" name="animateBackground" disabled/><span class="toggle" aria-hidden="true"></span></label>
<label class="clock-transparency" hidden>{backgrounds.transparency}<span class="clock-transparency-control"><input id="clock-transparency" name="transparency" type="range" min="0" max="100" step="1" value="0" disabled aria-describedby="clock-transparency-hint"/><output id="clock-transparency-value" for="clock-transparency">0 %</output></span></label>
<p id="clock-transparency-hint" class="form-hint" hidden>{backgrounds.transparencyHint}</p>
<div id="seasonal-settings" data-location-text={JSON.stringify(location)} hidden>
<fieldset id="seasonal-hemisphere"><legend>{backgrounds.hemisphere}</legend>
<select name="hemisphere" hidden aria-hidden="true"><option value="north">{backgrounds.north}</option><option value="south">{backgrounds.south}</option></select>
<label class="toggle-row"><span><strong>{backgrounds.north}</strong></span><input id="seasonal-north" type="radio" name="seasonalMode" value="north" checked/><span class="toggle" aria-hidden="true"></span></label>
<label class="toggle-row"><span><strong>{backgrounds.south}</strong></span><input id="seasonal-south" type="radio" name="seasonalMode" value="south"/><span class="toggle" aria-hidden="true"></span></label>
<label class="toggle-row"><span><strong>{location.label}</strong></span><input id="seasonal-location" type="radio" name="seasonalMode" value="location" aria-describedby="seasonal-location-hint"/><span class="toggle" aria-hidden="true"></span></label>
</fieldset>
<p id="seasonal-location-hint" class="form-hint">{location.hint}</p><p id="seasonal-location-status" class="settings-status" role="status"></p>
</div>

</fieldset>
<fieldset class="clock-settings-group"><legend>{groups.behavior}</legend>
<label>{c.time}<select name="format">{(['short','medium','long'] as const).map(v=><option value={v} selected={v==='medium'}>{c[v]}</option>)}</select></label>
<label>12 / 24 h<select name="hourCycle"><option value="auto">{c.auto}</option><option value="12">12 h</option><option value="24">24 h</option></select></label>
<label>{c.zone}<select name="zone"><option value="local">{c.local}</option>{['UTC','Europe/Berlin','Europe/London','Europe/Paris','Europe/Madrid','America/New_York','America/Los_Angeles','Asia/Tokyo','Asia/Kolkata','Australia/Sydney'].map(z=><option value={z}>{z.replaceAll('_',' ')}</option>)}</select></label>
<label class="toggle-row"><span><strong>{c.awake}</strong></span><input type="checkbox" role="switch" name="awake"/><span class="toggle" aria-hidden="true"></span></label>
</fieldset>
<ClockAlarm lang={lang} />
<p id="clock-settings-status" role="status"></p>
</form></aside></div><p class="local-note">{c.note}</p><p class="privacy-promise">{t.privacyPromise}</p></div>
<section class="guide"><div class="guide-heading"><p class="eyebrow">THE JACKTOOLS.NET WAY</p><h2>{guide.heading}</h2><p>{guide.body}</p></div><div class="guide-grid">{guide.steps.map(([title,body],i)=><article><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section class="faq"><h2>{t.faq}</h2>{guide.faq.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</section>
<dialog id="alarm-dialog" aria-labelledby="alarm-dialog-title"><div class="dialog-inner"><h2 id="alarm-dialog-title">{alarm.ringing}</h2><p id="alarm-dialog-time"></p><p id="alarm-dialog-audio" role="status"></p><div class="dialog-actions"><button id="alarm-stop" type="button" class="primary" autofocus>{alarm.stop}</button><button id="alarm-snooze" type="button" class="secondary">{alarm.snooze}</button></div></div></dialog>
<script src="../scripts/clock.ts"></script>
</Layout>
