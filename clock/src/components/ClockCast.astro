---
import {castText} from '../lib/cast-text';
import type {Language} from '../lib/i18n';
const {lang}=Astro.props as {lang:Language};
const t=castText[lang];
const appId=import.meta.env.PUBLIC_CAST_APP_ID||'';
---
<button id="clock-cast" class="icon-text" type="button" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8V4h18v14h-7M3 20v-1m0-4a5 5 0 0 1 5 5M3 11a9 9 0 0 1 9 9"/></svg><span>{t.button}</span></button>
<dialog id="clock-cast-dialog" aria-labelledby="clock-cast-title" data-text={JSON.stringify(t)}>
 <div class="dialog-inner">
  <h2 id="clock-cast-title">{t.title}</h2><p>{t.intro}</p><p>{t.privacy}</p>
  <label for="cast-app-id">{t.appId}</label><input id="cast-app-id" type="text" value={appId} maxlength="8" pattern="[0-9a-fA-F]{8}" autocomplete="off" spellcheck="false" placeholder="ABCD1234" />
  <p class="form-hint">{t.setup} <a href="https://cast.google.com/publish/" target="_blank" rel="noopener noreferrer">Google Cast Developer Console ↗</a></p>
  <label class="cast-location-choice"><input id="cast-share-location" type="checkbox" /> {t.share}</label><p class="form-hint">{t.location}</p>
  <p id="cast-status" role="status" aria-live="polite"></p>
  <div class="dialog-actions"><button id="cast-connect" type="button" class="primary" disabled>{t.connect}</button><button id="cast-disconnect" type="button" class="secondary" hidden>{t.disconnect}</button><button id="cast-stop" type="button" class="secondary" hidden>{t.stop}</button><button id="cast-close" type="button" class="secondary">{t.close}</button></div>
 </div>
</dialog>
