---
import Layout from '../../layouts/Layout.astro';
import {clockText} from '../../lib/clock-text';
import {getDictionary} from '../../lib/i18n';
export function getStaticPaths(){return (['de','en'] as const).map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;const t=getDictionary(lang);
---
<Layout lang={lang} title={t.usage} description={t.usage} route="usage" legal noindex><article class="legal-page"><h1>{t.usage}</h1><nav class="legal-nav"><a href="/de/usage/">Deutsch</a><a href="/en/usage/">English</a></nav><p>{clockText[lang].usage}</p><p>{lang==='de'?'Wir stellen die Uhr kostenlos und ohne Anmeldung bereit. Unterstützung ist freiwillig. Gesetzliche Rechte bleiben unberührt.':'We provide this clock free of charge without an account. Support is voluntary. Statutory rights remain unaffected.'}</p><p><a href="mailto:jacktoolsnet@gmail.com">jacktoolsnet@gmail.com</a></p></article></Layout>
