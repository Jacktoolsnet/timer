---
import Layout from '../../layouts/Layout.astro';
import Original from '../../components/usage/Original.astro';
import UsageTranslation from '../../../../shared/UsageTranslation.astro';
import {languages,type Language} from '../../lib/i18n';
export function getStaticPaths(){return languages.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props as {lang:Language};
const title=lang==='es'?'Instrucciones de uso':'Guide d’utilisation';

---
{lang==='de'||lang==='en'?<Original lang={lang}/>:
 <Layout lang={lang} title={title} description={title+' · Jacktools Clock'} route="usage" noindex legal>
  <UsageTranslation tool="clock" lang={lang}/>
 </Layout>}
