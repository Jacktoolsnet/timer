---
import AdVisibility from './AdVisibility.astro';
interface Props { lang: string }
const { lang } = Astro.props;
const label = ({ de: 'Werbung', en: 'Advertisement', es: 'Publicidad', fr: 'Publicité' } as Record<string,string>)[lang] || 'Advertisement';
---
<aside data-ad-placement data-ad-state="pending" class="tool-ad" aria-label={label}>
  <p class="tool-ad-label">{label}</p>
  <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5182500947872057" crossorigin="anonymous"></script>
  <ins class="adsbygoogle" style="display:block"
    data-ad-client="ca-pub-5182500947872057"
    data-ad-slot="4560273012"
    data-ad-format="horizontal"
    data-full-width-responsive="true"></ins>
  <script is:inline>
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</aside>
<AdVisibility />
<style>
  .tool-ad { grid-column:1 / -1; width:100%; min-width:0; margin:24px 0; align-self:start; }
  .tool-ad-label { margin:0 0 12px; color:var(--muted); text-align:center; font-size:12px; }
  .adsbygoogle { width:100%; min-height:1px; }
  :global(body.focus-view) .tool-ad { display:none !important; }
  @media print { .tool-ad { display:none !important; } }
</style>
