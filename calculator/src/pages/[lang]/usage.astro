---
import Layout from '../../layouts/Layout.astro';
import {languages,languageNames,type Language} from '../../lib/i18n';
import {usageText} from '../../lib/usage-text';
export function getStaticPaths(){return languages.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props as {lang:Language};const u=usageText[lang];
---
<Layout lang={lang} title={u.title} description={u.description} route="usage" legal>
<article class="legal-page usage-page">
 <p class="eyebrow">JACKTOOLS.NET / {u.title.toUpperCase()}</p><h1>{u.title}</h1>
 <nav class="legal-nav" aria-label={u.title}>{languages.map(language=><a href={'/'+language+'/usage/'} lang={language} hreflang={language} aria-current={language===lang?'page':undefined}>{languageNames[language]}</a>)}</nav>
 <p>{u.intro}</p>
 <nav class="usage-contents" aria-label={u.contents}><h2>{u.contents}</h2><ul>{u.sections.map(section=><li><a href={'#'+section.id}>{section.title}</a></li>)}</ul></nav>
 {u.sections.map(section=><section aria-labelledby={section.id}><h2 id={section.id}>{section.title}</h2>{section.paragraphs?.map(paragraph=><p>{paragraph}</p>)}{section.items&&<ul>{section.items.map(item=><li>{item}</li>)}</ul>}</section>)}
 <p><a href={lang==='de'?'/de/privacy/':'/en/privacy/'}>{u.privacy}{!['de','en'].includes(lang)&&' (EN)'}</a></p>
 <h2>{u.contact}</h2><p><a href="mailto:jacktoolsnet@gmail.com">jacktoolsnet@gmail.com</a></p><p>{u.notice}</p>
 <p class="legal-back"><a href={'/'+lang+'/'}>← {u.back}</a></p>
</article>
</Layout>
<style>
 .usage-page{overflow-wrap:anywhere}
 .usage-page .legal-nav{flex-wrap:wrap;gap:10px 20px}.usage-page .legal-nav [aria-current=page]{font-weight:650;text-decoration:none}
 .usage-page section h2{scroll-margin-top:24px}.usage-page li{margin-bottom:12px}.usage-contents{margin:28px 0;padding:4px 20px 12px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.usage-contents ul{padding-left:20px}.usage-contents li{margin-bottom:4px}
 @media print{.usage-contents{display:none}}
</style>
