{
  "name": "@nulltopic/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "check": "tsc --noEmit",
    "migrate": "tsx --env-file=../.env src/cli.ts migrate",
    "cleanup": "tsx --env-file=../.env src/cli.ts cleanup",
    "bootstrap": "tsx --env-file=../.env src/cli.ts bootstrap",
    "test": "tsx --env-file=../.env --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/session": "^11.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.3",
    "argon2": "^0.44.0",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
