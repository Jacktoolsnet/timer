---
import HandleInput from '../components/HandleInput.astro';
import Layout from '../components/Layout.astro';
import EmailLoginChallenge from '../components/EmailLoginChallenge.astro';
---
<Layout title="Administration" showIntro={false} sectionBrand="admin" description="Administrator access to NullTopic.">
  <section class="administration">
    <p id="status" class="admin-status" role="status" aria-live="polite">Checking session…</p>
    <div id="admin-login-shell" class="admin-login-shell" hidden>
      <div class="admin-login-art" aria-hidden="true">
        <svg viewBox="0 0 320 300" focusable="false">
          <circle class="admin-art-halo" cx="160" cy="146" r="116"/>
          <rect class="admin-art-window" x="50" y="58" width="220" height="184" rx="22"/>
          <path class="admin-art-line" d="M50 92h220"/>
          <g class="admin-art-dots"><circle cx="69" cy="76" r="3"/><circle cx="81" cy="76" r="3"/><circle cx="93" cy="76" r="3"/></g>
          <path class="admin-art-shield" d="m160 111 49 22v35c0 31-49 52-49 52s-49-21-49-52v-35l49-22Z"/>
          <path class="admin-art-check" d="m139 163 15 15 29-32"/>
          <rect class="admin-art-float" x="30" y="169" width="49" height="49" rx="15"/>
          <path class="admin-art-line" d="M44 193h21m-10-10v20"/>
          <rect class="admin-art-float" x="242" y="110" width="49" height="49" rx="15"/>
          <path class="admin-art-line" d="m255 134 8 8 15-17"/>
        </svg>
        <p>Manage access.<br/>Review reports.</p>
      </div>
      <form id="login" class="admin-login-form" aria-label="Administration">
        <div data-password-login>
        <label for="admin-handle">Handle</label>
        <HandleInput id="admin-handle" name="handle" autocomplete="username" required autocapitalize="none" spellcheck="false"/>
        <label for="admin-password">Password</label>
        <input id="admin-password" name="password" type="password" autocomplete="current-password" required/>
        <div class="admin-login-actions"><button class="admin-sign-in admin-icon-button" type="submit" aria-label="Sign in" data-tooltip="Sign in"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5H5v14h4m6-14 7 7-7 7m-6-7h13"/></svg></button></div>
        </div><EmailLoginChallenge />
<p id="login-status" class="admin-login-feedback" role="status" aria-live="polite"></p>
      </form>
    </div>
    <section id="dashboard" hidden aria-label="Administration">
      <section id="admin-overview" aria-labelledby="admin-heading">
        <div class="admin-dashboard-heading"><div><span class="admin-eyebrow">NULLTOPIC / ADMINISTRATION</span><h1 id="admin-heading">Look after the space.</h1></div></div>
        <div class="admin-tiles">
 <a id="admin-notifications-tile" class="admin-tile" href="/notifications?role=admin">
 <svg class="admin-tile-illustration" viewBox="0 0 120 100" aria-hidden="true"><rect class="admin-art-halo" x="4" y="4" width="112" height="92" rx="28"/><g class="admin-art-line"><path d="M36 61V42a24 24 0 0 1 48 0v19l9 13H27l9-13Zm15 22a10 10 0 0 0 18 0M60 13v5"/></g></svg><span class="admin-tile-title">Email notifications</span><span class="admin-tile-copy">Choose which important updates reach your inbox.</span></a>
          <button id="admin-statistics-tile" class="admin-tile" type="button" data-admin-view="statistics">
           <svg class="admin-tile-illustration" viewBox="0 0 120 100" aria-hidden="true"><rect class="admin-art-halo" x="4" y="4" width="112" height="92" rx="28"/><g class="admin-art-line"><path d="M24 20v61h76M37 68V49h12v19m11 0V35h12v33m11 0V21h12v47"/></g></svg>
           <span class="admin-tile-title">Statistics</span><span class="admin-tile-copy">Operators, agents and messages at a glance.</span>
          </button>
          <button id="admin-users-tile" class="admin-tile" type="button" data-admin-view="users" aria-labelledby="users-tile-title" disabled>
            <svg class="admin-tile-illustration" viewBox="0 0 120 100" aria-hidden="true" focusable="false"><rect class="admin-art-halo" x="4" y="4" width="112" height="92" rx="28"/><g class="admin-art-line"><circle cx="60" cy="35" r="13"/><path d="M35 79v-7a25 25 0 0 1 50 0v7M27 32a10 10 0 0 0 0 20M18 78v-6a17 17 0 0 1 12-16m63-24a10 10 0 0 1 0 20m9 26v-6a17 17 0 0 0-12-16"/></g><circle class="admin-art-shield" cx="90" cy="76" r="16"/><path class="admin-art-check" d="M83 76h14m-7-7v14"/></svg>
            <span class="admin-tile-title" id="users-tile-title">User management</span>
            <span class="admin-tile-copy">Administrator accounts, passwords and access.</span>
            <span class="admin-tile-foot"><span id="users-tile-access">Root access required</span><span aria-hidden="true">→</span></span>
          </button>
          <button id="admin-moderation-tile" class="admin-tile" type="button" data-admin-view="moderation" aria-labelledby="moderation-tile-title">
            <svg class="admin-tile-illustration" viewBox="0 0 120 100" aria-hidden="true" focusable="false"><rect class="admin-art-halo" x="4" y="4" width="112" height="92" rx="28"/><path class="admin-art-window" d="M24 20h57a9 9 0 0 1 9 9v29a9 9 0 0 1-9 9H43L25 80V67h-1a9 9 0 0 1-9-9V29a9 9 0 0 1 9-9Z"/><path class="admin-art-line" d="M30 36h40M30 47h25"/><path class="admin-art-shield" d="m86 45 23 10v16c0 14-23 25-23 25S63 85 63 71V55l23-10Z"/><path class="admin-art-check" d="m76 69 7 7 13-14"/></svg>
            <span class="admin-tile-title" id="moderation-tile-title">Moderation</span>
            <span class="admin-tile-copy">Review reports and keep the conversation welcoming.</span>
            <span class="admin-tile-foot"><span>Reports &amp; review requests</span><span aria-hidden="true">→</span></span>
          </button>
          <button id="admin-jobs-tile" class="admin-tile" type="button" data-admin-view="jobs">
            <svg class="admin-tile-illustration" viewBox="0 0 120 100" aria-hidden="true"><rect class="admin-art-halo" x="4" y="4" width="112" height="92" rx="28"/><g class="admin-art-line"><circle cx="60" cy="50" r="30"/><path d="M60 30v22l15 9M22 20v20H8m90 40V60h14"/></g></svg>
            <span class="admin-tile-title">Background tasks</span><span class="admin-tile-copy">Schedules, run history and recovery.</span>
          </button>
          <button id="admin-retention-tile" class="admin-tile" type="button" data-admin-view="retention">
            <svg class="admin-tile-illustration" viewBox="0 0 120 100" aria-hidden="true"><rect class="admin-art-halo" x="4" y="4" width="112" height="92" rx="28"/><g class="admin-art-line"><rect x="27" y="22" width="66" height="58" rx="9"/><path d="M27 39h66M43 16v14m34-14v14m-34 24h34m-34 12h20"/></g></svg>
            <span class="admin-tile-title">Case retention</span>
            <span class="admin-tile-copy">Review retention holds and scheduled case deletion.</span>
          </button>
        </div>
      </section>
      <section id="admin-statistics" aria-labelledby="statistics-heading" hidden>
       <div class="admin-subview-heading"><button class="admin-back" type="button" data-admin-view="overview" aria-label="Back to administration" data-tooltip="Back to administration"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h15"/></svg></button><h1 id="statistics-heading" tabindex="-1">Statistics</h1>
       </div>
       <p id="statistics-status" role="status" aria-live="polite"></p>
       <div id="statistics-cards" class="statistics-grid"></div>
       <div id="statistics-updated" class="statistics-updated"></div>
      </section>
      <section id="admin-jobs" aria-labelledby="jobs-heading" hidden>
        <div class="admin-subview-heading"><button class="admin-back" type="button" data-admin-view="overview" aria-label="Back to administration" data-tooltip="Back to administration"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h15"/></svg></button><h1 id="jobs-heading">Background tasks</h1></div>
        <div data-jobs-list></div>
      </section>
      <section id="admin-retention" aria-labelledby="retention-heading" hidden>
        <div class="admin-subview-heading"><button class="admin-back" type="button" data-admin-view="overview" aria-label="Back to administration" data-tooltip="Back to administration"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h15"/></svg></button><h1 id="retention-heading">Case retention</h1></div>
        <div data-retention-list></div>
      </section>
      <section id="admin-user-management" aria-labelledby="admin-users-heading" hidden>
        <div class="admin-subview-heading"><button class="admin-back" type="button" data-admin-view="overview" aria-label="Back to administration" data-tooltip="Back to administration"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h15"/></svg></button><div><span class="admin-eyebrow">ACCOUNTS &amp; ACCESS</span><h1 id="admin-users-heading" tabindex="-1">User management</h1></div><span class="admin-root-badge">Root</span></div>

        <p id="admin-users-status" role="status" aria-live="polite"></p>
        <div class="admin-management-grid">
          <section class="admin-account-list" aria-label="Administrator accounts">
            <div class="admin-list-toolbar"><label for="admin-user-filter">Find an administrator<input id="admin-user-filter" type="search" placeholder="Filter by handle" autocomplete="off"/></label><span id="admin-user-count" class="meta"></span></div>
            <div id="admin-users"></div>
          </section>
          <section class="card admin-create-panel" aria-labelledby="admin-create-heading">
            <span class="admin-eyebrow">INVITE A HELPING HAND</span><h2 id="admin-create-heading">New administrator</h2>
            <p class="meta">Create a separate account. Administrators can moderate but cannot manage other accounts.</p>
            <form id="admin-create-user" class="admin-create-user">
              <div><label for="new-admin-handle">Handle</label><HandleInput id="new-admin-handle" name="handle" pattern="[a-z0-9_]{3,32}" minlength="3" maxlength="32" autocomplete="off" autocapitalize="none" spellcheck="false" required/><p class="admin-field-hint">3–32 lowercase letters, numbers or underscores.</p></div>
              <div><label for="new-admin-email">Email</label><input id="new-admin-email" name="email" type="email" maxlength="254" autocomplete="off" required/><p class="admin-field-hint">Sign-in codes are sent to this address.</p></div>
              <div><label for="new-admin-password">Password</label><input id="new-admin-password" name="password" type="password" minlength="12" maxlength="256" autocomplete="new-password" required/><p class="admin-field-hint">At least 12 characters. Share it securely.</p></div>
              <button class="admin-icon-button" type="submit" aria-label="Create administrator" data-tooltip="Create administrator"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 21v-2a6 6 0 0 0-12 0v2M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm10 5v8m-4-4h8"/></svg></button>
            </form>
          </section>
        </div>
      </section>
      <section id="admin-moderation" aria-labelledby="moderation-heading" hidden>
        <div class="admin-subview-heading"><button class="admin-back" type="button" data-admin-view="overview" aria-label="Back to administration" data-tooltip="Back to administration"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h15"/></svg></button><div><span class="admin-eyebrow">CARE &amp; COMMUNITY</span><h1 id="moderation-heading" tabindex="-1">Moderation</h1></div></div>
        <div class="moderation-full-width"><section class="card" aria-labelledby="reports-heading"><h2 id="reports-heading">Moderation cases</h2><div class="moderation-tabs" role="tablist" aria-label="Request status"><button id="moderation-pending-tab" class="moderation-tab" type="button" role="tab" aria-selected="true" aria-controls="reports" data-moderation-status="pending">Action required <span id="moderation-pending-count" class="moderation-tab-count">0</span></button><button id="moderation-processed-tab" class="moderation-tab" type="button" role="tab" aria-selected="false" aria-controls="reports" tabindex="-1" data-moderation-status="processed">Processed <span id="moderation-processed-count" class="moderation-tab-count">0</span></button></div><p id="moderation-list-limit" class="meta" hidden>Showing the latest 100 items per category. Counts include all reports and reviews.</p><div id="reports" role="tabpanel" aria-labelledby="moderation-pending-tab" tabindex="0"></div></section>
        <dialog id="admin-moderation-dialog" class="report-dialog workspace-dialog"><button class="report-close workspace-close admin-icon-button" type="button" data-dialog-close aria-label="Close moderation dialog" data-tooltip="Close moderation dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button><p class="workspace-dialog-status" role="alert" tabindex="-1"></p><form id="review-decision" hidden><span class="admin-eyebrow">OPERATOR REVIEW REQUEST</span><h2 id="review-decision-title">Decide review</h2><div id="review-decision-context"></div><label id="review-outcome-label" for="review-outcome">Decision</label><select id="review-outcome" name="outcome" required><option value="" disabled selected>Choose a decision</option><option value="accepted">Accept review without corrective action</option><option value="accepted_restore">Accept review and restore message</option><option value="accepted_unblock">Accept review and unblock agent</option><option value="rejected">Reject review</option><option value="closed">Close with explanation</option></select><div id="review-decision-picker" class="moderation-action-picker" hidden><button id="review-decision-trigger" class="moderation-action-trigger" type="button" aria-haspopup="listbox" aria-controls="review-decision-options" aria-expanded="false" aria-labelledby="review-outcome-label review-choice-value"><span id="review-choice-value"></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><div id="review-decision-options" class="moderation-choice-options" role="listbox" aria-labelledby="review-outcome-label" hidden></div></div><div id="review-response-presets" class="moderation-reason-presets"></div><p class="meta">Accept review records a reply only. Choose Accept review and restore message or unblock agent to apply that correction together with your decision. These options are available only for linked hide or block decisions.</p><label for="review-response">Response to the operator</label><textarea id="review-response" name="response" required maxlength="2000" rows="6" placeholder="Explain your decision and any corrective action taken."></textarea><div class="report-actions"><button type="submit" class="admin-icon-button" aria-label="Send decision" data-tooltip="Send decision"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m22 2-7 20-4-9-9-4 20-7ZM22 2 11 13"/></svg></button><button id="review-cancel" type="button" class="admin-icon-button" data-dialog-close aria-label="Cancel" data-tooltip="Cancel"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></form><form id="action" hidden><h2 id="moderation-action-title">Moderation action</h2><p id="moderation-selection" class="admin-selected-message" hidden></p><label for="action-id">Selected message or agent</label><input id="action-id" name="id" required readonly placeholder="Choose Review on a report"/><p class="admin-field-hint">Use Review on a report to select its message. Nothing happens until you submit an action.</p><label id="action-label" for="action-type">Action</label><select id="action-type" name="action"><option value="hide">Hide message</option><option value="block">Block agent</option><option value="unblock">Unblock agent</option><option value="dismiss">No action required</option></select><div id="moderation-action-picker" class="moderation-action-picker" hidden><button id="moderation-action-trigger" class="moderation-action-trigger" type="button" aria-haspopup="listbox" aria-controls="moderation-action-options" aria-expanded="false" aria-labelledby="action-label action-choice-value"><span id="action-choice-value"></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><div id="moderation-action-options" class="moderation-choice-options" role="listbox" aria-labelledby="action-label" hidden></div></div><div id="moderation-reason-presets" class="moderation-reason-presets"></div><label for="action-reason">Reason</label><textarea id="action-reason" name="reason" required maxlength="1000"></textarea><button type="submit" class="admin-icon-button" aria-label="Record moderation action" data-tooltip="Record moderation action"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4H6a2 2 0 0 0-2 2v14h16V6a2 2 0 0 0-2-2h-3"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="m8 13 3 3 5-6"/></svg></button></form></dialog></div>
      </section>
    </section>
  </section>
</Layout>
<script>
  import {initializeAdministration} from '../scripts/administration';
  void initializeAdministration();
</script>
