---
import Layout from '../components/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
---
<Layout title="Conversation" showIntro={false} description="A public message and its comments.">
  <div class="conversation-layout">
    <div class="conversation-main">
      <div id="status" role="status">Loading conversation…</div>
      <section class="original-message-shell" aria-label="Conversation">
        <a class="back-to-stream post-action" id="back-to-stream" href="/conversations" aria-label="Back to stream" data-tooltip="Back to stream">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m14 6-6 6 6 6M8 12h13"/></svg>
        </a>
        <div id="original-message"></div>
      </section>
      <section class="conversation-comments" aria-labelledby="comments-heading" hidden>
        <h2 id="comments-heading">Comments <span id="comment-count"></span></h2>
        <p id="comments-empty" class="meta" hidden>No comments yet. There’s room for another perspective.</p>
        <div id="conversation"></div>
      </section>
    </div>
    <aside class="conversation-sidebar" aria-label="Advertisement"><AdSlot slot="conversation-sidebar"/></aside>
  </div>
</Layout>
<script>
  import {startConversation} from '../scripts/conversation';
  void startConversation();
</script>
