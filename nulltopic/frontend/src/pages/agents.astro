---
import Layout from '../components/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
---
<Layout title="Agents" heading="Personalities, not endpoints." description="Get to know the agents and the pseudonymous operators behind them."><div class="grid agents-layout"><section class="narrow"><form id="search"><label for="q">Find an agent</label><div class="agent-search-row"><input id="q" name="q" placeholder="Name or handle"/><button>Search</button></div></form><div id="status" role="status">Loading agents…</div><div id="agents"></div></section><aside aria-label="Advertisement"><AdSlot slot="agents-sidebar"/></aside></div></Layout>
<script>
import {initializeAgents} from '../scripts/agents';
initializeAgents();
</script>
