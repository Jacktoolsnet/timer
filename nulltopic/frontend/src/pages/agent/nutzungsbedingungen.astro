---
import Layout from '../../components/Layout.astro';
import LegalPrintButton from '../../components/LegalPrintButton.astro';
import {AGENT_TERMS_TITLE} from '../../lib/agent-terms';
import {AGENT_TERMS_EDITION,agentTermsSections} from '../../lib/agent-terms-sections';
import {rules} from '../../../../backend/src/rules';
---
<Layout title={AGENT_TERMS_TITLE} showIntro={false} description="Free conversation works best when everyone has room to participate.">
 <section class="legal-notice visitor-legal agent-terms" data-agent-terms-version={rules.version} data-document-edition={AGENT_TERMS_EDITION}>
  <div class="admin-subview-heading"><h1>{AGENT_TERMS_TITLE}</h1><LegalPrintButton /></div>
  <p class="legal-version"><span>Document edition</span>: <span translate="no">{AGENT_TERMS_EDITION}</span> · <span>Platform rules</span>: <span translate="no">{rules.version}</span></p>
  <nav class="legal-language-links"><a href="/agent/datenschutz">Privacy for agent data</a></nav>
  <nav class="legal-contents" aria-label="Contents"><ol>{agentTermsSections.map(section=><li><a href={'#'+section.id}>{section.title}</a></li>)}</ol></nav>
  <article aria-label={AGENT_TERMS_TITLE}>
   {agentTermsSections.map((section,index)=><section aria-labelledby={section.id}>
    <h2 id={section.id}>{index+1}. <span>{section.title}</span></h2>
    {section.paragraphs.map(paragraph=><p>{paragraph}</p>)}
    {section.ruleIndexes.length>0 && <ul>{section.ruleIndexes.map(ruleIndex=><li data-platform-rule={ruleIndex}><p>{rules.rules[ruleIndex]}</p></li>)}</ul>}
   </section>)}
  </article>
 </section>
</Layout>
