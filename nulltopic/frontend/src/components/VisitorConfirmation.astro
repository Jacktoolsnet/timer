<dialog id="visitor-confirmation" class="report-dialog visitor-confirmation" aria-labelledby="visitor-confirmation-title" aria-describedby="visitor-confirmation-description">
 <form id="visitor-confirmation-form">
  <div class="visitor-confirmation-symbol" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="M32 5 53 14v17c0 14-21 26-21 26S11 45 11 31V14L32 5Z"/><path d="m22 30 7 7 14-16"/></svg></div>
  <h2 id="visitor-confirmation-title" tabindex="-1">Welcome to NullTopic</h2>
  <p id="visitor-confirmation-description">To continue, confirm your age and accept the terms of use.</p>
  <div class="visitor-confirmation-choices storage-choice">
   <label for="visitor-age"><span class="storage-switch"><input id="visitor-age" type="checkbox" role="switch" required/><span class="storage-switch-track" aria-hidden="true"></span></span><span>I am at least 18 years old.</span></label>
   <label for="visitor-terms"><span class="storage-switch"><input id="visitor-terms" type="checkbox" role="switch" required/><span class="storage-switch-track" aria-hidden="true"></span></span><span>I accept the visitor terms of use.</span></label>
   <a data-visitor-terms href="/nutzungsbedingungen" target="_blank" rel="noopener noreferrer">Read the terms of use (new tab)</a>
  </div>
  <p class="visitor-privacy-information">Please also read our privacy notice and legal notice.</p>
  <div class="visitor-document-links">
   <a class="visitor-document-tile" data-visitor-privacy href="/datenschutz" target="_blank" rel="noopener noreferrer">
    <span class="visitor-document-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="m16 3 11 5v8c0 8-11 13-11 13S5 24 5 16V8l11-5Z"/><rect x="12" y="14" width="8" height="8" rx="2"/><path d="M13 14v-3a3 3 0 0 1 6 0v3m-3 3v2"/></svg></span>
    <span class="visitor-document-copy"><strong>Privacy</strong><span>How we handle personal data.</span><span class="sr-only">Opens in a new tab.</span></span>
    <svg class="visitor-document-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h11v11M19 5 5 19"/></svg>
   </a>
   <a class="visitor-document-tile" data-visitor-imprint href="/impressum" target="_blank" rel="noopener noreferrer">
    <span class="visitor-document-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M9 3h11l5 5v21H7V3h2Zm10 0v7h6M11 23h10"/><circle cx="16" cy="14" r="1"/><path d="M16 18v3"/></svg></span>
    <span class="visitor-document-copy"><strong>Legal notice</strong><span>Who operates NullTopic and how to contact us.</span><span class="sr-only">Opens in a new tab.</span></span>
    <svg class="visitor-document-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h11v11M19 5 5 19"/></svg>
   </a>
  </div>
  <p id="visitor-withdraw-error" role="alert" hidden></p>
  <div class="visitor-confirmation-actions">
   <button id="visitor-withdraw" class="admin-icon-button" type="button" hidden aria-label="Withdraw confirmation" data-tooltip="Withdraw confirmation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 8M4 4v6h6M9 9l6 6m0-6-6 6"/></svg></button>
   <button id="visitor-confirm" type="submit" class="admin-icon-button" disabled aria-label="Confirm and continue" data-tooltip="Confirm and continue"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button>
  </div>
 </form>
</dialog>
<script>import {initializeVisitorPreview} from '../scripts/visitor-preview';initializeVisitorPreview();</script>
