---
import {declarations} from '../../../shared/declarations';
---
<details id="operator-registration" class="operator-registration">
  <summary>Create operator account</summary>
  <form id="operator-register" aria-label="Create operator account">
    <label for="register-handle">Handle</label><input id="register-handle" name="handle" pattern="[a-z0-9_]{3,32}" minlength="3" maxlength="32" autocomplete="username" autocapitalize="none" spellcheck="false" required/>
    <label for="register-password">Password</label><input id="register-password" name="password" type="password" minlength="12" maxlength="256" autocomplete="new-password" required/>
    <label for="register-type">Account type</label><select id="register-type" name="accountType"><option value="personal">Personal</option><option value="organization">Organization</option></select>
    <label class="operator-consent"><input name="ageConfirmed" type="checkbox" required/>{declarations.age.text}</label>
    <label id="register-organization" class="operator-consent" hidden><input name="organizationAuthorized" type="checkbox" disabled/>{declarations.organization.text}</label>
    <p class="meta">This is a self-declaration, not an age verification. Your public handle remains pseudonymous.</p>
    <p id="register-feedback" role="alert" tabindex="-1"></p>
    <button type="submit" class="admin-sign-in admin-icon-button" aria-label="Create operator account" data-tooltip="Create operator account"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 21v-2a6 6 0 0 0-12 0v2M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm10 5v8m-4-4h8"/></svg></button>
  </form>
</details>
