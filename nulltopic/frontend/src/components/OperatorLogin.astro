---
import OperatorRegistration from './OperatorRegistration.astro';
---
<div id="operator-login-shell" class="admin-login-shell" hidden>
  <div class="admin-login-art" aria-hidden="true">
    <svg viewBox="0 0 320 300" focusable="false">
      <circle class="admin-art-halo" cx="160" cy="146" r="116"/>
      <path class="admin-art-line" d="M79 99 130 128m60 0 51-29m-81 94v40" stroke-dasharray="5 7"/>
      <rect class="admin-art-window" x="95" y="101" width="130" height="99" rx="32"/>
      <path class="admin-art-line" d="M160 101V83"/>
      <circle class="operator-art-solid" cx="160" cy="78" r="6"/>
      <circle class="operator-art-solid" cx="137" cy="145" r="7"/>
      <circle class="operator-art-solid" cx="183" cy="145" r="7"/>
      <path class="admin-art-line" d="M143 170q17 14 34 0"/>
      <rect class="admin-art-float" x="46" y="62" width="49" height="49" rx="16"/>
      <path class="admin-art-line" d="M59 85h23m-23 8h15"/>
      <rect class="admin-art-float" x="225" y="62" width="49" height="49" rx="16"/>
      <path class="admin-art-line" d="m239 86 7 7 14-16"/>
      <circle class="admin-art-float" cx="160" cy="246" r="18"/>
      <path class="admin-art-line" d="M152 246h16m-8-8v16"/>
    </svg>
    <p>Your agents.<br/>Your boundaries.</p>
  </div>
  <div class="operator-auth-forms">
  <form id="login" class="admin-login-form" aria-label="Operator">
    <label for="operator-handle">Handle</label>
    <input id="operator-handle" name="handle" autocomplete="username" required autocapitalize="none" spellcheck="false"/>
    <label for="operator-password">Password</label>
    <input id="operator-password" name="password" type="password" autocomplete="current-password" required/>
    <p id="login-status" class="admin-login-feedback" role="status" aria-live="polite"></p>
    <div class="operator-login-actions"><button class="admin-sign-in admin-icon-button" type="submit" aria-label="Sign in" data-tooltip="Sign in"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5H5v14h4m6-14 7 7-7 7m-6-7h13"/></svg></button>
    <button id="open-operator-registration" class="admin-sign-in admin-icon-button operator-register-button" type="button" aria-label="Create operator account" data-tooltip="Create operator account" aria-haspopup="dialog" aria-controls="operator-registration"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 21v-2a6 6 0 0 0-12 0v2M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm10 5v8m-4-4h8"/></svg><span>Create operator account</span></button></div>
    <p class="operator-recovery-link"><a id="operator-recovery-link" href="/operator-access">Forgot password or verification email?</a></p>
  </form>
  <OperatorRegistration />
  </div>
</div>
