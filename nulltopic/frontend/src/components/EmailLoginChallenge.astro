<section id="email-login-challenge" class="email-login-challenge" hidden aria-labelledby="email-login-heading">
<svg class="email-login-illustration" viewBox="0 0 120 100" aria-hidden="true"><rect class="admin-art-halo" x="4" y="4" width="112" height="92" rx="28"/><g class="admin-art-line"><rect x="20" y="25" width="80" height="52" rx="9"/><path d="m22 29 38 27 38-27m-76 43 23-22m53 22L75 50"/></g><path class="admin-art-shield" d="m88 55 16 7v12c0 10-16 18-16 18s-16-8-16-18V62l16-7Z"/><path class="admin-art-check" d="m81 73 5 5 9-11"/></svg>
<h2 id="email-login-heading">Check your email</h2>
<p class="meta">Enter the six-digit sign-in code. It expires after five minutes. Never share it.</p>
<label for="email-login-code">Sign-in code</label><input id="email-login-code" name="loginCode" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required disabled spellcheck="false"/>
<div class="email-login-actions"><button type="button" class="admin-icon-button" data-email-cancel aria-label="Back to sign in" data-tooltip="Back to sign in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h15"/></svg></button><button type="button" class="admin-icon-button" data-email-resend aria-label="Send a new code" data-tooltip="Send a new code"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11a9 9 0 1 1 2 7M3 4v7h7"/></svg></button><button type="button" class="admin-icon-button" data-email-verify aria-label="Confirm sign-in code" data-tooltip="Confirm sign-in code"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button></div>
<p class="meta">No email? Check spam, then request a new code. Only the latest code works.</p>
</section>
