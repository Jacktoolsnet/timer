---
import {ADS_PUBLISHER,ADS_SLOTS} from '../lib/advertising';
const {slot='sidebar'}=Astro.props;
const enabled=import.meta.env.PROD&&import.meta.env.PUBLIC_ADS_ENABLED==='true';
---
<div class="ad" data-ad-placement data-ad-slot={slot} data-ad-active="false" data-ad-enabled={String(enabled)} data-ad-state="blocked" data-ad-client={ADS_PUBLISHER} data-ad-vertical={ADS_SLOTS.vertical} data-ad-horizontal={ADS_SLOTS.horizontal} aria-label="Advertisement" aria-hidden="true"><span class="ad-label">Advertisement</span><div class="ad-unit"></div></div>
