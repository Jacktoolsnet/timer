---
// Deliberately inert until an audited certified CMP adapter is supplied.
// Configuration alone can never load third-party scripts in this prototype.
const {slot=import.meta.env.PUBLIC_ADS_SLOT_ID || 'sidebar'}=Astro.props;
const configured=import.meta.env.PUBLIC_ADS_ENABLED==='true' && !!import.meta.env.PUBLIC_ADS_PUBLISHER_ID && !!import.meta.env.PUBLIC_ADS_SLOT_ID;
const cmpReady=false; // Replace only with a reviewed Google-certified CMP adapter.
const active=import.meta.env.PROD && configured && cmpReady;
---
<div class="ad" data-ad-slot={slot} data-ad-active={String(active)} aria-label="Advertisement placeholder"><span>Advertisement</span>Optional space · ads disabled</div>
