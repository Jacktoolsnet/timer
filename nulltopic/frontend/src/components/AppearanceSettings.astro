---
import {palettes,styles} from '../lib/appearance';
const names:Record<string,string>={terracotta:'Terracotta',blue:'Blue',green:'Green',orange:'Warm orange',red:'Warm red',violet:'Violet',teal:'Teal',rose:'Rose',warm:'Warm',minimal:'Minimal',technical:'Technical',soft:'Soft'};
---
<details class="appearance-settings palette-dropdown" id="appearance-settings">
  <summary class="preferences-trigger" aria-label="Settings" title="Settings">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 3-.5 2-2 .9-1.8-.6-2 3.4 1.5 1.4v2.8L3.7 14l2 3.4 1.8-.6 2 .9.5 2.3h4l.5-2.3 2-.9 1.8.6 2-3.4-1.5-1.1v-2.8l1.5-1.4-2-3.4-1.8.6-2-.9L14 3Z"/><circle cx="12" cy="11.5" r="3"/></svg>
  </summary>
  <div class="palette-menu preferences-panel">
    <div class="preferences-heading"><h2>Settings</h2><button id="appearance-close" type="button" aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <section class="preferences-theme" aria-labelledby="appearance-heading">
      <h3 id="appearance-heading">Appearance</h3>
      <div class="theme-segments" role="group" aria-label="Appearance">
        <button type="button" data-theme-choice="auto" aria-pressed="true" title="Follow system appearance" aria-label="Auto – Follow system appearance"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v13H3zM8 21h8M12 17v4"/></svg>Auto</button>
        <button type="button" data-theme-choice="light" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>Light</button>
        <button type="button" data-theme-choice="dark" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.3A8.6 8.6 0 0 1 8.7 4 8.6 8.6 0 1 0 20 15.3Z"/></svg>Dark</button>
      </div>
    </section>
    <fieldset class="palette-grid">
      <legend>Colour palette</legend>
      {palettes.map(palette=><label class="palette-option" title={names[palette]}><input type="radio" name="appearance-palette" value={palette} aria-label={names[palette]} checked={palette==='terracotta'}/><span class="palette-chip"><span class="palette-swatch" data-color={palette} aria-hidden="true"></span></span></label>)}
    </fieldset>
    <fieldset class="style-picker">
      <legend>Style</legend>
      {styles.map(style=><label title={names[style]}><input type="radio" name="appearance-style" value={style} aria-label={names[style]} checked={style==='warm'}/><span data-style-preview={style}>
        {style==='warm'&&<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19h5m-2.5 0 5-14 5 14M15 19h5M10 13h6"/></svg>}
        {style==='minimal'&&<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 12h10M5 18h14"/></svg>}
        {style==='technical'&&<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 6-5 6 5 6m8-12 5 6-5 6M14 4l-4 16"/></svg>}
        {style==='soft'&&<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="7"/><path d="M8 9c0-1 1-2 2-2"/></svg>}
      </span></label>)}
    </fieldset>
    <div class="font-size-picker">
      <label for="appearance-font-size">Font size<output id="appearance-font-value" for="appearance-font-size">100 %</output></label>
      <input id="appearance-font-size" type="range" min="0" max="3" step="1" value="0" aria-valuetext="100 %"/>
      <div class="font-size-steps" aria-hidden="true"><span>100 %</span><span>110 %</span><span>120 %</span><span>130 %</span></div>
    </div>
    <div class="storage-choice motion-choice">
      <label><span class="storage-switch"><input id="background-motion" type="checkbox" role="switch" checked disabled aria-describedby="background-motion-status"/><span class="storage-switch-track" aria-hidden="true"></span></span><span>Background animation</span></label>
      <p id="background-motion-status" role="status">Requires JavaScript and canvas support.</p>
    </div>
    <div class="storage-choice"><label><span class="storage-switch"><input id="appearance-remember" type="checkbox" role="switch"/><span class="storage-switch-track" aria-hidden="true"></span></span><span>Remember settings on this device</span></label><p id="appearance-status" role="status"></p></div>
  </div>
</details>
<script>
import {initializeAppearanceSettings} from '../scripts/appearance';
initializeAppearanceSettings();
</script>
