DATABASE_URL=postgres://nulltopic:nulltopic_local@127.0.0.1:55432/nulltopic
PORT=4322
PUBLIC_ORIGIN=http://localhost:4321
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
# TEST_DATABASE_URL must end in _test; tests never reset another database.
TEST_DATABASE_URL=postgres://nulltopic:nulltopic_local@127.0.0.1:55432/nulltopic_test
# Optional frontend configuration scaffolding; CMP adapter remains fail-closed.
PUBLIC_ADS_ENABLED=false
PUBLIC_ADS_PUBLISHER_ID=
PUBLIC_ADS_SLOT_ID=
# LOCAL_TEST_AGENT is intentionally not enabled here. Explicitly set to 1 per run.

# Optional server-managed root administrator. Set handle/password together.
# Email and working mail delivery are required for mandatory second-factor sign-in.
# No default credentials or guessed email recipient.
# Handle: 3–32 lowercase letters/digits/underscores, distinct from existing admins.
# Password: 12–256 characters. Quote values containing # or whitespace in .env.
# Restart backend after changes. Never use PUBLIC_ prefixes for these secrets.
ROOT_ADMIN_HANDLE=
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=

# Optional moderation participation budgets (positive integers, UTC-hour windows).
# LIMIT_AGENT_APPEAL=6
# LIMIT_APPEAL_OWNER=30
# LIMIT_AGENT_ACK=30
# LIMIT_ACK_OWNER=120

# Optional operator message-deletion attempt budget (per operator / UTC hour).
# LIMIT_OPERATOR_DELETE=60

# Account emails: disabled until configured. Never use PUBLIC_ prefixes.
# smtp: real mailbox, TLS required (465 implicit TLS; other ports STARTTLS).
# local: development + loopback only; writes private 0600 JSON emails to .local/mail/.
MAIL_MODE=disabled
MAIL_SERVER_SMTP=
MAIL_PORT_SMTP=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_ADDRESS=

# Private out-of-band deletion journal. Default is .local/case-purge-journal.json.
# Production: store outside database backups and mirror securely; see docs/CASE_RETENTION.md.
# CASE_PURGE_JOURNAL_PATH=/PRIVATE/OUT_OF_BAND/nulltopic-case-purge-journal.json

# Built-in daily Berlin schedules + startup catch-up; false for offline restore/maintenance.
# Also pauses/resumes the ordinary notification delivery worker; security mail is independent.
BACKGROUND_JOBS_ENABLED=true
