---
import {toolSeo} from '../../../shared/seo';
import Layout from '../layouts/Layout.astro';
import {getDictionary, type Language} from '../lib/i18n';
import {stopwatchText} from '../lib/stopwatch-text';
interface Props {lang: Language}
const {lang}=Astro.props; const t=getDictionary(lang); const c=stopwatchText[lang];
const seo=toolSeo.stopwatch[lang];
---
<Layout lang={lang} title={seo.title} description={seo.description} route="">
<section class="intro"><p class="eyebrow">{c.heading} {c.headingAccent}</p><h1>{seo.heading}</h1><p class="intro-copy">{seo.description}</p></section>
<div id="stopwatch-app" data-text={JSON.stringify({...t,...c})}>
<section id="stopwatch-print" aria-label={c.laps}><h2 id="print-title">{c.laps}</h2><table id="print-laps"><thead></thead><tbody></tbody></table><div id="print-clock-sections"></div><div id="print-chart"></div></section>
<div class="workspace stopwatch-workspace"><section class="timer-card stopwatch-card">
<div class="card-top"><button id="stopwatch-focus" class="icon-text" aria-label={t.focusMode} aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg><span>{t.focusMode}</span></button></div>
<div class="stopwatch-main">
<div class="multi-toolbar">
<button id="print-stopwatch" class="secondary" aria-label={c.print} title={c.print}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9V3h12v6M6 17H3V9h18v8h-3M6 14h12v7H6Z"/><path d="M17 12h1"/></svg></button>
<button id="add-clock" class="secondary" aria-label={c.addClock} title={c.addClock}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10" cy="13" r="7"/><path d="M10 9v4l2 2M7 2h6M18 4h4m-2-2v4"/></svg></button>
<button id="start-all" class="secondary" aria-label={c.startAll} title={c.startAll} hidden><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m4 5 8 7-8 7Zm10 0 8 7-8 7Z"/></svg></button>
<button id="pause-all" class="secondary" aria-label={c.pauseAll} title={c.pauseAll} hidden><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5v14M9 5v14M15 5v14M20 5v14"/></svg></button>
<button id="reset-all" class="secondary" aria-label={c.resetAll} title={c.resetAll} hidden disabled><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 10a9 9 0 1 1 1 8M3 4v6h6M10 10v6m4-6v6"/></svg></button>
<button id="lap-all" class="secondary" aria-label={c.lapAll} title={c.lapAll} hidden disabled><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 21V3m0 1c4-3 6 3 10 0v9c-4 3-6-3-10 0M17 15h6m-3-3v6"/></svg></button>
<button id="show-all-laps" class="secondary" aria-label={c.showAllLaps} title={c.showAllLaps} aria-pressed="false" hidden><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5h12M9 10h12M9 15h12M3 5h1M3 10h1M3 15h1M5 20h16"/></svg></button>
</div>
<div id="clock-grid" class="clock-grid"><section id="primary-clock" class="clock-tile"><div id="clock-primary-heading" class="clock-heading"><input id="clock-primary-name" aria-label={c.clockName} value={c.clock+' 1'} maxlength="60"/><button id="delete-primary-clock" class="secondary delete-clock" aria-label={c.deleteClock} title={c.deleteClock} disabled><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7"/></svg></button></div>
<div id="stopwatch-display" data-view="analog">
<div id="analog-stopwatch">
<svg viewBox="0 0 320 320" aria-hidden="true" focusable="false">
<circle cx="160" cy="160" r="147" class="stopwatch-dial"/>
{Array.from({length:60},(_,i)=><line x1="160" y1={i%5===0?27:20} x2="160" y2="13" transform={'rotate('+i*6+' 160 160)'} class={i%5===0?'stopwatch-major':'stopwatch-minor'}/>)}
{Array.from({length:12},(_,i)=>{const n=i*5,a=i*Math.PI/6;return <text x={160+112*Math.sin(a)} y={160-112*Math.cos(a)} class="stopwatch-number">{n===0?60:n}</text>})}
<circle cx="160" cy="107" r="33" class="stopwatch-subdial"/>
{Array.from({length:12},(_,i)=><line x1="160" y1="79" x2="160" y2={i%3===0?'84':'82'} transform={'rotate('+i*30+' 160 107)'} class="stopwatch-minor"/>)}
<text x="160" y="94" class="stopwatch-subnumber">60</text><text x="177" y="107" class="stopwatch-subnumber">15</text><text x="160" y="124" class="stopwatch-subnumber">30</text><text x="143" y="107" class="stopwatch-subnumber">45</text>
<line id="stopwatch-minute-hand" x1="160" y1="112" x2="160" y2="85"/>
<circle cx="160" cy="107" r="3" class="stopwatch-hub"/>
<line id="stopwatch-second-hand" x1="160" y1="182" x2="160" y2="38"/><circle cx="160" cy="160" r="5" class="stopwatch-hub"/>
</svg><p class="dial-hint">{c.dialHint}</p></div>
<div id="elapsed" hidden class="stopwatch-time" role="timer" aria-label={c.total} aria-live="off">00:00:00.00</div></div>
<div class="focus-details stopwatch-focus-details"><div class="timer-controls">
<button id="reset-timing" class="secondary" aria-label={c.reset} title={c.reset} disabled><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 10a9 9 0 1 1 1 8M3 4v6h6"/></svg></button>
<button id="toggle-timing" class="primary" aria-label={c.start} title={c.start} disabled><span id="play-symbol"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m8 5 11 7-11 7Z" fill="currentColor" stroke="none"/></svg></span><span id="pause-symbol" hidden><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14M16 5v14" stroke-width="4"/></svg></span></button>
<button id="lap" class="secondary" aria-label={c.lap} title={c.lap} disabled><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 21V3m0 1c5-4 9 4 14 0v10c-5 4-9-4-14 0"/></svg></button>
<button id="primary-show-laps" class="secondary" aria-label={c.showLaps} title={c.showLaps}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6h12M9 12h12M9 18h12M3 6h1M3 12h1M3 18h1"/></svg></button>
</div>
</div></section><div id="extra-clocks"></div></div><p id="wake-status" class="timer-status" role="status"></p><p class="keyboard-hint">{c.hint}</p><noscript>{t.js}</noscript>
</div>
<section class="lap-panel stopwatch-laps" aria-labelledby="laps-title"><div class="laps-heading"><h2 id="laps-title">{c.laps}</h2><div class="laps-actions">
<div class="copy-menu-wrapper">
<button id="copy-laps" class="secondary" aria-haspopup="menu" aria-expanded="false" aria-controls="copy-menu" aria-label={c.copyLaps} title={c.copyLaps} disabled><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V3H3v13h5"/></svg></button>
<div id="copy-menu" class="clock-select-options copy-menu" role="menu" aria-label={c.copyFormat} hidden><button id="copy-plain" type="button" role="menuitem">{c.copyPlain}</button><button id="copy-formatted" type="button" role="menuitem">{c.copyFormatted}</button></div></div>
<button id="export-laps" class="secondary" aria-label={c.exportCsv} title={c.exportCsv} disabled><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg></button>
</div></div><div id="lap-navigation" class="lap-navigation" hidden><button id="previous-clock" class="secondary" aria-label={c.previousClock}>←</button><span id="selected-clock" role="status"></span><button id="next-clock" class="secondary" aria-label={c.nextClock}>→</button><button id="all-clocks" class="secondary" aria-pressed="false">{c.allClocks}</button></div><p id="empty-laps">{c.empty}</p><div class="lap-scroll"><table id="laps-table" hidden><caption class="sr-only">{c.laps}</caption><thead><tr><th id="lap-clock-heading" scope="col" hidden>{c.clock}</th><th scope="col">{c.lap}</th><th scope="col">{c.duration}</th><th scope="col">{c.total}</th></tr></thead><tbody id="laps-body"></tbody></table></div><p id="export-status" class="export-status" role="status"></p><p id="lap-status" role="status" class="sr-only"></p>
<div id="lap-insights" hidden>
<h3>{c.analysis}</h3>
<dl class="lap-stats">
<div><dt>{c.fastest}</dt><dd id="lap-fastest"></dd></div>
<div><dt>{c.slowest}</dt><dd id="lap-slowest"></dd></div>
<div><dt>{c.average}</dt><dd id="lap-average"></dd></div>
<div><dt>{c.previous}</dt><dd id="lap-difference"></dd></div>
</dl>
<figure class="lap-chart"><figcaption id="lap-chart-title">{c.chart}</figcaption>
<p class="lap-chart-legend"><span aria-hidden="true"></span>{c.average} · {c.seconds}</p>
<svg id="lap-chart" viewBox="0 0 480 230" role="img" aria-labelledby="lap-chart-title lap-chart-description"><desc id="lap-chart-description"></desc><g id="lap-chart-content"></g></svg>
</figure>
</div></section>
</section><aside class="settings-card stopwatch-options" aria-labelledby="options-title"><h2 id="options-title">{c.options}</h2>
<label class="stopwatch-view-choice" for="stopwatch-view">{c.view}<select id="stopwatch-view" name="view"><option value="digital">{c.digital}</option><option value="analog" selected>{c.analog}</option><option value="combined">{c.combined}</option></select></label>
<label class="toggle-row"><span><strong>{c.awake}</strong><small>{c.awakeHint}</small></span><input id="awake" type="checkbox" role="switch" /><span class="toggle" aria-hidden="true"></span></label>
</aside></div>
<p class="local-note">{c.note}</p><p class="privacy-promise">{t.privacyPromise}</p></div>
<section class="guide"><div class="guide-heading"><p class="eyebrow">THE JACKTOOLS.NET WAY</p><h2>{c.guide}</h2></div><div class="guide-grid">{c.steps.map(([title,body],i)=><article><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section class="faq"><h2>{t.faq}</h2><details><summary>{c.question}<span aria-hidden="true">+</span></summary><p>{c.answer}</p></details></section>
<dialog id="reset-dialog" class="reset-dialog" aria-labelledby="reset-title" aria-describedby="reset-description">
<div class="dialog-inner">
<div class="reset-dialog-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10a9 9 0 1 1 1 8M3 4v6h6"/></svg></div>
<h2 id="reset-title">{c.resetTitle}</h2><p id="reset-description">{c.resetBody}</p>
<form method="dialog" class="dialog-actions"><button id="reset-cancel" class="secondary" value="cancel" autofocus>{c.cancel}</button><button id="reset-confirm" class="primary" value="reset">{c.reset}</button></form>
</div></dialog>
<script src="../scripts/stopwatch.ts"></script>
</Layout>
