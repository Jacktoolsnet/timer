---
import Layout from '../../layouts/Layout.astro';
import {languages} from '../../lib/i18n';
import {editorDictionary} from '../../lib/editor-i18n';
import {aiGuide} from '../../lib/guide';
export function getStaticPaths(){return languages.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props,t=editorDictionary(lang);
const intro={de:'Kopiere die vollständige Anleitung für deinen KI-Agenten. Der englische Text erklärt SceneScript ohne Vorwissen: Struktur, Felder, Regeln und Beispiele in einer einzigen, auch offline nutzbaren Beschreibung. Die Typnotation ist eine Erklärung – die KI liefert weiterhin normales JSON.',en:'Copy the complete guide for your AI agent. The English text introduces SceneScript from scratch: structure, fields, rules and examples in one self-contained, offline-ready description. Type notation explains the format; the AI still outputs ordinary JSON.',es:'Copia la guía completa para tu agente IA. El texto en inglés explica SceneScript desde cero: estructura, campos, reglas y ejemplos en una sola descripción autónoma, utilizable sin conexión. La notación explica el formato; la IA genera JSON normal.',fr:'Copiez le guide complet pour votre agent IA. Le texte anglais explique SceneScript sans connaissances préalables : structure, champs, règles et exemples dans un seul document autonome utilisable hors ligne. La notation explique le format ; l’IA produit du JSON normal.'};
---
<Layout lang={lang} title={t.ai+' — SceneScript'} description={t.ai+' · JSON 1.0'} route="ai">
 <article class="legal-page ai-doc"><p class="eyebrow">SCENESCRIPT / FORMAT 1.0</p><h1>{t.ai}</h1><p>{intro[lang]}</p>
 <div class="compact-actions"><button id="copy-guide" class="primary" data-copied={t.copied}>{t.copy}</button><a href="/ai.txt">Plain text</a><a href="/schema.json">JSON Schema</a><a href="/example.scenescript.json" download>{t.load} · example</a><a href="/comic.scenescript.json" download>{t.comicExample}</a><a href="/panels.scenescript.json" download>{t.panelExample}</a><a href="/camera.scenescript.json" download>{t.cameraExample}</a></div><p id="guide-status" role="status"></p>
 <pre id="ai-guide">{aiGuide}</pre><p><a href={'/'+lang+'/'}>← SceneScript</a></p></article>
 <script>document.getElementById('copy-guide')?.addEventListener('click',async()=>{const guide=document.getElementById('ai-guide')!;try{await navigator.clipboard.writeText(guide.textContent||'');document.getElementById('guide-status')!.textContent=document.getElementById('copy-guide')!.dataset.copied||'Copied.';}catch{const selection=window.getSelection();const range=document.createRange();range.selectNodeContents(guide);selection?.removeAllRanges();selection?.addRange(range);document.getElementById('guide-status')!.textContent='Ctrl+C / Cmd+C';}});</script>
</Layout>
