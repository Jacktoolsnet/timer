---
import {stage3DWords} from '../lib/stage3d-i18n';
import type {Language} from '../lib/i18n';
interface Props{lang:Language}
const {lang}=Astro.props,w=stage3DWords[lang];
---
<dialog id="stage3d-dialog" aria-labelledby="stage3d-title" data-words={JSON.stringify(w)}>
 <header class="json-header"><div><h2 id="stage3d-title">{w.title}</h2><p>{w.intro}</p></div></header>
 <div class="dialog-inner">
  <p id="stage3d-status" role="status" aria-live="polite"></p>
  <div class="stage3d-grid">
   <section><label>{w.kind}<select id="stage3d-kind"><option value="character">{w.characters}</option><option value="stage">{w.stages}</option></select></label>
    <label>{w.resource}<select id="stage3d-resource"></select></label>
    <div class="stage3d-actions"><button id="stage3d-add" type="button">{w.add}</button><button id="stage3d-remove" type="button">{w.remove}</button></div>
    <div id="stage3d-fields"></div>
    <div class="stage3d-actions"><button id="stage3d-export" type="button">{w.export}</button><button id="stage3d-import" type="button">{w.import}</button></div>
    <select id="stage3d-import-mode" aria-label={w.import}><option value="copy">{w.copy}</option><option value="update">{w.update}</option></select>
    <input id="stage3d-file" type="file" accept=".json,application/json" hidden />
   </section>
   <section><h3 id="stage3d-scene"></h3><label>{w.stage}<select id="stage3d-stage"></select></label>
    <button id="stage3d-insert" type="button">{w.insert}</button>
    <label>{w.shot}<textarea id="stage3d-shot" rows="12" spellcheck="false" maxlength="32000" aria-describedby="stage3d-shot-hint"></textarea></label>
    <p id="stage3d-shot-hint" class="small-hint">{w.hint}</p>
    <div class="stage3d-actions"><label>{w.time}<input id="stage3d-time" type="number" min="0" step="0.1" value="1" /></label><button id="stage3d-preview-button" type="button">{w.preview}</button></div>
    <div id="stage3d-preview"></div>
   </section>
  </div>
  <button id="stage3d-demo" type="button">{w.demo}</button>
 </div>
 <footer class="json-footer stage3d-actions"><button id="stage3d-apply" class="primary" type="button">{w.save}</button><button id="stage3d-close" type="button">{w.close}</button></footer>
</dialog>
