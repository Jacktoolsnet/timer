---
import {aiWorkflowWords} from '../lib/ai-workflow-i18n';
import {editorDictionary} from '../lib/editor-i18n';
import type {Language} from '../lib/i18n';
interface Props{lang:Language}
const {lang}=Astro.props,t=editorDictionary(lang);
---
<dialog id="resources-dialog" aria-labelledby="resources-title" aria-describedby="resources-hint">
 <header class="json-header"><div><h2 id="resources-title">{t.resources}</h2><p id="resources-hint">{t.resourcesHint}</p></div></header>
 <div class="dialog-inner"><p id="resources-status" role="status" aria-live="polite"></p><div class="resources-galleries">
     <section class="media-gallery-tile" aria-labelledby="asset-heading">
     <div class="panel-heading"><h2 id="asset-heading">{t.assets}</h2><button id="gallery-import-image" class="gallery-import" type="button" title={t.importImage} aria-label={t.importImage}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></div>
     <p class="small-hint">{t.imageHint}</p>
     <div id="asset-list" tabindex="0" role="region" aria-labelledby="asset-heading"></div>
     </section>
     <section class="media-gallery-tile" aria-labelledby="video-heading">
     <div class="panel-heading"><h2 id="video-heading">{t.videos}</h2><button id="gallery-import-video" class="gallery-import" type="button" title={t.importVideo} aria-label={t.importVideo}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></div><p id="video-size" class="small-hint"></p><div id="video-list" tabindex="0" role="region" aria-labelledby="video-heading"></div><input id="replace-video-file" type="file" accept="video/*,.webm,.mp4" hidden /><input id="video-file" type="file" accept="video/*,.webm,.mp4" hidden />
     </section>
     <section class="media-gallery-tile" aria-labelledby="audio-heading"><div class="panel-heading"><h2 id="audio-heading">{t.audios}</h2><button id="gallery-import-audio" class="gallery-import" type="button" title={t.importAudio} aria-label={t.importAudio}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></div><p class="small-hint">{t.audioHint}</p><div class="compact-actions"><button id="ai-speech-open" type="button" title={aiWorkflowWords(lang).speech}>{aiWorkflowWords(lang).speech}</button><button id="export-speech-jobs" type="button">{t.exportSpeechJobs}</button><button id="import-speech-files" type="button">{t.importSpeechFiles}</button></div><p class="small-hint">{t.speechWorkflowHint}</p><div id="audio-list"></div><input id="speech-audio-files" type="file" accept="audio/*,.mp3,.wav,.ogg,.m4a,.aac,.flac,.webm" multiple hidden /><input id="audio-file" type="file" accept="audio/*,.mp3,.wav,.ogg,.m4a,.aac,.flac,.webm" hidden /></section>
     <input id="replace-image-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml,.svg" hidden /><input id="image-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml,.svg" hidden />
 </div></div>
 <footer class="json-footer"><button id="close-resources" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></footer>
</dialog>
