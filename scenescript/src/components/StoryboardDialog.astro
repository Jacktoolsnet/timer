---
import {aiWorkflowWords} from '../lib/ai-workflow-i18n';
import {storyboardWords} from '../lib/storyboard-i18n';
import type {Language} from '../lib/i18n';
interface Props{lang:Language}
const {lang}=Astro.props,t=storyboardWords(lang),ai=aiWorkflowWords(lang);
---
<dialog id="storyboard-dialog" aria-labelledby="storyboard-title" aria-describedby="storyboard-hint" data-words={JSON.stringify(t)}>
 <header class="json-header">
  <div class="board-header-intro"><h2 id="storyboard-title">{t.title}</h2><p id="storyboard-hint">{t.hint}</p></div>
  <div id="storyboard-toolbar" role="toolbar" aria-label={t.actions}>
   <button id="storyboard-guide" class="board-icon" type="button" title={t.guide} aria-label={t.guide}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C8 2 4 3 2 4v15c3-2 6-2 10 0 4-2 7-2 10 0V4c-3-1-6-2-10 1Zm0 0v14M5 7h3M5 11h3M16 7h3M16 11h3"/></svg></button>
   <button id="storyboard-feedback" class="board-icon" type="button" title={t.feedback} aria-label={t.feedback}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H5v16h14V5h-4M9 3h6v4H9Zm0 9h6m-6 4h6"/></svg></button>
   <button id="storyboard-download" class="board-icon" type="button" title={t.download} aria-label={t.download}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg></button>
   <span class="board-toolbar-divider" aria-hidden="true"></span>
   <button id="storyboard-file-open" class="board-icon" type="button" title={t.file} aria-label={t.file}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8V4h7l2 3h9v4M3 8h6l2 3h11l-3 9H3Z"/></svg></button>
   <button id="storyboard-ai-open" class="board-icon" type="button" title={ai.title} aria-label={ai.title} aria-haspopup="dialog" aria-controls="ai-workflow-dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 12-12 4 4L8 24M14 3v4m-2-2h4M4 4v4M2 6h4"/></svg></button>
   <button id="storyboard-json-open" class="board-icon" type="button" title={t.exchange} aria-label={t.exchange} aria-controls="storyboard-exchange" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H6v6l-3 3 3 3v6h2M16 3h2v6l3 3-3 3v6h-2M10 9l4 3-4 3"/></svg></button>
   <span class="board-toolbar-divider" aria-hidden="true"></span>
   <button id="storyboard-approve" class="board-icon" aria-pressed="false" type="button" title={t.approve} aria-label={t.approve} aria-describedby="storyboard-approve-hint"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></svg></button>

  </div>
 </header>
 <div class="dialog-inner">
  <p id="storyboard-approve-hint" class="sr-only">{t.approveHint}</p>
  <nav id="storyboard-tabs" role="tablist" aria-label={t.title}>{(['story','characters','objects','settings','shots'] as const).map(key=><button id={"storyboard-tab-"+key} type="button" role="tab" data-board-tab={key} aria-controls="storyboard-content" aria-selected={key==='story'?'true':'false'} tabindex={key==='story'?0:-1}>{key==='story'?t.project:t[key]}</button>)}</nav>
  <div id="storyboard-content" role="tabpanel" aria-labelledby="storyboard-tab-story" tabindex="0"></div>
  <input id="storyboard-file" type="file" accept=".storyboard,.json,application/json" hidden/>
  <p id="storyboard-status" role="status" aria-live="polite"></p><div id="storyboard-error-box" hidden><label for="storyboard-error">{t.error}</label><textarea id="storyboard-error" rows="3" readonly></textarea></div>
 </div>
 <footer class="json-footer"><button id="storyboard-close" class="board-icon" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button><button id="storyboard-save" class="board-icon" type="button" title={t.save} aria-label={t.save}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h13l4 4v14H3V3Zm3 0v6h10V3M7 21v-8h10v8"/></svg></button></footer>
</dialog>

<dialog id="storyboard-field-dialog" aria-labelledby="storyboard-field-heading" aria-describedby="storyboard-field-hint">
 <form id="storyboard-field-form">
  <header class="json-header"><h2 id="storyboard-field-heading"></h2><button id="storyboard-field-close" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
  <div class="dialog-inner"><p id="storyboard-field-hint">{t.editHint}</p><label id="storyboard-field-label" for="storyboard-field-text"></label>
   <textarea id="storyboard-field-text" rows="8"></textarea>
   <input id="storyboard-field-number" type="number" step="any" hidden/>
   <select id="storyboard-field-select" hidden></select>
   <div id="storyboard-field-choices" role="group" aria-labelledby="storyboard-field-label" hidden></div>
   <p id="storyboard-field-error" role="alert"></p>
  </div>
  <footer class="json-footer"><button id="storyboard-field-cancel" type="button">{t.cancel}</button><button id="storyboard-field-apply" type="submit">{t.apply}</button></footer>
 </form>
</dialog>

<dialog id="storyboard-exchange" aria-labelledby="storyboard-exchange-title" aria-describedby="storyboard-exchange-hint">
 <header class="json-header"><h2 id="storyboard-exchange-title">{t.exchange}</h2><button id="storyboard-exchange-close" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
 <div class="dialog-inner"><p id="storyboard-exchange-hint">{t.exchangeHint}</p><label for="storyboard-json">{t.json}</label><textarea id="storyboard-json" rows="8" spellcheck="false"></textarea>
  <div id="storyboard-exchange-error-box" hidden><label for="storyboard-exchange-error">{t.error}</label><textarea id="storyboard-exchange-error" rows="3" readonly></textarea></div>
 </div>
 <footer class="json-footer"><button id="storyboard-import" type="button" title={t.import} aria-label={t.import}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h12m-5-5 5 5-5 5M15 3h6v18h-6"/></svg></button></footer>
</dialog>


<dialog id="storyboard-replace-dialog" role="alertdialog" aria-labelledby="storyboard-replace-title" aria-describedby="storyboard-replace-message">
 <header class="json-header"><h2 id="storyboard-replace-title">{t.replaceTitle}</h2></header>
 <div class="dialog-inner">
  <div class="board-replace-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 10 18H2ZM12 9v5m0 3v1"/></svg></div>
  <p id="storyboard-replace-message">{t.replaceFileConfirm}</p>
 </div>
 <footer class="json-footer"><button id="storyboard-replace-cancel" type="button" autofocus>{t.cancel}</button><button id="storyboard-replace-apply" type="button">{t.replaceAction}</button></footer>
</dialog>

<dialog id="storyboard-delete-image-dialog" role="alertdialog" aria-labelledby="storyboard-delete-image-title" aria-describedby="storyboard-delete-image-hint">
 <header class="json-header"><h2 id="storyboard-delete-image-title">{t.deleteImageTitle}</h2></header>
 <div class="dialog-inner"><p id="storyboard-delete-image-name"></p><p id="storyboard-delete-image-hint">{t.deleteImageHint}</p></div>
 <footer class="json-footer"><button id="storyboard-delete-image-cancel" type="button" autofocus>{t.cancel}</button><button id="storyboard-delete-image-apply" type="button">{t.deleteImage}</button></footer>
</dialog>
