---
import Stage3DDialog from './Stage3DDialog.astro';
import ResourcesDialog from './ResourcesDialog.astro';
import ToolInformation from '../../../shared/ToolInformation.astro';
import Layout from '../layouts/Layout.astro';
import { editorDictionary } from '../lib/editor-i18n';
import type {Language} from '../lib/i18n';
interface Props {lang:Language}
const {lang}=Astro.props,t=editorDictionary(lang);
---
<Layout lang={lang} title={"SceneScript — " + t.heading} description={t.intro} route="">
 <section class="scene-intro"><h1>{t.heading}</h1><p>{t.intro}</p></section>
 <div id="editor" inert aria-busy="true" class="app-shell" data-words={JSON.stringify(t)}>
  <section class="small-screen-note" aria-labelledby="tablet-heading"><h2 id="tablet-heading">{t.tabletRequired}</h2><p>{t.tabletHint}</p><a href={'/'+lang+'/ai/'}>{t.ai} ↗</a></section>
  <input id="project-file" type="file" accept=".json,application/json" hidden />
  <p id="editor-status" role="status" aria-live="polite"></p>
  <div class="studio-grid">
   <section class="studio-panel project-panel" id="project-panel">
    <header class="project-heading">
     <h2>{t.project}</h2>
     <button id="toggle-project" type="button" title={t.collapseProject} aria-label={t.collapseProject} aria-expanded="true" aria-controls="project-toolbar project-content"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg></button>
    </header>
  <nav id="project-toolbar" class="editor-toolbar" aria-label={t.project}>
<button id="undo-project" type="button" title={t.undo} aria-label={t.undo}><svg viewBox="0 0 24 24"><path d="m8 4-5 5 5 5M3 9h10a7 7 0 0 1 0 14"/></svg></button><button id="redo-project" type="button" title={t.redo} aria-label={t.redo}><svg viewBox="0 0 24 24"><path d="m16 4 5 5-5 5M21 9h-10a7 7 0 0 0 0 14"/></svg></button>
   <button id="load-default-project" type="button" title={t.loadDefault} aria-label={t.loadDefault}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V3m0 1c4-4 8 4 14 0v10c-6 4-10-4-14 0"/></svg></button>
   <button id="new-project" type="button" title={t.new} aria-label={t.new}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
   <button id="load-project" type="button" title={t.importProject} aria-label={t.importProject}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h6l2 2h10v11H3ZM12 3v10m-4-4 4 4 4-4" /></svg></button>
   <button id="open-export" type="button" title={t.exportVideo} aria-label={t.exportVideo}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v12H3ZM12 8v13m-4-4 4 4 4-4" /></svg></button>
   <button id="save-project" type="button" title={t.save} aria-label={t.save}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h12l4 4v14H3V3ZM7 3v6h10V3M7 21v-8h10v8" /></svg></button>
   <button id="copy-project-json" type="button" title={t.copyProjectJson} aria-label={t.copyProjectJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13M12 11l-2 3 2 3m5-6 2 3-2 3" /></svg></button>
   <button id="open-json" type="button" title={t.json} aria-label={t.json}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H6v14h3m6-14h3v14h-3M10 9l-3 3 3 3m4-6 3 3-3 3" /></svg></button>
   <button id="project-music" type="button" title={t.projectMusic} aria-label={t.projectMusic}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l12-2v13M9 8l12-2"/><ellipse cx="6" cy="18" rx="3" ry="2"/><ellipse cx="18" cy="16" rx="3" ry="2"/></svg></button>
   <button id="import-video" type="button" title={t.importVideo} aria-label={t.importVideo}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h12v14H3ZM15 9l6-4v14l-6-4"/></svg></button>
   <button id="project-narration" type="button" title={t.projectNarration} aria-label={t.projectNarration}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6v12H9ZM5 11v3a7 7 0 0 0 14 0v-3M12 21v-3"/></svg></button>
   <button id="project-video" type="button" title={t.projectVideo} aria-label={t.projectVideo}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v16H3Zm7 4 6 4-6 4Z"/></svg></button>
   <button id="project-simulation" type="button" title={t.projectSimulation} aria-label={t.projectSimulation}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="6" r="2" /><circle cx="17" cy="5" r="3" /><circle cx="12" cy="16" r="4" /><path d="m3 16 2 2m14-4 2 2" /></svg></button>
   <button id="editor-fullscreen" type="button" title={t.appFullscreen} aria-label={t.appFullscreen} aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg></button>
   <a href={'/'+lang+'/ai/'} target="_blank" rel="noopener" title={t.ai} aria-label={t.ai}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C8 2 4 3 3 4v16c3-2 6-2 9 0 3-2 6-2 9 0V4c-3-2-6-2-9 1Zm0 0v15" /></svg></a>
  </nav>
    <div class="project-content" id="project-content">
    <div class="project-metadata">
<label>{t.title}<span class="project-copy-field"><input id="project-title" type="text" maxlength="200" /><button id="copy-project-title" type="button" title={t.copy+": "+t.title} aria-label={t.copy+": "+t.title}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button></span></label>
    <label>{t.format}<select id="project-format"><option value="landscape">{t.landscape}</option><option value="portrait">{t.portrait}</option><option value="square">{t.square}</option></select></label>
    <div class="project-metadata-wide"><label>{t.projectDescription}<span class="project-copy-field"><textarea id="project-description" rows="3" maxlength="5000"></textarea><button id="copy-project-description" type="button" title={t.copy+": "+t.projectDescription} aria-label={t.copy+": "+t.projectDescription}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button></span></label></div>
    <div class="project-metadata-wide"><label>{t.projectFirstComment}<span class="project-copy-field"><textarea id="project-firstComment" rows="3" maxlength="5000"></textarea><button id="copy-project-firstComment" type="button" title={t.copy+": "+t.projectFirstComment} aria-label={t.copy+": "+t.projectFirstComment}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button></span></label></div>
    <div class="project-metadata-wide"><label>{t.projectHashtags}<span class="project-copy-field"><input id="project-hashtags" type="text" maxlength="2000" placeholder="#SceneScript, #Video" /><button id="copy-project-hashtags" type="button" title={t.copy+": "+t.projectHashtags} aria-label={t.copy+": "+t.projectHashtags}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button></span></label></div>
    </div>

    <div class="project-assets">
     <section class="media-gallery-tile" aria-labelledby="thumbnail-heading">
      <div class="panel-heading"><h2 id="thumbnail-heading">{t.thumbnail}</h2><button id="import-thumbnail" class="gallery-import" type="button" title={t.importThumbnail} aria-label={t.importThumbnail}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></div>
      <p class="small-hint">{t.thumbnailHint}</p><div id="thumbnail-content"></div>
      <input id="thumbnail-file" type="file" accept="image/png,image/jpeg,image/webp" hidden />
     </section>
     <div class="resource-launchers">
      <button id="open-resources" type="button" aria-haspopup="dialog" aria-controls="resources-dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h6l2 2h10v11H3ZM3 7V4h7l2 3" /></svg><span>{t.resources}</span></button>
      <button id="open-stage3d" type="button" aria-haspopup="dialog" aria-controls="stage3d-dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 9 5v10l-9 5-9-5V7Zm0 10 9-5M12 12 3 7m9 5v10" /></svg><span>{t.resources3d}</span></button>
     </div>
    </div>
    </div>
   </section>
   <aside class="studio-panel scene-sidebar">
    <nav class="scene-toolbar" aria-label={t.scenes}>
     <button id="add-scene" type="button" title={t.addScene} aria-label={t.addScene}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
     <button id="rename-scene" type="button" title={t.rename} aria-label={t.rename}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 4 5 5M4 20l5-1L21 7l-5-5L4 14ZM3 22h18" /></svg></button><button id="duplicate-scene" type="button" title={t.duplicate} aria-label={t.duplicate}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button>
     <button id="scene-up" type="button" title={t.up} aria-label={t.up}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 14 7-7 7 7" /></svg></button>
     <button id="scene-down" type="button" title={t.down} aria-label={t.down}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 10 7 7 7-7" /></svg></button>
     <button id="delete-scene" type="button" title={t.remove} aria-label={t.remove}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></svg></button>
    </nav>
    <div class="scene-list-content"><h2>{t.scenes}</h2><ol id="scene-list"></ol></div>
   </aside>
   <div class="preview-rail"><section class="studio-preview studio-panel" aria-label={t.preview}>
    <div class="panel-heading"><h2>{t.preview}</h2></div>
    <div id="preview-slot"><div id="preview-content" class="preview-content">
    <div id="stage-frame"><div id="recording-frame" aria-hidden="true"></div><div id="stage"></div><div id="safe-overlay" hidden></div><div id="recording-start" hidden><button id="start-recording" type="button" aria-label={t.startRecording}><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M23 14 49 32 23 50Z" /></svg><span>{t.startRecording}</span></button></div><div id="countdown" hidden aria-live="assertive"></div></div>
    <div class="playback-controls"><div class="preview-transport"><button id="previous-scene" aria-label={t.previousScene} title={t.previousScene}><span aria-hidden="true">◀|</span><span class="control-label">{t.previousScene}</span></button><button id="play" class="primary" aria-label={t.play} title={t.play}><span aria-hidden="true">▶</span><span class="control-label">{t.play}</span></button><button id="next-scene" aria-label={t.nextScene} title={t.nextScene}><span aria-hidden="true">|▶</span><span class="control-label">{t.nextScene}</span></button></div><div class="preview-view-actions"><button id="focus" aria-label={t.focus} title={t.focus}><span aria-hidden="true">⛶</span><span class="control-label">{t.focus}</span></button><button id="open-stills" type="button" title={t.stillExport} aria-label={t.stillExport}><span aria-hidden="true">▧</span><span class="control-label">{t.stillExport}</span></button><button id="open-preview" type="button" aria-label={t.expandPreview} title={t.expandPreview}><span aria-hidden="true">⤢</span><span class="control-label">{t.expandPreview}</span></button></div></div>
    <label class="timeline-label"><span id="time-label">0.0 / 10.0 s</span><input id="timeline" aria-label={t.preview} type="range" min="0" max="10" step="0.01" value="0" /></label>
    <p id="wake-status" class="small-hint" role="status" aria-live="polite"></p>
    <label class="safe-toggle" title={t.safe}>
     <svg class="safe-toggle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /><rect x="7" y="7" width="10" height="10" rx="1" /></svg>
     <span class="safe-toggle-text">{t.safe}</span>
     <span class="safe-switch"><input id="safe-toggle" type="checkbox" role="switch" aria-label={t.safe} /><span class="safe-switch-track" aria-hidden="true"></span></span>
    </label>

    </div></div>
   </section>
   </div>
   <aside class="studio-panel scene-inspector"><h2>{t.sceneSettings}</h2><form id="scene-form"></form></aside>
    <section class="studio-panel elements-panel"><div class="element-toolbar"><details id="element-add-menu"><summary title={t.addElement} aria-label={t.addElement}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></summary><div class="element-add-options"><button type="button" data-add="text" title={t.text} aria-label={t.text}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M12 5v14M8 19h8" /></svg></button><button type="button" data-add="bubble" title={t.bubble} aria-label={t.bubble}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18v13H11l-5 5v-5H3Z"/><path d="M7 7h10M7 11h7"/></svg></button><button type="button" data-add="image" title={t.image} aria-label={t.image}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18v18H3ZM3 17l6-6 4 4 3-3 5 5M16 7h.01" /></svg></button><button type="button" data-add="video" title={t.video} aria-label={t.video}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h12v14H3ZM15 9l6-4v14l-6-4"/></svg></button><button type="button" data-add="shape" title={t.shape} aria-label={t.shape}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5Z" /></svg></button><button type="button" data-add="simulation" title={t.simulation} aria-label={t.simulation}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="6" r="2" /><circle cx="17" cy="5" r="3" /><circle cx="12" cy="16" r="4" /></svg></button></div></details><button id="open-panels" type="button" title={t.panels} aria-label={t.panels}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18v18H3ZM3 11h18M14 11v10"/></svg></button><button id="group-elements" type="button" title={t.group} aria-label={t.group}><svg viewBox="0 0 24 24"><path d="M3 3h18v18H3ZM6 6h5v5H6ZM13 13h5v5h-5Z"/></svg></button><button id="ungroup-elements" type="button" title={t.ungroup} aria-label={t.ungroup}><svg viewBox="0 0 24 24"><path d="M3 3h7v7H3ZM14 14h7v7h-7M14 3h7v7M3 14v7h7"/></svg></button><button id="rename-element" type="button" title={t.rename} aria-label={t.rename}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 4 5 5M4 20l5-1L21 7l-5-5L4 14ZM3 22h18" /></svg></button><button id="duplicate-element" type="button" title={t.duplicate} aria-label={t.duplicate}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button><button id="element-up" type="button" title={t.up} aria-label={t.up}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 14 6-6 6 6" /></svg></button><button id="element-down" type="button" title={t.down} aria-label={t.down}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 10 6 6 6-6" /></svg></button><button id="delete-element" type="button" title={t.remove} aria-label={t.remove}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></svg></button></div><div class="element-list-content"><h2>{t.elements}</h2><ol id="element-list"></ol></div></section>
   <aside class="studio-panel element-inspector"><h2 id="element-heading">{t.elementSettings}</h2><form id="element-form"></form></aside>
   <section class="studio-panel edit-timeline-panel"><header><h2>{t.editTimeline}</h2><label class="timeline-snap"><span>{t.snapTimeline}</span><span class="safe-switch"><input id="timeline-snap" type="checkbox" role="switch" checked/><span class="safe-switch-track" aria-hidden="true"></span></span></label></header><p class="small-hint">{t.timelineHint}</p><div id="edit-timeline" aria-label={t.editTimeline}></div></section>
  </div>
 </div>
 <dialog id="preview-dialog" aria-labelledby="preview-title">
  <header class="preview-dialog-heading"><div class="preview-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4m-2-13 5 3-5 3Z" /></svg></div><h2 id="preview-title">{t.preview}</h2></header>
  <div id="preview-overlay-host"></div>
  <footer class="preview-dialog-footer"><button id="close-preview" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></footer>
 </dialog>
 <dialog id="speech-report" aria-labelledby="speech-report-title"><header class="json-header"><h2 id="speech-report-title">{t.speechReport}</h2></header><div class="dialog-inner"><pre id="speech-report-text" style="white-space:pre-wrap;overflow-wrap:anywhere;user-select:text"></pre></div><footer class="json-footer"><div class="json-footer-actions"><button id="copy-speech-report" type="button">{t.copy}</button><button id="close-speech-report" type="button">{t.close}</button></div></footer></dialog>
 <dialog id="narration-dialog" aria-labelledby="narration-title"><header class="json-header"><div><h2 id="narration-title">{t.projectNarration}</h2><p>{t.narrationHint}</p></div></header><form id="narration-form" class="dialog-inner"></form><footer class="json-footer"><div class="json-footer-actions"><button type="submit" form="narration-form" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button><button id="close-narration" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></footer></dialog>
 <dialog id="music-dialog" aria-labelledby="music-title">
  <header class="json-header"><div><h2 id="music-title">{t.projectMusic}</h2><p>{t.musicHint}</p></div></header>
  <form id="music-form" class="music-body"></form>
  <footer class="json-footer"><button id="listen-music" type="button" title={t.listen} aria-label={t.listen}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 4 12 8-12 8Z"/></svg></button><div class="json-footer-actions"><button id="apply-music" type="submit" form="music-form" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button><button id="close-music" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></footer>
 </dialog>
 <dialog id="project-video-dialog" aria-labelledby="project-video-title"><header class="json-header"><div><h2 id="project-video-title">{t.projectVideo}</h2><p>{t.projectVideoHint}</p></div></header><form id="project-video-form" class="dialog-inner"></form><footer class="json-footer"><div class="json-footer-actions"><button type="submit" form="project-video-form" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button><button id="close-project-video" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></footer></dialog>
 <dialog id="video-preview-dialog" aria-labelledby="video-preview-title"><header class="json-header"><h2 id="video-preview-title">{t.video}</h2></header><div id="video-preview-host"></div><footer class="json-footer"><button id="close-video-preview" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></footer></dialog>
 <dialog id="simulation-dialog" aria-labelledby="simulation-title" aria-describedby="simulation-hint">
  <header class="json-header"><div class="json-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="5" cy="6" r="2" /><circle cx="17" cy="5" r="3" /><circle cx="12" cy="16" r="4" /></svg></div><div><h2 id="simulation-title">{t.projectSimulation}</h2><p id="simulation-hint">{t.simulationHint}</p></div></header>
  <div class="dialog-inner"><form id="project-simulation-form"></form></div>
  <footer class="json-footer rename-footer"><div class="json-footer-actions"><button id="apply-simulation" type="submit" form="project-simulation-form" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button><button id="close-simulation" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></div></footer>
 </dialog>
 <dialog id="camera-dialog" aria-labelledby="camera-title" aria-describedby="camera-hint"><header class="json-header"><div><h2 id="camera-title">{t.sceneCamera}</h2><p id="camera-hint">{t.cameraHint}</p></div></header><div class="dialog-inner"><div id="camera-options"/><div id="camera-preview" aria-label={t.cameraPreview}/><p id="camera-frame-hint" class="small-hint" hidden>{t.cameraFrameHint}</p><input id="camera-time" type="range" min="0" step="0.01" value="0" aria-label={t.cameraPreview}/><output id="camera-time-label"/><p id="camera-error" role="alert"/><form id="camera-form"/></div><footer class="json-footer"><div class="json-footer-actions"><button id="camera-add" type="button" title={t.cameraAdd} aria-label={t.cameraAdd}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg></button><button id="camera-play" type="button" title={t.play} aria-label={t.play}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 4 12 8-12 8Z"/></svg></button><button id="camera-reset" type="button" title={t.cameraReset} aria-label={t.cameraReset}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10a8 8 0 1 1 2 9M4 3v7h7"/></svg></button><button id="apply-camera" type="button" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button><button id="close-camera" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></footer></dialog>
 <dialog id="crop-dialog" aria-labelledby="crop-title" aria-describedby="crop-hint">
  <header class="json-header"><div><h2 id="crop-title">{t.editCrop}</h2><p id="crop-hint">{t.cropHint}</p></div></header>
  <div class="dialog-inner"><div id="crop-workspace"><img id="crop-source" alt=""/><div id="crop-rectangle"><button type="button" data-crop-corner="nw" aria-label={t.cropNW} title={t.cropNW}/><button type="button" data-crop-corner="ne" aria-label={t.cropNE} title={t.cropNE}/><button type="button" data-crop-corner="sw" aria-label={t.cropSW} title={t.cropSW}/><button type="button" data-crop-corner="se" aria-label={t.cropSE} title={t.cropSE}/></div></div><form id="crop-form"/></div>
  <footer class="json-footer"><div class="json-footer-actions"><button id="crop-reset" type="button" title={t.resetCrop} aria-label={t.resetCrop}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10a9 9 0 1 1 2 9M3 3v7h7"/></svg></button><button id="apply-crop" type="button" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button><button id="close-crop" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></footer>
 </dialog>
 <dialog id="panels-dialog" aria-labelledby="panels-title" aria-describedby="panels-hint"><header class="json-header"><div><h2 id="panels-title">{t.panels}</h2><p id="panels-hint">{t.panelHint}</p></div></header><div class="dialog-inner"><form id="panels-form"/><div id="panels-preview" aria-hidden="true"/></div><footer class="json-footer"><div class="json-footer-actions"><button id="apply-panels" type="button" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button><button id="close-panels" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></footer></dialog>
 <dialog id="asset-preview-dialog" aria-labelledby="asset-preview-title">
  <header class="preview-dialog-heading"><div class="preview-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 3h18v18H3ZM3 17l6-6 4 4 3-3 5 5M16 7h.01" /></svg></div><h2 id="asset-preview-title">{t.imagePreview}</h2></header>
  <div class="asset-preview-body"><img id="asset-preview-image" alt="" /></div>
  <footer class="json-footer rename-footer"><button id="close-asset-preview" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></footer>
 </dialog>
 <button id="exit-focus" hidden>{t.exit}</button>
 <dialog id="delete-dialog" role="alertdialog" aria-labelledby="delete-title" aria-describedby="delete-description delete-name"><div class="dialog-inner"><div class="delete-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></svg></div><h2 id="delete-title">{t.deleteTitle}</h2><p id="delete-name"></p><p id="delete-description"></p><div class="delete-actions"><button id="cancel-delete" type="button" autofocus>{t.cancel}</button><button id="confirm-delete" type="button">{t.remove}</button></div></div></dialog>
 <dialog id="rename-dialog" aria-labelledby="rename-title" aria-describedby="rename-hint">
  <header class="json-header"><div class="json-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 4 5 5M4 20l5-1L21 7l-5-5L4 14ZM3 22h18" /></svg></div><div><h2 id="rename-title">{t.rename}</h2><p id="rename-hint">{t.renameHint}</p></div></header>
  <form id="rename-form">
   <div class="dialog-inner"><label for="rename-input">{t.name}</label><input id="rename-input" type="text" maxlength="200" required autocomplete="off" /></div>
   <footer class="json-footer rename-footer"><div class="json-footer-actions">
    <button id="apply-rename" type="submit" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button>
    <button id="cancel-rename" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
   </div></footer>
  </form>
 </dialog>
 <dialog id="json-dialog" aria-labelledby="json-title" aria-describedby="json-hint">
  <header class="json-header">
   <div class="json-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 4H7v6l-2 2 2 2v6h2M15 4h2v6l2 2-2 2v6h-2" /></svg></div>
   <div><h2 id="json-title">{t.json}</h2><p id="json-hint">{t.jsonHint}</p></div>
  </header>
  <div class="dialog-inner"><textarea aria-label="JSON" id="json-input" spellcheck="false" rows="14"></textarea><div class="json-error-row"><p id="json-status" role="status"></p><button id="copy-json-error" type="button" title={t.copyError} aria-label={t.copyError} hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button></div><p id="json-copy-status" role="status"></p></div>
  <footer class="json-footer">
   <button id="paste-json" type="button" title={t.pasteClipboard} aria-label={t.pasteClipboard}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H5v16h14V5h-4M9 3h6v4H9ZM8 12h8m-8 4h6" /></svg></button>
   <div class="json-footer-actions">
    <button id="import-json" class="json-apply" type="button" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button>
    <button id="close-json" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
   </div>
  </footer>
 </dialog>
 <dialog id="stills-dialog" aria-labelledby="stills-title">
  <header class="json-header"><div><h2 id="stills-title">{t.stillExport}</h2><p>{t.stillHint}</p></div></header>
  <div class="dialog-inner">
   <div id="still-options">
    <label for="still-time">{t.stillTime}</label><div class="compact-actions"><input id="still-time" type="number" min="0" step="any" value="0" /><button id="still-current" type="button">{t.stillCurrent}</button></div>
    <button id="download-still" type="button">{t.stillDownload}</button>
    <fieldset><legend>{t.stillScenes}</legend><p class="small-hint">{t.stillContactHint}</p>
     <div class="compact-actions"><button id="still-all" type="button">{t.stillAll}</button><button id="still-none" type="button">{t.stillNone}</button></div>
     <div id="still-scenes"></div>
    </fieldset>
    <button id="download-contact" type="button">{t.stillContact}</button>
   </div>
   <progress id="still-progress" max="1" value="0" hidden></progress><p id="still-status" role="status" aria-live="polite"></p>
  </div>
  <footer class="json-footer"><button id="close-stills" type="button">{t.close}</button></footer>
 </dialog>
 <dialog id="export-dialog" aria-labelledby="export-title">
  <header class="json-header"><div><h2 id="export-title">{t.exportVideo}</h2><p id="export-setup-hint">{t.exportHint}</p></div></header>
  <div class="dialog-inner">
   <p id="export-status" role="status" aria-live="polite"></p>
   <div id="export-settings">
   <div id="export-options">
    <label>{t.format}<select id="export-format"><option value="mp4" selected>MP4</option><option value="webm">WebM</option></select></label>
    <label>{t.exportResolution}<select id="export-resolution"><option value="480">480p</option><option value="720">720p</option><option value="1080" selected>1080p</option></select></label>
    <label>{t.exportFps}<select id="export-fps"><option>24</option><option selected>30</option><option>60</option></select></label>
    <label class="export-destination-label">{t.exportDestination}<select id="export-destination"><option value="download">{t.exportTemporary}</option><option value="file">{t.exportDirect}</option></select></label>
    <label><span class="safe-switch"><input id="export-audio" type="checkbox" role="switch" checked /><span class="safe-switch-track" aria-hidden="true"></span></span>{t.exportAudio}</label>
   </div>
   <p id="export-storage-hint" class="small-hint"></p><button id="clear-export-files" type="button">{t.exportClearFiles}</button>
   </div>
   <p id="export-estimate" class="small-hint"></p>
   <div id="export-preview" hidden><canvas id="export-preview-canvas" role="img" aria-label={t.preview}></canvas></div>
   <div id="export-progress-row" hidden><progress id="export-progress" max="1" value="0" aria-label={t.exportVideo} aria-describedby="export-progress-label" hidden></progress><label id="export-progress-label" for="export-progress">0 %</label></div>
   <div id="export-timing" hidden aria-live="off"><dl><div><dt>{t.exportElapsed}</dt><dd id="export-elapsed">00:00</dd></div><div><dt>{t.exportRemaining}</dt><dd id="export-remaining">{t.exportEstimating}</dd></div></dl><p class="small-hint">{t.exportTimingHint}</p></div>
  </div>
  <footer class="json-footer"><div class="json-footer-actions">
   <button id="start-export" class="json-apply" type="button" title={t.exportVideo} aria-label={t.exportVideo}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button>
   <button id="cancel-export" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </div></footer>
 </dialog>
 <ResourcesDialog lang={lang} />
 <Stage3DDialog lang={lang} />
 <ToolInformation lang={lang} tool="scenescript" />
 <noscript><p class="notice">JavaScript is required for the SceneScript editor.</p></noscript>
 <script src="../scripts/editor-start.ts"></script>
</Layout>
