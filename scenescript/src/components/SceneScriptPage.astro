---
import Layout from '../layouts/Layout.astro';
import { editorDictionary } from '../lib/editor-i18n';
import type {Language} from '../lib/i18n';
interface Props {lang:Language}
const {lang}=Astro.props,t=editorDictionary(lang);
---
<Layout lang={lang} title={"SceneScript — " + t.heading} description={t.intro} route="">
 <section class="scene-intro"><h1>{t.heading}</h1><p>{t.intro}</p></section>
 <div id="editor" class="app-shell" data-words={JSON.stringify(t)}>
  <section class="small-screen-note" aria-labelledby="tablet-heading"><h2 id="tablet-heading">{t.tabletRequired}</h2><p>{t.tabletHint}</p><a href={'/'+lang+'/ai/'}>{t.ai} ↗</a></section>
  <input id="project-file" type="file" accept=".json,application/json" hidden />
  <p id="editor-status" role="status" aria-live="polite"></p>
  <div class="studio-grid">
   <section class="studio-panel project-panel">
  <nav class="editor-toolbar" aria-label={t.project}>
   <button id="new-project" type="button" title={t.new} aria-label={t.new}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
   <button id="load-project" type="button" title={t.importProject} aria-label={t.importProject}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h6l2 2h10v11H3ZM12 3v10m-4-4 4 4 4-4" /></svg></button>
   <button id="save-project" type="button" title={t.save} aria-label={t.save}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h12l4 4v14H3V3ZM7 3v6h10V3M7 21v-8h10v8" /></svg></button>
   <button id="open-json" type="button" title={t.json} aria-label={t.json}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H6v14h3m6-14h3v14h-3M10 9l-3 3 3 3m4-6 3 3-3 3" /></svg></button>
   <button id="import-image" type="button" title={t.importImage} aria-label={t.importImage}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h14v18H3ZM3 17l4-5 4 4 3-3 3 4M20 3v6m-3-3h6" /></svg></button>
   <button id="project-simulation" type="button" title={t.projectSimulation} aria-label={t.projectSimulation}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="6" r="2" /><circle cx="17" cy="5" r="3" /><circle cx="12" cy="16" r="4" /><path d="m3 16 2 2m14-4 2 2" /></svg></button>
   <button id="editor-fullscreen" type="button" title={t.appFullscreen} aria-label={t.appFullscreen} aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg></button>
   <a href={'/'+lang+'/ai/'} target="_blank" rel="noopener" title={t.ai} aria-label={t.ai}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C8 2 4 3 3 4v16c3-2 6-2 9 0 3-2 6-2 9 0V4c-3-2-6-2-9 1Zm0 0v15" /></svg></a>
  </nav>
    <div class="project-content">
    <h2>{t.project}</h2><label>{t.title}<input id="project-title" type="text" maxlength="200" /></label>
    <label>{t.format}<select id="project-format"><option value="landscape">{t.landscape}</option><option value="portrait">{t.portrait}</option><option value="square">{t.square}</option></select></label>

    <section class="project-assets">
     <div class="panel-heading"><h2 id="asset-heading">{t.assets}</h2></div>
     <p class="small-hint">{t.imageHint}</p>
     <div id="asset-list" tabindex="0" role="region" aria-labelledby="asset-heading"></div>
     <input id="image-file" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml,.svg" hidden />
    </section>
    </div>
   </section>
   <aside class="studio-panel scene-sidebar">
    <nav class="scene-toolbar" aria-label={t.scenes}>
     <button id="add-scene" type="button" title={t.addScene} aria-label={t.addScene}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
     <button id="rename-scene" type="button" title={t.rename} aria-label={t.rename}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 4 5 5M4 20l5-1L21 7l-5-5L4 14ZM3 22h18" /></svg></button><button id="duplicate-scene" type="button" title={t.duplicate} aria-label={t.duplicate}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button>
     <button id="scene-up" type="button" title={t.up} aria-label={t.up}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 14 7-7 7 7" /></svg></button>
     <button id="scene-down" type="button" title={t.down} aria-label={t.down}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 10 7 7 7-7" /></svg></button>
     <button id="delete-scene" type="button" title={t.remove} aria-label={t.remove}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></svg></button>
    </nav>
    <div class="scene-list-content"><h2>{t.scenes}</h2><ol id="scene-list"></ol></div>
   </aside>
   <section class="studio-preview studio-panel" aria-label={t.preview}>
    <div class="panel-heading"><h2>{t.preview}</h2></div>
    <div id="preview-slot"><div id="preview-content" class="preview-content">
    <div id="stage-frame"><div id="stage"></div><div id="safe-overlay" hidden></div><div id="recording-start" hidden><button id="start-recording" type="button" aria-label={t.startRecording}><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M23 14 49 32 23 50Z" /></svg><span>{t.startRecording}</span></button></div><div id="countdown" hidden aria-live="assertive"></div></div>
    <div class="playback-controls"><div class="preview-transport"><button id="previous-scene" aria-label={t.previousScene} title={t.previousScene}><span aria-hidden="true">◀|</span><span class="control-label">{t.previousScene}</span></button><button id="play" class="primary" aria-label={t.play} title={t.play}><span aria-hidden="true">▶</span><span class="control-label">{t.play}</span></button><button id="next-scene" aria-label={t.nextScene} title={t.nextScene}><span aria-hidden="true">|▶</span><span class="control-label">{t.nextScene}</span></button></div><div class="preview-view-actions"><button id="focus" aria-label={t.focus} title={t.focus}><span aria-hidden="true">⛶</span><span class="control-label">{t.focus}</span></button><button id="open-preview" type="button" aria-label={t.expandPreview} title={t.expandPreview}><span aria-hidden="true">⤢</span><span class="control-label">{t.expandPreview}</span></button></div></div>
    <label class="timeline-label"><span id="time-label">0.0 / 10.0 s</span><input id="timeline" aria-label={t.preview} type="range" min="0" max="10" step="0.01" value="0" /></label>
    <p id="wake-status" class="small-hint" role="status" aria-live="polite"></p>
    <label class="safe-toggle" title={t.safe}>
     <svg class="safe-toggle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /><rect x="7" y="7" width="10" height="10" rx="1" /></svg>
     <span class="safe-toggle-text">{t.safe}</span>
     <span class="safe-switch"><input id="safe-toggle" type="checkbox" role="switch" aria-label={t.safe} /><span class="safe-switch-track" aria-hidden="true"></span></span>
    </label>

    </div></div>
   </section>
   <aside class="studio-panel scene-inspector"><h2>{t.sceneSettings}</h2><form id="scene-form"></form></aside>
    <section class="studio-panel elements-panel"><div class="element-toolbar"><details id="element-add-menu"><summary title={t.addElement} aria-label={t.addElement}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></summary><div class="element-add-options"><button type="button" data-add="text" title={t.text} aria-label={t.text}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M12 5v14M8 19h8" /></svg></button><button type="button" data-add="image" title={t.image} aria-label={t.image}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18v18H3ZM3 17l6-6 4 4 3-3 5 5M16 7h.01" /></svg></button><button type="button" data-add="shape" title={t.shape} aria-label={t.shape}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5Z" /></svg></button><button type="button" data-add="simulation" title={t.simulation} aria-label={t.simulation}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="6" r="2" /><circle cx="17" cy="5" r="3" /><circle cx="12" cy="16" r="4" /></svg></button></div></details><button id="rename-element" type="button" title={t.rename} aria-label={t.rename}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 4 5 5M4 20l5-1L21 7l-5-5L4 14ZM3 22h18" /></svg></button><button id="duplicate-element" type="button" title={t.duplicate} aria-label={t.duplicate}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button><button id="element-up" type="button" title={t.up} aria-label={t.up}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 14 6-6 6 6" /></svg></button><button id="element-down" type="button" title={t.down} aria-label={t.down}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 10 6 6 6-6" /></svg></button><button id="delete-element" type="button" title={t.remove} aria-label={t.remove}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></svg></button></div><div class="element-list-content"><h2>{t.elements}</h2><ol id="element-list"></ol></div></section>
   <aside class="studio-panel element-inspector"><h2 id="element-heading">{t.elementSettings}</h2><form id="element-form"></form></aside>
  </div>
 </div>
 <dialog id="preview-dialog" aria-labelledby="preview-title">
  <header class="preview-dialog-heading"><div class="preview-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4m-2-13 5 3-5 3Z" /></svg></div><h2 id="preview-title">{t.preview}</h2></header>
  <div id="preview-overlay-host"></div>
  <footer class="preview-dialog-footer"><button id="close-preview" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></footer>
 </dialog>
 <dialog id="simulation-dialog" aria-labelledby="simulation-title" aria-describedby="simulation-hint">
  <header class="json-header"><div class="json-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="5" cy="6" r="2" /><circle cx="17" cy="5" r="3" /><circle cx="12" cy="16" r="4" /></svg></div><div><h2 id="simulation-title">{t.projectSimulation}</h2><p id="simulation-hint">{t.simulationHint}</p></div></header>
  <div class="dialog-inner"><form id="project-simulation-form"></form></div>
  <footer class="json-footer rename-footer"><div class="json-footer-actions"><button id="apply-simulation" type="submit" form="project-simulation-form" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button><button id="close-simulation" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></div></footer>
 </dialog>
 <dialog id="asset-preview-dialog" aria-labelledby="asset-preview-title">
  <header class="preview-dialog-heading"><div class="preview-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 3h18v18H3ZM3 17l6-6 4 4 3-3 5 5M16 7h.01" /></svg></div><h2 id="asset-preview-title">{t.imagePreview}</h2></header>
  <div class="asset-preview-body"><img id="asset-preview-image" alt="" /></div>
  <footer class="json-footer rename-footer"><button id="close-asset-preview" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></footer>
 </dialog>
 <button id="exit-focus" hidden>{t.exit}</button>
 <dialog id="delete-dialog" role="alertdialog" aria-labelledby="delete-title" aria-describedby="delete-description delete-name"><div class="dialog-inner"><div class="delete-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></svg></div><h2 id="delete-title">{t.deleteTitle}</h2><p id="delete-name"></p><p id="delete-description"></p><div class="delete-actions"><button id="cancel-delete" type="button" autofocus>{t.cancel}</button><button id="confirm-delete" type="button">{t.remove}</button></div></div></dialog>
 <dialog id="rename-dialog" aria-labelledby="rename-title" aria-describedby="rename-hint">
  <header class="json-header"><div class="json-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 4 5 5M4 20l5-1L21 7l-5-5L4 14ZM3 22h18" /></svg></div><div><h2 id="rename-title">{t.rename}</h2><p id="rename-hint">{t.renameHint}</p></div></header>
  <form id="rename-form">
   <div class="dialog-inner"><label for="rename-input">{t.name}</label><input id="rename-input" type="text" maxlength="200" required autocomplete="off" /></div>
   <footer class="json-footer rename-footer"><div class="json-footer-actions">
    <button id="apply-rename" type="submit" class="json-apply" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button>
    <button id="cancel-rename" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
   </div></footer>
  </form>
 </dialog>
 <dialog id="json-dialog" aria-labelledby="json-title" aria-describedby="json-hint">
  <header class="json-header">
   <div class="json-header-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 4H7v6l-2 2 2 2v6h2M15 4h2v6l2 2-2 2v6h-2" /></svg></div>
   <div><h2 id="json-title">{t.json}</h2><p id="json-hint">{t.jsonHint}</p></div>
  </header>
  <div class="dialog-inner"><textarea aria-label="JSON" id="json-input" spellcheck="false" rows="14"></textarea><div class="json-error-row"><p id="json-status" role="status"></p><button id="copy-json-error" type="button" title={t.copyError} aria-label={t.copyError} hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13" /></svg></button></div><p id="json-copy-status" role="status"></p></div>
  <footer class="json-footer">
   <button id="paste-json" type="button" title={t.pasteClipboard} aria-label={t.pasteClipboard}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H5v16h14V5h-4M9 3h6v4H9ZM8 12h8m-8 4h6" /></svg></button>
   <div class="json-footer-actions">
    <button id="import-json" class="json-apply" type="button" title={t.applyJson} aria-label={t.applyJson}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button>
    <button id="close-json" type="button" title={t.cancel} aria-label={t.cancel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
   </div>
  </footer>
 </dialog>
 <noscript><p class="notice">JavaScript is required for the SceneScript editor.</p></noscript>
 <script src="../scripts/editor.ts"></script>
</Layout>
