---
import {aiWorkflowLayoutWords} from '../lib/ai-workflow-layout-i18n';
import {aiModelWords} from '../lib/ai-model-i18n';
import {productionWords} from '../lib/production-i18n';
import {aiWorkflowWords} from '../lib/ai-workflow-i18n';
import type {Language} from '../lib/i18n';
interface Props{lang:Language}
const {lang}=Astro.props,pw=productionWords(lang),t=aiWorkflowWords(lang),m=aiModelWords(lang),l=aiWorkflowLayoutWords(lang);
---
<dialog id="ai-workflow-dialog" aria-labelledby="ai-workflow-title" data-words={JSON.stringify(t)} data-model-words={JSON.stringify(m)}>
 <header class="json-header"><h2 id="ai-workflow-title">{t.title}</h2></header>
 <div id="ai-workflow-matrix" aria-hidden="true" hidden></div>
 <div class="dialog-inner">
  <div id="ai-workflow-spinner" hidden><span class="ai-progress-spinner" aria-hidden="true"></span><span class="sr-only" role="status">{t.working}</span><div class="ai-elapsed"><span>{t.elapsed}</span><output id="ai-workflow-elapsed" role="timer" aria-live="off">00:00</output></div></div>
  <fieldset id="ai-workflow-settings">
   <section class="ai-flow-tile ai-flow-wide" data-ai-tile="task" aria-labelledby="ai-task-heading"><h3 id="ai-task-heading">{l.task}</h3>
   <p id="ai-workflow-draft" class="small-hint" hidden>{t.draftHint}</p>
   <label>{t.action}<select id="ai-workflow-action"><option value="board">{t.board}</option><option value="script">{t.script}</option><option value="image">{t.image}</option><option value="speech">{t.speech}</option></select></label>
   <div id="ai-workflow-model-recommendation"><p id="ai-workflow-model-advice"></p><button id="ai-workflow-use-recommendation" type="button" title={m.useRecommendation} aria-label={m.useRecommendation}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L20 5"/></svg></button></div>
   <div class="ai-model-row"><label>{m.choice}<select id="ai-workflow-model-choice"></select></label><button id="ai-workflow-model-load" type="button" title={m.load} aria-label={m.load}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg></button></div>
   <label id="ai-workflow-model-manual" hidden>{m.manual}<input id="ai-workflow-model" type="text" maxlength="150" value="gpt-5-mini" autocomplete="off" spellcheck="false"/></label>
   <p id="ai-workflow-model-status" role="status" aria-live="polite"></p><details class="ai-flow-details"><summary>{l.details}</summary><p class="small-hint">{m.hint}</p></details>
   </section>
   <section id="ai-workflow-text-options" class="ai-flow-tile" data-ai-tile="reasoning" aria-labelledby="ai-reasoning-heading"><h3 id="ai-reasoning-heading">{l.reasoning}</h3>
   <div class="ai-flow-fields">
   <div id="ai-workflow-reasoning-options"><label>{m.reasoning}<select id="ai-workflow-reasoning"></select></label></div>
   </div><details class="ai-flow-details"><summary>{l.details}</summary><p id="ai-workflow-reasoning-hint" class="small-hint"></p></details>
   </section>
   <section id="ai-workflow-image-options" class="ai-flow-tile" data-ai-tile="image" aria-labelledby="ai-image-heading" hidden><h3 id="ai-image-heading">{l.image}</h3>
    <label>{t.target}<select id="ai-workflow-target"></select></label>
    <label>{t.size}<input id="ai-workflow-size" type="text" readonly aria-describedby="ai-workflow-image-size-hint"/></label>
    <p id="ai-workflow-image-size-hint" class="small-hint">{t.imageSizeHint}</p>
    <label>{t.quality}<select id="ai-workflow-quality"><option value="low">{t.low}</option><option value="medium" selected>{t.medium}</option><option value="high">{t.high}</option></select></label>
    <label class="ai-check board-approval-switch"><input id="ai-workflow-image-refs" type="checkbox" role="switch" checked/><span class="board-switch-track" aria-hidden="true"></span><span>{t.imageRefs}</span></label>
    <p id="ai-workflow-image-reference-summary" class="small-hint"></p>
    <details class="ai-flow-details"><summary>{l.details}</summary><p class="small-hint">{t.imageHint}</p></details>
   </section>
   <section id="ai-workflow-speech-options" class="ai-flow-tile ai-flow-wide" data-ai-tile="speech" aria-labelledby="ai-speech-heading" hidden><h3 id="ai-speech-heading">{l.speech}</h3>
    <label>{t.job}<select id="ai-workflow-job"></select></label>
    <label>{t.voice}<input id="ai-workflow-voice" type="text" maxlength="100" list="ai-workflow-voices" autocomplete="off" spellcheck="false"/></label><datalist id="ai-workflow-voices"></datalist>
    <button id="ai-workflow-load-voices" type="button">{t.voices}</button>
    <details class="ai-flow-details"><summary>{l.details}</summary><p class="small-hint">{t.speechHint}</p></details><p id="ai-workflow-speech-estimate"></p><label>{t.speechText}<textarea id="ai-workflow-speech-text" rows="4" readonly></textarea></label>
   </section>
   <section id="ai-workflow-content-options" class="ai-flow-tile" data-ai-tile="content" aria-labelledby="ai-content-heading"><h3 id="ai-content-heading">{l.content}</h3>
   <label id="ai-workflow-prompt-label">{t.prompt}<textarea id="ai-workflow-prompt" rows="5" maxlength="10000"></textarea></label>
   <p id="ai-workflow-planning-image-hint" class="small-hint">{t.planningImageHint}</p>
   <label id="ai-workflow-refs-label" class="ai-check board-approval-switch"><input id="ai-workflow-refs" type="checkbox" role="switch"/><span class="board-switch-track" aria-hidden="true"></span><span>{t.refs}</span></label>
   </section>
   <section class="ai-flow-tile ai-flow-wide ai-flow-consent" data-ai-tile="consent" aria-labelledby="ai-consent-heading"><h3 id="ai-consent-heading">{l.consent}</h3>
   <p class="ai-disclosure">{t.risk}</p>
   <label class="ai-check board-approval-switch"><input id="ai-workflow-consent" type="checkbox" role="switch"/><span class="board-switch-track" aria-hidden="true"></span><span>{t.consent}</span></label>
   </section>
  </fieldset>
  <p id="ai-workflow-status" role="status" aria-live="polite"></p>
  <progress id="ai-workflow-progress" hidden></progress>
  <p id="ai-workflow-cancel-hint" hidden>{t.cancelHint}</p>
  <section id="ai-workflow-preview" class="ai-flow-tile" hidden><h3>{t.preview}</h3><p id="ai-workflow-summary"></p><img id="ai-workflow-image-preview" alt={t.preview} hidden/><section id="ai-workflow-production-check" hidden><h4>{pw.title}</h4><ul id="ai-workflow-production-issues"></ul><label id="ai-workflow-production-ack-label" class="ai-check board-approval-switch" hidden><input id="ai-workflow-production-ack" type="checkbox" role="switch"/><span class="board-switch-track" aria-hidden="true"></span><span>{pw.ack}</span></label></section><div id="ai-workflow-audios"></div><textarea id="ai-workflow-json-preview" rows="9" readonly spellcheck="false" aria-label={t.preview} hidden></textarea></section>
  <div id="ai-workflow-error-box" class="ai-flow-tile" role="alert" hidden><label for="ai-workflow-error">{t.error}</label><textarea id="ai-workflow-error" rows="3" readonly></textarea><span id="ai-workflow-copy-status" role="status" aria-live="polite"></span></div>
 </div>
 <footer class="json-footer">
  <button id="ai-workflow-copy-error" type="button" title={t.copyError} aria-label={t.copyError}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h13v13H8ZM3 16V3h13"/></svg></button>
  <button id="ai-workflow-close" type="button" title={t.close} aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
  <button id="ai-workflow-cancel" type="button" title={t.cancel+' — '+t.cancelHint} aria-label={t.cancel} hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5Z"/></svg></button>
  <button id="ai-workflow-start" type="button" title={t.start} aria-label={t.start}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 4 12 8-12 8Z"/></svg></button>
  <button id="ai-workflow-apply" type="button" title={t.apply} aria-label={t.apply} disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L20 5"/></svg></button>
 </footer>
</dialog>

<dialog id="ai-workflow-quick-confirm" role="alertdialog" aria-labelledby="ai-workflow-quick-title" aria-describedby="ai-workflow-quick-hint">
 <header><h2 id="ai-workflow-quick-title">{t.quickImageTitle}</h2></header>
 <div class="dialog-inner"><p id="ai-workflow-quick-summary"></p><p id="ai-workflow-quick-hint">{t.quickImageHint}</p></div>
 <footer><button id="ai-workflow-quick-cancel" type="button" title={t.close} aria-label={t.close} autofocus><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button><button id="ai-workflow-quick-start" type="button" title={t.start} aria-label={t.start}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L20 5"/></svg></button></footer>
</dialog>
