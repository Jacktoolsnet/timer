{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "format": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ]
    },
    "assets": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "data": {
            "type": "string",
            "maxLength": 11184912,
            "pattern": "^data:image/(png|jpeg|webp);base64,(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "name",
          "data"
        ]
      },
      "default": {}
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "default": "Scene"
          },
          "duration": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 3600,
            "default": 5
          },
          "background": {
            "type": "string",
            "maxLength": 7,
            "pattern": "^#[0-9a-fA-F]{6}$",
            "default": "#263b42"
          },
          "backgroundAsset": {
            "type": "string",
            "maxLength": 100,
            "default": ""
          },
          "transition": {
            "enum": [
              "none",
              "fade",
              "crossfade",
              "slide-left",
              "slide-right",
              "slide-up",
              "slide-down",
              "wipe-left",
              "wipe-right",
              "wipe-up",
              "wipe-down",
              "zoom-in",
              "zoom-out",
              "through-black"
            ],
            "default": "fade"
          },
          "transitionDuration": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 3600,
            "default": 0.5
          },
          "elements": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1,
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "type": {
                  "enum": [
                    "text",
                    "image",
                    "shape"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 10000
                },
                "asset": {
                  "type": "string",
                  "maxLength": 100,
                  "default": ""
                },
                "x": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100,
                  "default": 10
                },
                "y": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100,
                  "default": 35
                },
                "width": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 200,
                  "default": 80
                },
                "height": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 200,
                  "default": 30
                },
                "color": {
                  "type": "string",
                  "maxLength": 7,
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "font": {
                  "enum": [
                    "Arial",
                    "Georgia",
                    "Verdana",
                    "Courier New"
                  ],
                  "default": "Arial"
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 500,
                  "default": 90
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ],
                  "default": "center"
                },
                "bold": {
                  "type": "boolean",
                  "default": false
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 1
                },
                "rotation": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360,
                  "default": 0
                },
                "radius": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 0
                },
                "fit": {
                  "enum": [
                    "cover",
                    "contain"
                  ],
                  "default": "contain"
                },
                "animation": {
                  "enum": [
                    "none",
                    "fade",
                    "slide-left",
                    "slide-up",
                    "zoom",
                    "typewriter",
                    "pan"
                  ],
                  "default": "fade"
                },
                "at": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3600,
                  "default": 0
                },
                "animationDuration": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 3600,
                  "default": 1
                },
                "italic": {
                  "type": "boolean",
                  "default": false
                },
                "underline": {
                  "type": "boolean",
                  "default": false
                },
                "strikethrough": {
                  "type": "boolean",
                  "default": false
                },
                "runs": {
                  "type": "array",
                  "maxItems": 2000,
                  "default": [],
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 10000
                      },
                      "font": {
                        "enum": [
                          "Arial",
                          "Georgia",
                          "Verdana",
                          "Courier New"
                        ],
                        "default": "Arial"
                      },
                      "fontSize": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 500,
                        "default": 90
                      },
                      "color": {
                        "type": "string",
                        "maxLength": 7,
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "bold": {
                        "type": "boolean",
                        "default": false
                      },
                      "italic": {
                        "type": "boolean",
                        "default": false
                      },
                      "underline": {
                        "type": "boolean",
                        "default": false
                      },
                      "strikethrough": {
                        "type": "boolean",
                        "default": false
                      }
                    }
                  }
                },
                "name": {
                  "type": "string",
                  "maxLength": 200,
                  "default": "",
                  "description": "Optional display title; empty uses a content-based label."
                }
              },
              "required": [
                "id",
                "type"
              ]
            }
          }
        },
        "required": [
          "id",
          "elements"
        ]
      }
    }
  },
  "required": [
    "version",
    "title",
    "format",
    "scenes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenescript.jacktools.net/schema.json",
  "title": "SceneScript 1.0",
  "$comment": "Runtime validation additionally enforces unique IDs, resolved asset references, element.at <= scene.duration, total UTF-8 file size and image decoding / dimensions. Do not include $schema in project data."
}
