{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "format": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ]
    },
    "assets": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "data": {
            "type": "string",
            "maxLength": 11184912,
            "pattern": "^data:image/(png|jpeg|webp|svg\\+xml);base64,(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "description": "Raster images: max 8 MiB. UTF-8 SVG: max 1 MiB, restricted safe profile checked by runtime validator."
          }
        },
        "required": [
          "name",
          "data"
        ]
      },
      "default": {}
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "default": "Scene"
          },
          "duration": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 3600,
            "default": 5
          },
          "background": {
            "type": "string",
            "maxLength": 7,
            "pattern": "^#[0-9a-fA-F]{6}$",
            "default": "#263b42"
          },
          "backgroundAsset": {
            "type": "string",
            "maxLength": 100,
            "default": ""
          },
          "transition": {
            "enum": [
              "none",
              "fade",
              "crossfade",
              "slide-left",
              "slide-right",
              "slide-up",
              "slide-down",
              "wipe-left",
              "wipe-right",
              "wipe-up",
              "wipe-down",
              "zoom-in",
              "zoom-out",
              "through-black"
            ],
            "default": "fade"
          },
          "transitionDuration": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 3600,
            "default": 0.5
          },
          "elements": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1,
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "type": {
                  "enum": [
                    "text",
                    "image",
                    "shape",
                    "simulation"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 10000
                },
                "asset": {
                  "type": "string",
                  "maxLength": 100,
                  "default": ""
                },
                "x": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100,
                  "default": 10
                },
                "y": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100,
                  "default": 35
                },
                "width": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 200,
                  "default": 80
                },
                "height": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 200,
                  "default": 30
                },
                "color": {
                  "type": "string",
                  "maxLength": 7,
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "font": {
                  "enum": [
                    "Arial",
                    "Georgia",
                    "Verdana",
                    "Courier New"
                  ],
                  "default": "Arial"
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 500,
                  "default": 90
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ],
                  "default": "center"
                },
                "bold": {
                  "type": "boolean",
                  "default": false
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 1
                },
                "rotation": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360,
                  "default": 0
                },
                "radius": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 0
                },
                "fit": {
                  "enum": [
                    "cover",
                    "contain"
                  ],
                  "default": "contain"
                },
                "animation": {
                  "enum": [
                    "none",
                    "fade",
                    "slide-left",
                    "slide-up",
                    "zoom",
                    "typewriter",
                    "pan"
                  ],
                  "default": "fade"
                },
                "at": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3600,
                  "default": 0
                },
                "animationDuration": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 3600,
                  "default": 1
                },
                "italic": {
                  "type": "boolean",
                  "default": false
                },
                "underline": {
                  "type": "boolean",
                  "default": false
                },
                "strikethrough": {
                  "type": "boolean",
                  "default": false
                },
                "runs": {
                  "type": "array",
                  "maxItems": 2000,
                  "default": [],
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 10000
                      },
                      "font": {
                        "enum": [
                          "Arial",
                          "Georgia",
                          "Verdana",
                          "Courier New"
                        ],
                        "default": "Arial"
                      },
                      "fontSize": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 500,
                        "default": 90
                      },
                      "color": {
                        "type": "string",
                        "maxLength": 7,
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "bold": {
                        "type": "boolean",
                        "default": false
                      },
                      "italic": {
                        "type": "boolean",
                        "default": false
                      },
                      "underline": {
                        "type": "boolean",
                        "default": false
                      },
                      "strikethrough": {
                        "type": "boolean",
                        "default": false
                      }
                    }
                  }
                },
                "name": {
                  "type": "string",
                  "maxLength": 200,
                  "default": "",
                  "description": "Optional display title; empty uses a content-based label."
                },
                "fillColor": {
                  "type": "string",
                  "pattern": "^(none|#[0-9a-fA-F]{6})$",
                  "description": "Shape fill. Missing uses legacy color; none is transparent."
                },
                "borderColor": {
                  "type": "string",
                  "pattern": "^(none|#[0-9a-fA-F]{6})$",
                  "default": "none"
                },
                "borderWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 500,
                  "default": 4
                },
                "borderStyle": {
                  "type": "string",
                  "enum": [
                    "solid",
                    "dashed",
                    "dotted",
                    "double"
                  ],
                  "default": "solid"
                },
                "shapeType": {
                  "type": "string",
                  "enum": [
                    "rectangle",
                    "ellipse",
                    "triangle",
                    "diamond",
                    "star",
                    "arrow"
                  ],
                  "default": "rectangle"
                },
                "fillGradient": {
                  "$ref": "#/$defs/gradient"
                },
                "simulation": {
                  "$ref": "#/$defs/simulation"
                }
              },
              "required": [
                "id",
                "type"
              ]
            }
          },
          "backgroundGradient": {
            "$ref": "#/$defs/gradient"
          },
          "backgroundOpacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "elements"
        ]
      }
    },
    "backgroundSimulation": {
      "$ref": "#/$defs/simulation"
    }
  },
  "required": [
    "version",
    "title",
    "format",
    "scenes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenescript.jacktools.net/schema.json",
  "title": "SceneScript 1.0",
  "$comment": "Runtime validation additionally enforces unique IDs, resolved asset references, element.at <= scene.duration, total UTF-8 file size and image decoding / dimensions. Do not include $schema in project data.",
  "$defs": {
    "gradient": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "stops"
          ],
          "properties": {
            "type": {
              "enum": [
                "linear",
                "radial",
                "conic"
              ]
            },
            "angle": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "maxItems": 16,
              "description": "Ascending positions; equal positions create hard edges.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "position"
                ],
                "properties": {
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "position": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "simulation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "particles",
                "snow",
                "bubbles"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "speed": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            },
            "size": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        }
      ]
    }
  }
}
