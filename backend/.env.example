# Copy to .env locally; use server environment variables in production. Never commit secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4340
PUBLIC_BASE_URL=http://127.0.0.1:4340
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
# Production: https://backend.jacktools.net and https://jacktools.net; no wildcards.
TRUST_PROXY=0
SESSION_SECRET=replace-with-at-least-32-random-characters
ROOT_USERNAME=root
ROOT_PASSWORD=replace-with-a-unique-long-password
ROOT_EMAIL=
# Independent JackTools PostgreSQL database. Only DB_* / DATABASE_URL are supported.
# DATABASE_URL overrides host/port/name/user/password; DB_SSL still controls TLS.
DB_HOST=127.0.0.1
DB_PORT=55433
# Local Docker database: 55433; production database port is commonly 5432.
# LOCAL_DB_PORT=55433
DB_NAME=jacktools
DB_USER=jacktools
DB_PASSWORD=replace-with-your-database-password
DB_SSL=false
DB_POOL_MAX=10
DB_MAX_PENDING_REQUESTS=1000
DB_OVERLOAD_RETRY_AFTER_SECONDS=2
# Optional URL alternative (do not set both unless precedence is intended):
# DATABASE_URL=postgresql://jacktools:PASSWORD@127.0.0.1:55433/jacktools
# DB_SSL=true validates certificates; custom CA via NODE_EXTRA_CA_CERTS.
# Admin sessions: inactivity timeout and absolute maximum, in seconds.
SESSION_IDLE_SECONDS=3600
SESSION_MAX_SECONDS=43200
LOGIN_LIMIT=10

# Clock browser streaming (internal variable names remain TV_*).
# Enabled by default only in development. Production requires explicit opt-in.
# TV_ENABLED=true
# TV_ALLOWED_ORIGINS=https://clock.jacktools.net
# Separate, random encryption secret, >=32 characters; required when enabled in production.
# TV_STATE_SECRET=replace-with-a-separate-random-secret
# Dev default TV origins: localhost/127.0.0.1 on ports 4321 and 4322.

# Independent JackTools certificate monitoring.
CERT_MONITOR_ENABLED=false
CERT_MONITOR_SCHEDULER_ENABLED=true
CERT_MONITOR_CRON=40 0 * * *
CERT_MONITOR_TIMEZONE=Europe/Berlin
CERT_MONITOR_CHECK_ON_START=true
CERT_MONITOR_WARNING_DAYS=30
CERT_MONITOR_CRITICAL_DAYS=14
CERT_MONITOR_TIMEOUT_MS=8000
CERT_MONITOR_NOTIFY_RECOVERY=true
# Recipient is separate from sender; empty falls back to ROOT_EMAIL.
CERT_MONITOR_NOTIFY_EMAIL=
# Public HTTPS domains only. HTTPS PUBLIC_BASE_URL / ADMIN_ALLOWED_ORIGINS /
# TV_ALLOWED_ORIGINS are also included. Maximum 50 unique hosts/ports.
CERT_MONITOR_DOMAINS=Company|jacktools.net;Backend|backend.jacktools.net;Clock|clock.jacktools.net
# Additional lists: CERT_MONITOR_DOMAINS_2, CERT_MONITOR_DOMAINS_TOOLS, ...
# Optional UTF-8 list with the same syntax, maximum 64 KiB:
# CERT_MONITOR_DOMAINS_FILE=/absolute/path/certificate-domains.txt
# SMTP: create the mailbox first, then use actual provider credentials.
# MAIL_SERVER_SMTP=smtp.your-provider.example
# MAIL_PORT_SMTP=465
# MAIL_SECURE=true
# MAIL_USER=support@jacktools.net
# MAIL_PASSWORD=your-mailbox-password
# MAIL_FROM=support@jacktools.net
# For port 587: MAIL_SECURE=false; STARTTLS remains mandatory.
# Aliases: MAIL_SERVER_OUT / MAIL_HOST, MAIL_PORT, MAIL_ADDRESS.
# Invalid TLS certificates and plaintext SMTP are never permitted.
