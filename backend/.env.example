# Copy to .env locally; use server environment variables in production. Never commit secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4340
PUBLIC_BASE_URL=http://127.0.0.1:4340
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
# Production: https://backend.jacktools.net and https://jacktools.net; no wildcards.
TRUST_PROXY=0
SESSION_SECRET=replace-with-at-least-32-random-characters
ROOT_USERNAME=root
ROOT_PASSWORD=replace-with-a-unique-long-password
ROOT_EMAIL=
# Same variable names and precedence as MessageDrop ADMIN backend, but a SEPARATE database.
# ADMIN_* overrides DB_*. URL overrides host/port/name/user/password.
ADMIN_DB_HOST=127.0.0.1
ADMIN_DB_PORT=55433
# Local Docker database: 55433; production database port is commonly 5432.
# LOCAL_DB_PORT=55433
ADMIN_DB_NAME=jacktools
ADMIN_DB_USER=jacktools
ADMIN_DB_PASSWORD=replace-with-your-database-password
ADMIN_DB_SSL=false
ADMIN_DB_POOL_MAX=10
ADMIN_DB_MAX_PENDING_REQUESTS=1000
ADMIN_DB_OVERLOAD_RETRY_AFTER_SECONDS=2
# Optional URL alternative (do not set both unless precedence is intended):
# ADMIN_DATABASE_URL=postgresql://jacktools:PASSWORD@127.0.0.1:55433/jacktools
# Generic fallbacks: DATABASE_URL, DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD,
# DB_SSL, DB_POOL_MAX, DB_MAX_PENDING_REQUESTS, DB_OVERLOAD_RETRY_AFTER_SECONDS.
# DB_SSL=true validates certificates; custom CA via NODE_EXTRA_CA_CERTS.
SESSION_IDLE_SECONDS=3600
SESSION_MAX_SECONDS=43200
LOGIN_LIMIT=10

# TV: enabled by default only in development. Production requires explicit opt-in.
# TV_ENABLED=true
# TV_ALLOWED_ORIGINS=https://clock.jacktools.net
# Separate, random encryption secret, >=32 characters; required when enabled in production.
# TV_STATE_SECRET=replace-with-a-separate-random-secret
# Dev default TV origins: localhost/127.0.0.1 on ports 4321 and 4322.
