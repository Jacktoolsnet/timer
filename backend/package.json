{
  "name": "jacktools-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Node.js API for JackTools Company and tools",
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "migrate": "tsx src/cli.ts migrate",
    "root:reset": "tsx src/cli.ts root:reset",
    "test": "tsx --test test/unit.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "test:local": "node scripts/test-postgres.mjs",
    "db:start": "tsx src/local-dev.ts db:start",
    "db:stop": "tsx src/local-dev.ts db:stop",
    "db:status": "tsx src/local-dev.ts db:status",
    "db:logs": "tsx src/local-dev.ts db:logs",
    "migrate:local": "tsx src/local-dev.ts migrate:local",
    "dev:local": "tsx src/local-dev.ts dev:local",
    "root:reset:local": "tsx src/local-dev.ts root:reset:local"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
