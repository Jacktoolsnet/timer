---
import '../styles/global.css';
import '../styles/company.css';
import { colorSchemes } from '../lib/appearance';
import { getDictionary, type Language } from '../lib/i18n';
interface Props { lang: Language; title: string; description: string; route: string; noindex?: boolean; legal?: boolean }
const { lang, title, description, noindex = false, legal = false } = Astro.props;
const t = { ...getDictionary(lang),
  supportTitle: 'Kleine Tools. Gemeinsam möglich.',
  supportBody: 'Du magst unsere Projekte? Mit einem Kaffee kannst du unsere Arbeit unterstützen.',
  rememberHint: 'Optional: Farbe, Stil, Hell-/Dunkelmodus und Schriftgröße in diesem Browser für spätere Besuche speichern. Keine Übertragung an uns. Ausschalten oder lokale Einstellungen löschen entfernt die Daten. Ohne Auswahl gelten Änderungen nur auf der aktuellen Seite.',
  privacyBody: 'Diese Homepage verwendet keine Analyse- oder Trackingskripte. Dauerhaftes Speichern deiner Anzeigeeinstellungen ist optional und standardmäßig ausgeschaltet. Sie werden nicht an uns gesendet.',
  privacyNote: 'Hier kannst du die lokal gespeicherten Einstellungen dieser Homepage löschen. Die Einstellungen des Timers bleiben davon unberührt.',
};
const canonical = new URL(Astro.url.pathname, Astro.site);

---
<!doctype html>
<html lang={lang} data-palette="green" data-style="technical" data-font-size="0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e9eef3" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title} · Jacktools.net</title>
    <link rel="icon" type="image/png" sizes="96x96" href="/jacktools-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title + ' · Jacktools'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      try {
        const saved = JSON.parse(localStorage.getItem('jacktools.company.storage-consent.v1') === 'yes' ? localStorage.getItem('jacktools.company.appearance.v1') || 'null' : 'null');
        if (saved) {
          if (typeof saved.dark === 'boolean') document.documentElement.dataset.theme = saved.dark ? 'dark' : 'light';
          if (['terracotta', 'blue', 'green', 'orange', 'red', 'violet', 'teal', 'rose'].includes(saved.colorScheme)) document.documentElement.dataset.palette = saved.colorScheme;
          if (Number.isInteger(saved.fontSize) && saved.fontSize >= 0 && saved.fontSize <= 3) document.documentElement.dataset.fontSize = String(saved.fontSize);
          if (['warm', 'minimal', 'technical', 'soft'].includes(saved.style)) document.documentElement.dataset.style = saved.style;
        }
      } catch {}
    </script>
  </head>
  <body class:list={{ "legal-document": legal }}>
    <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt' : lang === 'es' ? 'Ir al contenido' : lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={'/'} aria-label="Jacktools Startseite">
          <span class="brand-icon"><img src="/jacktools-icon.png" width="40" height="40" alt="" /></span>
          <span class="brand-wordmark">jacktools<span class="brand-dot">.</span>net</span>
        </a>
        <div class="header-tools"><nav class="header-nav" aria-label="Hauptnavigation"><a href="/#tools">Tools</a><a href="/#idee">Unsere Idee</a></nav>
          <details class="palette-dropdown" id="palette-dropdown">
            <summary class="preferences-trigger" aria-label={t.menuSettings} title={t.menuSettings}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 3-.5 2-2 .9-1.8-.6-2 3.4 1.5 1.4v2.8L3.7 14l2 3.4 1.8-.6 2 .9.5 2.3h4l.5-2.3 2-.9 1.8.6 2-3.4-1.5-1.1v-2.8l1.5-1.4-2-3.4-1.8.6-2-.9L14 3Z"/><circle cx="12" cy="11.5" r="3"/></svg>
            </summary>
            <div class="palette-menu preferences-panel">
              <div class="preferences-heading"><h2>{t.menuSettings}</h2><button id="preferences-close" type="button" aria-label={t.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
              <section class="preferences-theme" aria-labelledby="appearance-heading">
                <h3 id="appearance-heading">{t.appearance}</h3>
                <div class="theme-segments" role="group" aria-label={t.appearance}>
                  <button type="button" id="theme-light" class="theme-light" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>{t.lightMode}</button>
                  <button type="button" id="theme" class="theme-dark" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.3A8.6 8.6 0 0 1 8.7 4 8.6 8.6 0 1 0 20 15.3Z"/></svg>{t.darkMode}</button>
                </div>
              </section>
            <fieldset class="palette-grid">
              <legend>{t.colorScheme}</legend>
              {colorSchemes.map(color => <label class="palette-option" title={t[color]}>
                <input type="radio" name="colorScheme" value={color} aria-label={t[color]} checked={color === 'green'} />
                <span class="palette-chip"><span class="palette-swatch" data-color={color} aria-hidden="true"></span></span>
              </label>)}
            </fieldset>
            <fieldset class="style-picker">
              <legend>{t.styleLabel}</legend>
              {(['warm', 'minimal', 'technical', 'soft'] as const).map(style => <label title={t[style]}>
                <input type="radio" name="visualStyle" aria-label={t[style]} value={style} checked={style === 'technical'} />
                <span data-style-preview={style}>
                  {style === 'warm' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19h5m-2.5 0 5-14 5 14M15 19h5M10 13h6"/></svg>}
                  {style === 'minimal' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 12h10M5 18h14"/></svg>}
                  {style === 'technical' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 6-5 6 5 6m8-12 5 6-5 6M14 4l-4 16"/></svg>}
                  {style === 'soft' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="7"/><path d="M8 9c0-1 1-2 2-2"/></svg>}
                </span>
              </label>)}
            </fieldset>
            <div class="font-size-picker">
              <label for="font-size">{t.fontSize}<output id="font-size-value" for="font-size">100 %</output></label>
              <input id="font-size" type="range" min="0" max="3" step="1" value="0" aria-valuetext="100 %" />
              <div class="font-size-steps" aria-hidden="true"><span>100 %</span><span>110 %</span><span>120 %</span><span>130 %</span></div>
            </div>
            <div class="storage-choice"><label><span class="storage-switch"><input type="checkbox" role="switch" id="remember-preferences" aria-describedby="remember-hint" /><span class="storage-switch-track" aria-hidden="true"></span></span> <span>{t.rememberPreferences}</span></label><p id="remember-hint">{t.rememberHint}</p><p id="storage-status" role="status"></p></div>
            </div>
          </details>

        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <section class="support-section" aria-labelledby="support-title">
          <div><h2 id="support-title">{t.supportTitle}</h2><p>{t.supportBody}</p></div>
          <div class="support-actions">
            <a class="support-coffee" href="https://buymeacoffee.com/jacktoolsnet" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"><span aria-hidden="true">☕</span>{t.supportCoffee}<span aria-hidden="true">↗</span></a>
          </div>
        </section>
        <div><a class="footer-brand" href={'/'}>jacktools.net</a><p>{t.footer}</p></div>
        <nav aria-label={t.legal}><a href="/impressum/">{t.legal}{!['de','en'].includes(lang) && ' (EN)'}</a><a href="/datenschutz/">{t.privacy}{!['de','en'].includes(lang) && ' (EN)'}</a><a href="/nutzungshinweise/">{t.usage}{!['de','en'].includes(lang) && ' (EN)'}</a><button id="privacy-open">{t.preferences}</button></nav>
        <p class="footer-credit">{t.creditBefore} ❤️ ☕ {t.creditAnd} 🍫 {t.creditAfter} <a href="https://jacktools.net" rel="noreferrer" referrerpolicy="no-referrer"><strong>jacktools.net</strong></a></p>
      </footer>
    </div>
    <dialog id="privacy-dialog" aria-labelledby="privacy-title">
      <div class="dialog-inner"><span class="eyebrow">JACKTOOLS.NET / PRIVACY</span><h2 id="privacy-title">{t.privacyTitle}</h2><p>{t.privacyBody}</p><p class="notice">{t.privacyNote}</p><p id="privacy-status" role="status"></p><div class="dialog-actions"><button class="secondary" id="clear-storage" data-message={t.cleared} data-error={t.storageError}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6" /></svg><span>{t.clear}</span></button><form method="dialog"><button class="primary">{t.close}</button></form></div></div>
    </dialog>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
