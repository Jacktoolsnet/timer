---
import BlogArticle from './BlogArticle.astro';
import {getBlogPost} from '../lib/blog';
import copy from '../lib/stream-blog.json';
import type {Language} from '../lib/i18n';
const {lang}=Astro.props as {lang:Language};
const c=copy[lang],post=getBlogPost(lang,'stream');
---
<BlogArticle post={post} chapters={c.sections.map(([id,title])=>[id,title])}>
 {c.sections.map(([id,title,text])=><section id={id}>
  <h2>{title}</h2><p>{text}</p>
 </section>)}
 <p><a href={'https://clock.jacktools.net/'+lang+'/'}>{c.action} ↗</a> · <a href={'/'+lang+'/tools/clock/#streamen'}>{c.guide}</a> · <a href={'https://clock.jacktools.net/'+lang+'/stream/'}>{c.receiver} ↗</a></p>
</BlogArticle>
