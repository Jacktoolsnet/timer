---
import MetronomePreview from './MetronomePreview.astro';
import RelaxPreview from './RelaxPreview.astro';
import Layout from '../layouts/Layout.astro';
import { companyTranslator, localizedToolUrl } from '../lib/company-copy';
import type { Language } from '../lib/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = companyTranslator(lang);
const rawSpotlights = [
 {id:'timer',name:'Timer',title:'Zeit für das Wesentliche.',lead:'Countdown, Pomodoro oder automatische Intervalle: Plane konzentrierte Arbeit, Pausen und eigene Routinen mit einem anpassbaren Online-Timer.',url:'https://timer.jacktools.net/de/',action:'Direkt zum Timer',caption:'Fokus und Pausen',value:'25:00',note:'Eine Sache nach der anderen.'},
 {id:'clock',name:'Uhr',title:'Deine Zeit. Auf einen Blick.',lead:'Analog, digital oder mit Klappzahlen: Gestalte deine Uhr so, wie sie zu deinem Alltag passt – mit Datum, Zeitzonen und Fokusansicht.',url:'https://clock.jacktools.net/de/',action:'Direkt zur Uhr',caption:'Uhrzeit und Datum',value:'10:24',note:'Deine Uhr. Dein Stil.'},
 {id:'stopwatch',name:'Online-Stoppuhr',title:'Jeder Moment zählt.',lead:'Behalte verstrichene Zeit und Runden im Blick. Eine übersichtliche Stoppuhr für deine kleinen und großen Vorhaben, direkt im Browser.',url:'https://stopwatch.jacktools.net/de/',action:'Direkt zur Stoppuhr',caption:'Zeit im Blick',value:'01:24.36',note:'Starten. Stoppen. Überblick behalten.'},
 {id:'breathe',name:'Breathe',title:'Ein Atemzug. Ein Moment für dich.',lead:'Nimm dir eine ruhige Pause. Breathe begleitet dich mit einstellbaren Atemmustern, einer sanften Kreisanimation und optionalen Atemgeräuschen – ohne Druck.',url:'https://breathe.jacktools.net/de/',action:'Direkt zu Breathe',caption:'Dein Atem. Dein Tempo.',value:'4',note:'Atme sanft und so, wie es angenehm ist.'},
 {id:'relax',name:'Relax',title:'Ruhige Klänge. Dein Moment.',lead:'Gestalte deine eigene Klanglandschaft: sanfte Instrumente, Sommerregen, Wind, Lagerfeuer und Meeresrauschen. Dazu ruhige Animationen – ganz nach deinem Geschmack.',url:'https://relax.jacktools.net/de/',action:'Direkt zu Relax',caption:'Klänge und sanfte Bewegung',value:'relax',note:'Zuhören. Zuschauen. Zur Ruhe kommen.'},
 {id:'message',name:'MessageDrop',title:'Die Welt hat etwas zu erzählen.',lead:'Hinterlasse Nachrichten an realen Orten auf einer globalen Karte und entdecke, was andere dort teilen. Raum für Nachrichten, Bilder und neue Perspektiven.',url:'https://app.messagedrop.de',action:'Direkt zu MessageDrop',caption:'Orte und Nachrichten',value:'MessageDrop',note:'Nachrichten, die ihren Platz finden.'},
 {id:'calculator',name:'Taschenrechner',title:'Jeder Rechenschritt bleibt nachvollziehbar.',lead:'Rechne mit einem editierbaren Rechenstreifen: Prozentwerte, Aufschläge und Steuern lassen sich Schritt für Schritt verfolgen, ändern und als Datei sichern.',url:'https://calculator.jacktools.net/de/',action:'Direkt zum Taschenrechner',caption:'Rechnen mit Überblick',value:'144,00',note:'Deine Zahlen. Dein Rechenweg.'},
 {id:'metronome',name:'Metronom',title:'Finde deinen Rhythmus.',lead:'Übe mit 20–300 BPM, Tap Tempo und eigenen Akzenten. Vier klare Animationen und ein Lückenmodus helfen dir, deinen Rhythmus zu finden und zu halten.',url:'https://metronome.jacktools.net/de/',action:'Direkt zum Metronom',caption:'Dein Rhythmus. Dein Tempo.',value:'90',note:'Höre den Schlag. Sieh den ganzen Takt.'},
];
const spotlights = rawSpotlights.map(tool => ({...tool,name:t(tool.name),title:t(tool.title),lead:t(tool.lead),action:t(tool.action),caption:t(tool.caption),note:t(tool.note),url:localizedToolUrl(tool.url,lang)}));
---
<Layout lang={lang} title={t("Online-Tools: Timer, Uhr & Entspannung")} description={t("Kostenlose Online-Tools ohne Anmeldung: Timer, Uhr, Stoppuhr, Metronom mit Tap Tempo und Taschenrechner sowie Atemübungen mit Breathe und Naturgeräusche mit Relax.")} route="">
  <script type="application/ld+json" set:html={JSON.stringify({
   '@context':'https://schema.org','@graph':[
    {'@type':'Organization','@id':'https://jacktools.net/#organization',name:'JackTools.Net',url:'https://jacktools.net/'},
    {'@type':'WebSite','@id':'https://jacktools.net/#website',name:'JackTools.Net',alternateName:'jacktools.net',url:'https://jacktools.net/',inLanguage:['de','en','es','fr'],publisher:{'@id':'https://jacktools.net/#organization'}},
    {'@type':'ItemList','@id':'https://jacktools.net/'+lang+'/#tools',name:t("Online-Tools für Zeit, Fokus und Entspannung"),itemListElement:[
     [t("Online-Timer"),localizedToolUrl('https://timer.jacktools.net/de/',lang)],[t("Online-Uhr mit Datum"),localizedToolUrl('https://clock.jacktools.net/de/',lang)],
     [t("Online-Stoppuhr mit Rundenzeiten"),localizedToolUrl('https://stopwatch.jacktools.net/de/',lang)],[t("Online-Taschenrechner mit Rechenstreifen"),localizedToolUrl('https://calculator.jacktools.net/de/',lang)],[t("Breathe – Atemübungen online"),localizedToolUrl('https://breathe.jacktools.net/de/',lang)],
     [t("Relax – Naturgeräusche und Klänge"),localizedToolUrl('https://relax.jacktools.net/de/',lang)],[t("Online-Metronom mit Tap Tempo"),localizedToolUrl('https://metronome.jacktools.net/de/',lang)],[t("MessageDrop – Nachrichten auf der Karte"),'https://app.messagedrop.de']
    ].map(([name,url],i)=>({'@type':'ListItem',position:i+1,name,url}))}
   ]
  })} />
  <section class="company-hero" id="company-spotlight" data-tool="timer">
    <div class="hero-copy"><p class="eyebrow">{t("KLEINE TOOLS. GROSSE IDEEN.")}</p><h1>{t("Online-Tools")}<br />{t("für deinen")} <em>{t("Alltag.")}</em></h1><p class="hero-slogan">{t("Weniger Ablenkung. Mehr Möglichkeiten.")}</p><p class="hero-lead">{t("Ein guter Helfer muss nicht kompliziert sein. Entdecke Tools für konzentrierte Momente, neue Routinen und Nachrichten, die ihren Platz in der Welt finden.")}</p><div class="hero-actions"><a class="primary" href="#tools">{t("Unsere Tools entdecken")} <span aria-hidden="true">↓</span></a><a class="text-link" href={localizedToolUrl("https://timer.jacktools.net/de/",lang)} rel="noreferrer">{t("Direkt zum Timer ↗")}</a></div><p class="hero-note">{t("Für deinen Browser gemacht. In deinem Stil gestaltet.")}</p></div>
    <div class="hero-art" aria-label={t("Illustration: Zeit für das Wesentliche")}><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><div class="art-label">{t("EIN MOMENT FÜR DICH")}</div><div class="preview-clock"><span>{t("FOKUS")}</span><strong>25:00</strong><span>{t("Eine Sache nach der anderen.")}</span></div><span class="floating-label label-focus">{t("◷ Zeit für Fokus")}</span><span class="floating-label label-message">{t("↗ Raum für Ideen")}</span><p class="art-footnote">{t("Weniger ist manchmal genau richtig.")}</p></div>
  </section>
  {spotlights.map(tool=><template data-spotlight={tool.id}>
    <div class="hero-copy"><p class="eyebrow">{t("IM SPOTLIGHT · ")}{tool.name.toUpperCase()}</p><h1>{t("Online-Tools")}<br />{t("für deinen")} <em>{t("Alltag.")}</em></h1><p class="hero-slogan">{tool.title}</p><p class="hero-lead">{tool.lead}</p><div class="hero-actions"><a class="primary" href="#tools">{t("Unsere Tools entdecken")} <span aria-hidden="true">↓</span></a><a class="text-link" href={tool.url} rel="noreferrer">{tool.action} ↗</a></div><p class="hero-note">{t("Für deinen Browser gemacht. In deinem Stil gestaltet.")}</p></div>
    <div class:list={['hero-art','spotlight-art','spotlight-'+tool.id]} role="img" aria-label={t("Statische Vorschau: ")+tool.name}>
      <span class="orbit orbit-one" aria-hidden="true"></span><span class="orbit orbit-two" aria-hidden="true"></span>
      <div class="art-label">{tool.caption}</div>
      {tool.id === 'metronome' ? <MetronomePreview lang={lang}/> : tool.id === 'relax' ? <RelaxPreview/> : tool.id === 'breathe' ? <div class="spotlight-breathe-scene" aria-hidden="true"><div class="company-breathe-scene"><svg viewBox="0 0 100 100" class="company-breathe-ring"><circle cx="50" cy="50" r="48"/><circle class="company-breathe-progress" cx="50" cy="50" r="48" pathLength="100"/></svg><div class="company-breathe-circle"></div><div class="company-breathe-tile"><span>{t("Einatmen")}</span><strong>4</strong></div></div></div> : tool.id === 'clock' ? <div class="spotlight-clock-scene" aria-hidden="true"><svg viewBox="0 0 240 240" class="company-clock-dial"><circle cx="120" cy="120" r="110"/>{Array.from({length:60},(_,i)=><path d={i%5===0?'M120 20v10':'M120 16v4'} transform={'rotate('+i*6+' 120 120)'} class={i%5===0?'spotlight-hour-mark':'spotlight-minute-mark'}/>)}{Array.from({length:12},(_,i)=>{const n=i+1,a=n*Math.PI/6;return <text x={120+80*Math.sin(a)} y={120-80*Math.cos(a)} class="spotlight-clock-number">{n}</text>})}<path class="company-hour-hand" d="M120 120 78 87"/><path class="company-minute-hand" d="M120 120 163 179"/><circle class="company-clock-hub" cx="120" cy="120" r="4"/></svg></div> : tool.id === 'calculator' ? <div class="company-calculation" aria-hidden="true"><span>{t("DEIN RECHENWEG")}</span><div><span>{t("Startwert")}</span><b>100,00</b></div><div><span>+ 20 %</span><b>120,00</b></div><div><span>+ 20 %</span><b>144,00</b></div><p>{t("Ergebnis")} <strong>144,00</strong></p></div> : tool.id === 'message' ? <div class="spotlight-message-scene" aria-hidden="true"><img src="/markers/message-marker.svg" width="64" height="80" alt=""/><strong>{t("MessageDrop")}</strong><span>{t("Ein Ort. Eine Nachricht.")}</span></div> : <div class="preview-clock" aria-hidden="true"><span>{tool.name}</span><strong>{tool.value}</strong><span>{tool.id === 'timer' ? t("Fokuszeit") : tool.id === 'clock' ? 'Deine Zeit. Dein Stil.' : t("Verstrichene Zeit")}</span></div>}
      <p class="art-footnote">{tool.note}</p>
    </div>
  </template>)}
  <script is:inline>
    (() => {
      const hero = document.getElementById('company-spotlight');
      const variants = Array.from(document.querySelectorAll('template[data-spotlight]'));
      function selectSpotlight() {
        if (!hero || !variants.length) return;
        const choice = variants[Math.floor(Math.random() * variants.length)];
        hero.replaceChildren(choice.content.cloneNode(true));
        hero.dataset.tool = choice.dataset.spotlight;
      }
      // Choose while parsing, before the hero is first painted. No persistent storage.
      selectSpotlight();
      window.addEventListener('pageshow', event => { if (event.persisted) selectSpotlight(); });
    })();
  </script>
  <section class="tools-section" id="tools" aria-labelledby="tools-heading"><div class="section-heading"><div><p class="eyebrow">{t("DIE JACKTOOLS.NET-FAMILIE")}</p><h2 id="tools-heading">{t("Online-Tools für Zeit, Fokus und Entspannung")}</h2></div><p>{t("Wähle den passenden Helfer – direkt im Browser, ohne Anmeldung.")}</p></div>
    <nav class="tool-shortcuts" aria-label={t("Toolübersicht")}><a href="#online-timer">{t("Timer")}</a><a href="#online-uhr">{t("Uhr")}</a><a href="#online-stoppuhr">{t("Stoppuhr")}</a><a href="#taschenrechner">{t("Taschenrechner")}</a><a href="#atemuebungen">{t("Atemübungen")}</a><a href="#naturgeraeusche">{t("Naturgeräusche")}</a><a href="#online-metronom">{t("Metronom")}</a><a href="#messagedrop">{t("MessageDrop")}</a></nav>
    <div class="product-grid time-tools-grid">
    <article id="online-timer" class="product-card timer-feature" aria-labelledby="timer-card-title"><div class="product-copy"><span class="product-tag">{t("ZEIT & FOKUS")}</span><h3 id="timer-card-title">{t("Online-Timer")}</h3><p>{t("Stelle einen Countdown ein, plane Fokuszeiten mit Pomodoro oder wiederhole Aktivphasen und Pausen mit dem Intervalltimer. Für Küche, Lernen und eigene Routinen.")}</p><ul class="feature-list"><li>{t("Countdown für kleine und große Vorhaben")}</li><li><a href={localizedToolUrl("https://timer.jacktools.net/de/pomodoro/",lang)}>{t("Pomodoro für Fokus und regelmäßige Pausen")}</a></li><li><a href={localizedToolUrl("https://timer.jacktools.net/de/training/",lang)}>{t("Intervalltimer für Aktivphasen und Pausen")}</a></li></ul><a class="primary tool-open" href={localizedToolUrl("https://timer.jacktools.net/de/",lang)} rel="noreferrer">{t("Countdown-Timer öffnen")} <span aria-hidden="true">↗</span></a><p class="product-note">{t("Kostenlos · ohne Benutzerkonto · direkt im Browser")}</p></div><div class="timer-preview" aria-label={t("Statische Vorschau des Timers")}><div class="preview-tabs"><span>{t("Countdown")}</span><span class="active">{t("Pomodoro")}</span><span>{t("Intervall")}</span></div><div class="small-clock"><span>{t("FOKUSZEIT")}</span><strong>25:00</strong><span>{t("Runde 1 von 4")}</span></div><p>{t("Deine Zeit. Dein Rhythmus.")}</p></div></article>
    <article id="online-uhr" class="product-card timer-feature clock-feature" aria-labelledby="clock-card-title">
      <div class="product-copy"><span class="product-tag">{t("UHRZEIT & DATUM")}</span><h3 id="clock-card-title">{t("Online-Uhr mit Datum")}</h3><p>{t("Zeige die Uhrzeit analog, digital oder mit Klappzahlen an. Wähle Datum, Zeitzone und Design – für Schreibtisch, Küche oder Unterricht.")}</p><ul class="feature-list"><li>{t("Analog, digital oder mit animierten Klappzahlen")}</li><li>{t("Kalenderblatt und weitere Datumsansichten")}</li><li>{t("Zeitzonen, Fokusansicht und optionales Bildschirm-Wachhalten")}</li></ul><a class="primary tool-open" href={localizedToolUrl("https://clock.jacktools.net/de/",lang)} rel="noreferrer">{t("Online-Uhr öffnen")} <span aria-hidden="true">↗</span></a><p class="product-note">{t("Kostenlos · ohne Benutzerkonto · direkt im Browser")}</p></div>
      <div class="timer-preview clock-preview" role="img" aria-label={t("Statische Vorschau der Uhr: analoges Zifferblatt und Kalenderblatt")}>
        <div class="preview-tabs" aria-hidden="true"><span class="active">{t("Analog")}</span><span>{t("Digital")}</span><span>{t("Klappzahlen")}</span></div>
        <div class="company-clock-scene" aria-hidden="true"><svg viewBox="0 0 240 240" class="company-clock-dial"><circle cx="120" cy="120" r="110"/>{Array.from({length:12},(_,i)=><path d="M120 20v8" transform={'rotate('+i*30+' 120 120)'}/>)}<path class="company-hour-hand" d="M120 120 84 96"/><path class="company-minute-hand" d="M120 120 165 60"/><circle class="company-clock-hub" cx="120" cy="120" r="4"/></svg><div class="company-calendar"><span>{t("OKTOBER")}</span><strong>05</strong><small>{t("Montag · 2026")}</small></div></div>
        <p>{t("Deine Uhr. Dein Stil.")}</p>
      </div>
    </article>
    <article id="online-stoppuhr" class="product-card timer-feature stopwatch-feature" aria-labelledby="stopwatch-card-title">
      <div class="product-copy"><span class="product-tag">{t("ZEITMESSUNG & RUNDEN")}</span><h3 id="stopwatch-card-title">{t("Online-Stoppuhr mit Rundenzeiten")}</h3><p>{t("Miss verstrichene Zeit, halte einzelne Runden fest und vergleiche Runden- und Gesamtzeiten. Für Übungen, Lernaufgaben oder kleine Experimente.")}</p><ul class="feature-list"><li>{t("Starten, pausieren und ohne Zeitverlust fortsetzen")}</li><li>{t("Rundenzeiten kopieren oder als CSV exportieren")}</li><li>{t("Analoge, digitale oder kombinierte Anzeige und Fokusansicht")}</li></ul><a class="primary tool-open" href={localizedToolUrl("https://stopwatch.jacktools.net/de/",lang)} rel="noreferrer">{t("Stoppuhr öffnen")} <span aria-hidden="true">↗</span></a><p class="product-note">{t("Kostenlos · ohne Benutzerkonto · direkt im Browser")}</p></div>
      <div class="timer-preview stopwatch-preview" role="img" aria-label={t("Statische Vorschau der Stoppuhr mit Zeitmessung und zwei Rundenzeiten")}><div class="preview-tabs" aria-hidden="true"><span class="active">{t("Stoppuhr")}</span><span>{t("Runden")}</span><span>{t("CSV-Export")}</span></div><div class="small-clock" aria-hidden="true"><span>{t("VERSTRICHENE ZEIT")}</span><strong>01:24<span class="preview-hundredths">.36</span></strong><span>{t("Runde 2")}</span></div><div class="preview-laps" aria-hidden="true"><span>{t("Runde 1")} <b>00:42.18</b></span><span>{t("Runde 2")} <b>00:42.18</b></span></div></div>
    </article>
    <article id="taschenrechner" class="product-card timer-feature calculator-feature" aria-labelledby="calculator-card-title">
      <div class="product-copy"><span class="product-tag">{t("RECHNEN & NACHVOLLZIEHEN")}</span><h3 id="calculator-card-title">{t("Online-Taschenrechner mit Rechenstreifen")}</h3><p>{t("Behalte deinen Rechenweg im Blick. Jeder Schritt nutzt das vorherige Ergebnis und lässt sich benennen, bearbeiten, verschieben oder deaktivieren.")}</p><ul class="feature-list"><li>{t("Prozentwerte, Aufschläge und Steuern berechnen")}</li><li>{t("Rechenschritte ändern und Ergebnisse neu berechnen lassen")}</li><li>{t("Berechnungen als Datei speichern, wieder öffnen oder drucken")}</li></ul><a class="primary tool-open" href={localizedToolUrl("https://calculator.jacktools.net/de/",lang)} rel="noreferrer">{t("Taschenrechner öffnen")} <span aria-hidden="true">↗</span></a><p class="product-note">{t("Kostenlos · ohne Benutzerkonto · direkt im Browser")}</p></div>
      <div class="timer-preview calculator-preview" role="img" aria-label={t("Statische Vorschau eines Rechenstreifens: 100 plus 20 Prozent ergibt 120, anschließend plus 20 Prozent ergibt 144")}><div class="preview-tabs" aria-hidden="true"><span class="active">{t("Rechenstreifen")}</span><span>{t("Prozent")}</span><span>{t("Drucken")}</span></div><div class="company-calculation" aria-hidden="true"><span>{t("DEIN RECHENWEG")}</span><div><span>{t("Startwert")}</span><b>100,00</b></div><div><span>+ 20 %</span><b>120,00</b></div><div><span>+ 20 %</span><b>144,00</b></div><p>{t("Ergebnis")} <strong>144,00</strong></p></div><p>{t("Schritt für Schritt. Klar und nachvollziehbar.")}</p></div>
    </article>
    <article id="atemuebungen" class="product-card timer-feature breathe-feature" aria-labelledby="breathe-card-title">
      <div class="product-copy"><span class="product-tag">{t("ATEM & RUHE")}</span><h3 id="breathe-card-title">{t("Breathe – Atemübungen online")}</h3><p>{t("Breathe begleitet deine ruhige Pause mit einem sanften Atemrhythmus. Folge dem wachsenden und schrumpfenden Kreis – in deinem Tempo und ohne Druck.")}</p><ul class="feature-list"><li>{t("Quadratatmen, 4–7–8 und weitere einstellbare Atemmuster")}</li><li>{t("Optionales Atemrauschen und sanfte Phasensignale")}</li><li>{t("Fokusansicht, Vollbild und optionales Bildschirm-Wachhalten")}</li></ul><a class="primary tool-open" href={localizedToolUrl("https://breathe.jacktools.net/de/",lang)} rel="noreferrer">{t("Atemübungen öffnen")} <span aria-hidden="true">↗</span></a><p class="product-note">{t("Kostenlos · ohne Benutzerkonto · direkt im Browser")}</p><p class="breathe-product-hint">{t("Atme nur so, wie es angenehm ist. Ein Entspannungstool, kein medizinisches Angebot.")}</p></div>
      <div class="timer-preview breathe-preview" role="img" aria-label={t("Statische Vorschau von Breathe: Verlaufskreis mit Atemphase und äußerem Fortschrittsring")}>
        <div class="preview-tabs" aria-hidden="true"><span class="active">{t("Quadratatmen")}</span><span>4–7–8</span><span>{t("Dein Rhythmus")}</span></div>
        <div class="company-breathe-scene" aria-hidden="true"><svg viewBox="0 0 100 100" class="company-breathe-ring"><circle cx="50" cy="50" r="48"/><circle class="company-breathe-progress" cx="50" cy="50" r="48" pathLength="100"/></svg><div class="company-breathe-circle"></div><div class="company-breathe-tile"><span>{t("Einatmen")}</span><strong>4</strong></div></div>
        <p>{t("Dein Atem. Dein Tempo.")}</p>
      </div>
    </article>
    <article id="naturgeraeusche" class="product-card timer-feature breathe-feature relax-feature" aria-labelledby="relax-card-title">
     <div class="product-copy"><span class="product-tag">{t("KLANG & ENTSPANNUNG")}</span><h3 id="relax-card-title">{t("Relax – Naturgeräusche und Klänge")}</h3><p>{t("Stelle dir deine eigene Klanglandschaft zusammen. Sanfte Instrumente und Naturgeräusche treffen auf ruhige, farbige Animationen – zum Zuhören, Zuschauen und Abschalten.")}</p><ul class="feature-list"><li>{t("Sieben Instrumente: vom Windspiel bis zu Klangschalen, Harfe und Gong")}</li><li>{t("Regen, Wind, Rauschen, Lagerfeuer und Meeresrauschen frei kombinieren")}</li><li>{t("Klang-Presets, eigene Lautstärken und einzeln schaltbare Animationen")}</li><li>{t("Fokusansicht und Schlafmodus mit sanftem Ausblenden bei begrenzter Dauer")}</li></ul><a class="primary tool-open" href={localizedToolUrl("https://relax.jacktools.net/de/",lang)} rel="noreferrer">{t("Naturgeräusche öffnen")} <span aria-hidden="true">↗</span></a><p class="product-note">{t("Kostenlos · ohne Werbung · ohne Tracking · direkt im Browser")}</p><p class="breathe-product-hint">{t("Höre leise und so, wie es angenehm ist. Ein Entspannungstool, kein medizinisches Angebot.")}</p></div>
     <div class="timer-preview relax-preview" role="img" aria-label={t("Statische Vorschau von Relax: farbige Formen und sanfte Meereswellen")}><div class="preview-tabs" aria-hidden="true"><span>{t("Instrumente")}</span><span class="active">{t("Naturklänge")}</span><span>{t("Deine Mischung")}</span></div><RelaxPreview/><p>{t("Zuhören. Zuschauen. Zur Ruhe kommen.")}</p></div>
    </article>
    <article id="online-metronom" class="product-card timer-feature metronome-feature" aria-labelledby="metronome-card-title">
     <div class="product-copy"><span class="product-tag">{t("MUSIK & RHYTHMUS")}</span><h3 id="metronome-card-title">{t("Online-Metronom mit Tap Tempo")}</h3><p>{t("Übe dein Tempo und Taktgefühl mit einem Metronom, das du hören und sehen kannst. Wähle eigene Akzente und Unterteilungen – für Instrument, Gesang und Rhythmusübungen.")}</p><ul class="feature-list"><li>{t("20–300 BPM, Tap Tempo und 1–12 Schläge pro Takt")}</li><li>{t("Orbit, Pendel, Beat-Leiste und springender Ball")}</li><li>{t("Lückenmodus zum Üben mit hörbaren und stummen Takten")}</li><li>{t("Fokusansicht mit optionalen statischen Hintergründen")}</li></ul><a class="primary tool-open" href={localizedToolUrl("https://metronome.jacktools.net/de/",lang)} rel="noreferrer">{t("Metronom öffnen")} <span aria-hidden="true">↗</span></a><p class="product-note">{t("Kostenlos · ohne Benutzerkonto · direkt im Browser")}</p></div>
     <div class="timer-preview metronome-preview" role="img" aria-label={t("Statische Vorschau des Metronoms: Orbit mit vier Schlägen und 90 BPM")}><div class="preview-tabs" aria-hidden="true"><span class="active">Orbit</span><span>{t("Dein Rhythmus")}</span></div><MetronomePreview lang={lang}/><p>{t("Höre den Schlag. Sieh den ganzen Takt.")}</p></div>
    </article>
