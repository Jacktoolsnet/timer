---
import Layout from '../layouts/Layout.astro';
import BlogPostCard from './BlogPostCard.astro';
import {getBlogPosts,getBlogPath} from '../lib/blog';
import {blogUi} from '../lib/blog-ui';
import type {Language} from '../lib/i18n';
interface Props{lang:Language}
const {lang}=Astro.props;
const ui=blogUi[lang];
const path=getBlogPath(lang);
const url=new URL(path,Astro.site).href;
const posts=getBlogPosts(lang);
---
<Layout lang={lang} title={ui.indexTitle} description={ui.indexDescription} route="blog/" homeAlternates={false} canonicalPath={path} blogKey="index" quietBackground>
 <a slot="header-action" href={path} aria-current="page">Blog</a>
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Blog',url,name:'Jacktools Blog',inLanguage:lang,description:ui.indexShort,publisher:{'@type':'Organization',name:'JackTools.Net',url:'https://jacktools.net/'},blogPost:posts.map(post=>({'@type':'BlogPosting',headline:post.title,url:new URL(post.path,Astro.site).href}))}).replaceAll('<','\\u003c')} />
 <div class="blog-index">
  <header><p class="blog-kicker">{ui.kicker}</p><h1>{ui.headline}<br/><em>{ui.subheadline}</em></h1><p class="blog-intro">{ui.intro}</p></header>
  <section aria-labelledby="posts-title"><h2 id="posts-title">{ui.posts}</h2><div class="blog-posts">{posts.map(post=><BlogPostCard post={post} />)}</div></section>
 </div>
</Layout>
<style>
.blog-index{font-size:calc(1rem * var(--font-scale,1));padding:3.5rem 0 4rem}.blog-index header{max-width:850px;margin-bottom:3rem}.blog-kicker{color:var(--accent);font-size:.85em;font-weight:650;letter-spacing:.12em}.blog-index h1{font-size:clamp(2.3em,4.5vw,3.7em);line-height:1.15;margin:1rem 0 1.5rem}.blog-intro{max-width:44rem;line-height:1.9;color:var(--muted)}.blog-posts{display:grid;gap:1.5rem}.blog-index h2{font-size:1.25em;margin:0 0 1.25rem}
:global(.header-nav-links:has(a[href$="/blog/"])){grid-template-columns:repeat(3,minmax(0,1fr))}
@media(max-width:760px){.blog-index{padding-top:2rem}}
@media print{.blog-index{padding:0}.blog-index header{margin-bottom:1rem}}
</style>
