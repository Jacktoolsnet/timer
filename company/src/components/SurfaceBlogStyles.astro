<style is:global>
.install-cheatsheet{padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-top:3px solid var(--accent);border-radius:12px;background:var(--surface)}
.quick-step{padding-top:1.5rem;margin-top:1.5rem;border-top:1px solid var(--line);min-width:0}
.quick-step h3{display:flex;align-items:baseline;gap:.8rem;font-size:1.12em;line-height:1.5;margin:0 0 1rem}
.quick-step h3>span{color:var(--accent);font:600 .85em ui-monospace,monospace;flex-shrink:0}
.installer-settings{margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
.installer-settings>div{padding:1rem;border:1px solid var(--line);border-radius:8px;min-width:0}
.installer-settings dt{font-weight:650;margin-bottom:.5rem}
.installer-settings dd{margin:0;line-height:1.7;overflow-wrap:anywhere}
.quick-finish{margin:1.5rem 0 0!important;padding-top:1.5rem;border-top:1px solid var(--line)}
@media(max-width:700px){.installer-settings{grid-template-columns:minmax(0,1fr)}}
@media print{.install-cheatsheet{padding:4mm;border-radius:0;break-inside:auto}.quick-step{padding-top:3mm;margin-top:3mm}.quick-step h3{break-after:avoid-page}.installer-settings{display:block}.installer-settings>div{padding:2mm;margin-bottom:2mm;break-inside:avoid-page}}
</style>
