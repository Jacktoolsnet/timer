---
import {companyTranslator} from '../lib/company-copy';
import type {Language} from '../lib/i18n';
interface Props {lang:Language}
const t=companyTranslator(Astro.props.lang);
---
<div class="company-metronome-scene" aria-hidden="true">
 <svg viewBox="0 0 240 240" class="company-metronome-orbit">
  <circle class="metronome-halo" cx="120" cy="120" r="110"/>
  <circle class="metronome-track" cx="120" cy="120" r="88"/>
  <circle class="metronome-inner" cx="120" cy="120" r="72"/>
  <circle class="metronome-mark accented" cx="120" cy="32" r="4"/><circle class="metronome-mark" cx="208" cy="120" r="3"/><circle class="metronome-mark" cx="120" cy="208" r="3"/><circle class="metronome-mark" cx="32" cy="120" r="3"/>
  <circle class="metronome-glow" cx="208" cy="120" r="12"/><circle class="metronome-light" cx="208" cy="120" r="5"/>
  <text class="metronome-count" x="120" y="126">2</text><text class="metronome-bar" x="120" y="150">{t('Takt 1')}</text>
 </svg>
 <div class="company-metronome-tempo">90 <span>BPM</span></div>
 <div class="company-metronome-beats">{[1,2,3,4].map(beat=><span class:list={{current:beat===2}}>{beat}</span>)}</div>
</div>
<style>
.company-metronome-scene{position:relative;z-index:1;display:flex;align-items:center;flex-direction:column;width:min(100%,260px);margin:auto;gap:10px;color:var(--accent)}
.company-metronome-orbit{display:block;width:100%;height:auto;fill:none;stroke:none}
.metronome-halo{fill:var(--accent-soft);opacity:.35}.metronome-track{fill:none;stroke:var(--line);stroke-width:1.5}.metronome-inner{fill:none;stroke:var(--line);stroke-width:1;stroke-dasharray:1 6}
.metronome-mark{fill:var(--surface);stroke:var(--accent);stroke-width:1.5}.metronome-mark.accented,.metronome-light{fill:var(--accent)}.metronome-glow{fill:var(--accent);opacity:.15}
.metronome-count{fill:var(--text);stroke:none;text-anchor:middle;font:48px ui-monospace,Consolas,monospace;font-variant-numeric:lining-nums tabular-nums}.metronome-bar{fill:var(--muted);stroke:none;text-anchor:middle;font:9px system-ui,sans-serif;letter-spacing:1px}
.company-metronome-tempo{font:32px/1.2 ui-monospace,Consolas,monospace;font-variant-numeric:lining-nums tabular-nums;color:var(--text)}.company-metronome-tempo span{font:10px system-ui,sans-serif;letter-spacing:1px;color:var(--muted)}
.company-metronome-beats{display:flex;gap:7px}.company-metronome-beats span{display:grid;place-items:center;width:28px;height:30px;border:1px solid var(--line);border-radius:8px;color:var(--muted);font-size:12px}.company-metronome-beats .current{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}
</style>
