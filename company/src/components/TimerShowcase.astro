---
import pictures from '../lib/timer-gallery.json';
const first = pictures[0];
---
<section class="timer-showcase" aria-labelledby="showcase-title" aria-roledescription="Karussell">
  <div class="showcase-heading"><div><p>DEIN TIMER. DEIN STIL.</p><h2 id="showcase-title">Ein Tool, viele Ansichten.</h2></div><span>Echte Einblicke in den Online-Timer</span></div>
  <p class="showcase-intro">Digital, analog oder beides zusammen: Entdecke runde und eckige Zifferblätter, römische Zahlen, verschiedene Farben sowie helle und dunkle Designs. Die Bilder zeigen konkrete Einstellungen von timer.jacktools.net.</p>
  <figure class="showcase-figure tool-screenshot">
    <a class="showcase-open" href={first.src} aria-label="Aktuelles Timer-Bild vergrößern"><img id="showcase-image" src={first.src} width={first.width} height={first.height} alt={first.alt} loading="lazy" decoding="async"/><span class="enlarge-hint" aria-hidden="true">Vergrößern</span></a>
    <figcaption><strong id="showcase-name">{first.title}</strong><span id="showcase-caption">{first.caption}</span></figcaption>
  </figure>
  <div class="showcase-controls"><button type="button" id="showcase-previous" aria-label="Vorherige Timer-Ansicht" data-showcase-control hidden>Zurück</button><span id="showcase-position" role="status" aria-live="polite">1 / {pictures.length}</span><button type="button" id="showcase-next" aria-label="Nächste Timer-Ansicht" data-showcase-control hidden>Weiter</button></div>
  <nav class="showcase-thumbnails" aria-label="Timer-Ansicht auswählen">{pictures.map((picture,index)=><a class="timer-gallery-thumb" href={picture.src} aria-current={index===0?'true':'false'} aria-label={picture.title} data-caption={picture.caption} data-title={picture.title} data-alt={picture.alt} data-width={picture.width} data-height={picture.height}><img src={picture.thumb} width="240" height="170" alt="" loading="lazy" decoding="async"/><span>{picture.title}</span></a>)}</nav>
</section>
  <dialog class="screenshot-gallery" id="screenshot-gallery" aria-labelledby="gallery-title">
    <div class="gallery-toolbar"><h2 id="gallery-title">Timer-Galerie</h2><button type="button" class="gallery-close" aria-label="Galerie schließen" autofocus>Schließen <span aria-hidden="true">×</span></button></div>
    <figure class="gallery-figure"><img id="gallery-image" alt="" width="1000" height="656" /><figcaption id="gallery-caption"></figcaption></figure>
    <div class="gallery-navigation"><button type="button" id="gallery-previous" aria-label="Vorheriges Bild">Zurück</button><span id="gallery-position" role="status" aria-live="polite"></span><button type="button" id="gallery-next" aria-label="Nächstes Bild">Weiter</button></div>
  </dialog><script>
 const gallery=document.getElementById('screenshot-gallery') as HTMLDialogElement;
 const root=document.querySelector<HTMLElement>('.timer-showcase')!;
 const pictures=Array.from(root.querySelectorAll<HTMLAnchorElement>('.timer-gallery-thumb'));
 const image=document.getElementById('showcase-image') as HTMLImageElement;
 const enlarged=document.getElementById('gallery-image') as HTMLImageElement;
 const opener=root.querySelector<HTMLAnchorElement>('.showcase-open')!;
 let selected=0;
 const showPicture=(index:number)=>{
  selected=(index+pictures.length)%pictures.length;
  const picture=pictures[selected];
  for(const img of [image,enlarged]){
   img.src=picture.href;img.alt=picture.dataset.alt!;img.width=Number(picture.dataset.width);img.height=Number(picture.dataset.height);
  }
  opener.href=picture.href;
  document.getElementById('showcase-name')!.textContent=picture.dataset.title!;
  document.getElementById('showcase-caption')!.textContent=picture.dataset.caption!;
  document.getElementById('gallery-caption')!.textContent=picture.dataset.title+' · '+picture.dataset.caption;
  for(const id of ['showcase-position','gallery-position'])document.getElementById(id)!.textContent=`${selected+1} / ${pictures.length}`;
  pictures.forEach((link,i)=>link.setAttribute('aria-current',String(i===selected)));
  const track=root.querySelector<HTMLElement>('.showcase-thumbnails')!;
  const left=picture.getBoundingClientRect().left-track.getBoundingClientRect().left+track.scrollLeft;
  track.scrollTo({left:Math.max(0,left-5),behavior:'instant'});
 };
 pictures.forEach((link,index)=>link.addEventListener('click',event=>{
  if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
  event.preventDefault();showPicture(index);
 }));
 root.querySelectorAll<HTMLElement>('[data-showcase-control]').forEach(control=>control.hidden=false);
 for(const prefix of ['showcase','gallery']){
  document.getElementById(prefix+'-previous')!.addEventListener('click',()=>showPicture(selected-1));
  document.getElementById(prefix+'-next')!.addEventListener('click',()=>showPicture(selected+1));
 }
 const handleKeys=(event:KeyboardEvent)=>{
  if(event.key==='ArrowLeft'||event.key==='ArrowRight'){
   event.preventDefault();showPicture(selected+(event.key==='ArrowRight'?1:-1));

  }
 };
 root.addEventListener('keydown',handleKeys);gallery.addEventListener('keydown',handleKeys);
 let touchStart:{x:number;y:number}|null=null;let lastSwipe=0;
 opener.addEventListener('pointerdown',event=>{if(event.pointerType==='touch')touchStart={x:event.clientX,y:event.clientY};});
 opener.addEventListener('pointerup',event=>{
  if(!touchStart)return;
  const dx=event.clientX-touchStart.x,dy=event.clientY-touchStart.y;touchStart=null;
  if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)*1.5){showPicture(selected+(dx<0?1:-1));lastSwipe=Date.now();}
 });
 opener.addEventListener('pointercancel',()=>touchStart=null);
 opener.addEventListener('click',event=>{
  if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
  event.preventDefault();if(Date.now()-lastSwipe<500)return;
  showPicture(selected);gallery.showModal();document.documentElement.classList.add('gallery-open');
 });
 gallery.querySelector('.gallery-close')!.addEventListener('click',()=>gallery.close());
 gallery.addEventListener('click',event=>{
  if(event.target!==gallery)return;
  const rect=gallery.getBoundingClientRect();
  if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)gallery.close();
 });
 gallery.addEventListener('close',()=>document.documentElement.classList.remove('gallery-open'));
 showPicture(0);
</script>
<style>
.timer-showcase{padding:2rem!important;margin-bottom:2.5rem;border:1px solid var(--line)!important;border-radius:16px;background:linear-gradient(135deg,var(--surface),var(--accent-soft));font-size:inherit;min-width:0}
.showcase-heading{display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:1rem}.showcase-heading p{font-size:.875em;color:var(--accent);letter-spacing:.1em;margin:0 0 .6rem}.showcase-heading h2{font-size:1.8em;line-height:1.3;margin:0}.showcase-heading>span{color:var(--muted);font-size:.875em}.showcase-intro{color:var(--muted);margin:1rem 0 1.5rem}
.showcase-figure{margin:0}.showcase-open{position:relative;display:flex;align-items:center;justify-content:center;aspect-ratio:1.65;background:var(--surface);border:1px solid var(--line);border-radius:8px;overflow:hidden;touch-action:pan-y}.showcase-open img{display:block;max-width:100%;width:100%;height:100%;object-fit:contain}.enlarge-hint{position:absolute;right:.7rem;bottom:.7rem;padding:.35rem .7rem;background:var(--surface);color:var(--accent);border:1px solid var(--line);border-radius:6px;font-size:.875em}
.showcase-figure figcaption{display:flex;flex-direction:column;gap:.25rem;min-height:5.5em;margin:1rem 0 0;line-height:1.6}.showcase-figure figcaption>span{color:var(--muted);font-size:.9em}
.showcase-controls{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:1rem 0}.showcase-controls button{font:inherit;color:var(--accent);background:var(--surface);border:1px solid var(--line);border-radius:8px;min-height:44px;padding:.5rem 1rem;cursor:pointer}.showcase-controls button:hover{border-color:var(--accent)}.showcase-controls button[hidden]{display:none}.showcase-controls>span{font-size:.9em;color:var(--muted)}
.showcase-thumbnails{display:flex;gap:.75rem;overflow-x:auto;padding:5px 5px 14px;scroll-snap-type:x proximity;overscroll-behavior-inline:contain}.timer-gallery-thumb{flex:0 0 150px;display:flex;flex-direction:column;scroll-snap-align:start;border:2px solid var(--line);border-radius:8px;overflow:hidden;background:var(--surface);text-decoration:none!important}.timer-gallery-thumb img{display:block;width:100%;height:auto;aspect-ratio:24/17;object-fit:contain}.timer-gallery-thumb span{display:block;padding:.5rem .65rem;font-size:.875em;font-weight:600;line-height:1.4;color:var(--text)}.timer-gallery-thumb[aria-current=true]{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}.timer-gallery-thumb:hover{border-color:var(--accent)}.timer-gallery-thumb[aria-current=true] span{background:var(--accent-soft);color:var(--accent)}
.timer-showcase :is(a,button):focus-visible{outline:3px solid var(--accent);outline-offset:3px}
@media(max-width:760px){.timer-showcase{padding:1rem!important}.showcase-heading h2{font-size:1.5em}.showcase-open{aspect-ratio:1.35}.timer-gallery-thumb{flex-basis:125px}.showcase-figure figcaption{min-height:8em}}
@media print{.timer-showcase,.screenshot-gallery,.screenshot-gallery::backdrop{display:none!important}:global(html.gallery-open){overflow:visible!important}}
  :global(html.gallery-open){overflow:hidden}
  .screenshot-gallery{position:fixed;inset:0;width:min(1040px,calc(100vw - 2rem));max-width:none;max-height:calc(100dvh - 2rem);margin:auto;padding:1.25rem;border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--text);box-shadow:0 24px 80px #0005;overflow:auto}
  .screenshot-gallery::backdrop{background:#071019bd;backdrop-filter:blur(6px)}
  .gallery-toolbar,.gallery-navigation{display:flex;align-items:center;justify-content:space-between;gap:1rem}.gallery-toolbar h2{font-size:1.1rem;margin:0}.screenshot-gallery button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:44px;padding:.6rem 1rem;border:1px solid var(--line);border-radius:8px;background:var(--accent-soft);color:var(--accent);font:inherit;cursor:pointer}.screenshot-gallery button:hover{border-color:var(--accent)}.screenshot-gallery button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.gallery-close span{font-size:1.5rem;line-height:1}
  .gallery-figure{margin:1rem 0}.gallery-figure img{display:block;width:100%;height:auto;max-height:65dvh;object-fit:contain}.gallery-figure figcaption{font-size:.9rem;line-height:1.6;color:var(--muted);margin-top:.75rem}.gallery-navigation{font-size:.9rem}
  @media(max-width:480px){.screenshot-gallery{padding:.8rem;width:calc(100vw - 1rem);max-height:calc(100dvh - 1rem)}.gallery-toolbar{gap:.5rem}.gallery-toolbar h2{font-size:1rem}}
  .related-guides{display:flex;flex-wrap:wrap;gap:.75rem;padding-top:2.5rem}.related-guides h2{width:100%;font-size:1.25em}.related-guides a{padding:.75rem 1rem;border:1px solid var(--line);border-radius:8px;background:var(--surface)}

</style>
