---
import pictures from '../lib/timer-gallery.json';
const first = pictures[0];
---
<section class="timer-showcase" aria-labelledby="showcase-title" aria-roledescription="Karussell">
  <div class="showcase-heading"><div><p>DEIN TIMER. DEIN STIL.</p><h2 id="showcase-title">Ein Tool, viele Ansichten.</h2></div><span>Echte Einblicke in den Online-Timer</span></div>
  <p class="showcase-intro">Rund, eckig, analog oder digital: Entdecke die Stile und Farben des Online-Timers. Für Details kannst du jedes Bild vergrößern.</p>
  <div class="showcase-controls"><span id="showcase-position" role="status" aria-live="polite">1 / {pictures.length}</span></div>
  <figure class="showcase-figure tool-screenshot">
    <a class="showcase-open" style={'--picture-ratio:'+first.width+'/'+first.height} href={first.src} aria-label="Aktuelles Timer-Bild vergrößern" title="Bild vergrößern"><img id="showcase-image" src={first.src} width={first.width} height={first.height} alt={first.alt} loading="lazy" decoding="async"/><span class="enlarge-hint" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg></span></a>
    <figcaption><strong id="showcase-name">{first.title}</strong><span id="showcase-caption">{first.caption}</span></figcaption>
  </figure>

  <div class="showcase-strip"><button class="showcase-step" type="button" id="showcase-previous" aria-label="Vorherige Timer-Ansicht" title="Vorherige Timer-Ansicht" data-showcase-control hidden><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>  <nav class="showcase-thumbnails" aria-label="Timer-Ansicht auswählen">{pictures.map((picture,index)=><a class="timer-gallery-thumb" href={picture.src} aria-current={index===0?'true':'false'} aria-label={picture.title} title={picture.title} data-caption={picture.caption} data-title={picture.title} data-alt={picture.alt} data-width={picture.width} data-height={picture.height}><img src={picture.thumb} width="240" height="170" alt="" loading="lazy" decoding="async"/><span>{picture.title}</span></a>)}</nav><button class="showcase-step" type="button" id="showcase-next" aria-label="Nächste Timer-Ansicht" title="Nächste Timer-Ansicht" data-showcase-control hidden><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button></div>
</section>
  <dialog class="screenshot-gallery" id="screenshot-gallery" aria-labelledby="gallery-title">
    <div class="gallery-toolbar"><h2 id="gallery-title">Timer-Galerie</h2><button type="button" class="gallery-close" aria-label="Galerie schließen" title="Galerie schließen" autofocus><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <figure class="gallery-figure"><img id="gallery-image" alt="" width="1000" height="656" /><figcaption id="gallery-caption"></figcaption></figure>
    <div class="gallery-navigation"><button type="button" id="gallery-previous" aria-label="Vorheriges Bild" title="Vorheriges Bild"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button><span id="gallery-position" role="status" aria-live="polite"></span><button type="button" id="gallery-next" aria-label="Nächstes Bild" title="Nächstes Bild"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button></div>
  </dialog><script>
 const gallery=document.getElementById('screenshot-gallery') as HTMLDialogElement;
 const root=document.querySelector<HTMLElement>('.timer-showcase')!;
 const pictures=Array.from(root.querySelectorAll<HTMLAnchorElement>('.timer-gallery-thumb'));
 const image=document.getElementById('showcase-image') as HTMLImageElement;
 const enlarged=document.getElementById('gallery-image') as HTMLImageElement;
 const opener=root.querySelector<HTMLAnchorElement>('.showcase-open')!;
 let selected=0;
 const showPicture=(index:number)=>{
  selected=(index+pictures.length)%pictures.length;
  const picture=pictures[selected];
  for(const img of [image,enlarged]){
   img.src=picture.href;img.alt=picture.dataset.alt!;img.width=Number(picture.dataset.width);img.height=Number(picture.dataset.height);
  }
  opener.href=picture.href;
  opener.style.setProperty('--picture-ratio',`${picture.dataset.width}/${picture.dataset.height}`);
  document.getElementById('showcase-name')!.textContent=picture.dataset.title!;
  document.getElementById('showcase-caption')!.textContent=picture.dataset.caption!;
  document.getElementById('gallery-caption')!.textContent=picture.dataset.title+' · '+picture.dataset.caption;
  for(const id of ['showcase-position','gallery-position'])document.getElementById(id)!.textContent=`${selected+1} / ${pictures.length}`;
  pictures.forEach((link,i)=>link.setAttribute('aria-current',String(i===selected)));
  const track=root.querySelector<HTMLElement>('.showcase-thumbnails')!;
  const left=picture.getBoundingClientRect().left-track.getBoundingClientRect().left+track.scrollLeft;
  track.scrollTo({left:Math.max(0,left-5),behavior:'instant'});
 };
 pictures.forEach((link,index)=>link.addEventListener('click',event=>{
  if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
  event.preventDefault();showPicture(index);
 }));
 root.querySelectorAll<HTMLElement>('[data-showcase-control]').forEach(control=>control.hidden=false);
 for(const prefix of ['showcase','gallery']){
  document.getElementById(prefix+'-previous')!.addEventListener('click',()=>showPicture(selected-1));
  document.getElementById(prefix+'-next')!.addEventListener('click',()=>showPicture(selected+1));
 }
 const handleKeys=(event:KeyboardEvent)=>{
  if(event.key==='ArrowLeft'||event.key==='ArrowRight'){
   event.preventDefault();showPicture(selected+(event.key==='ArrowRight'?1:-1));

  }
 };
 root.addEventListener('keydown',handleKeys);gallery.addEventListener('keydown',handleKeys);
 let touchStart:{x:number;y:number}|null=null;let lastSwipe=0;
 opener.addEventListener('pointerdown',event=>{if(event.pointerType==='touch')touchStart={x:event.clientX,y:event.clientY};});
 opener.addEventListener('pointerup',event=>{
  if(!touchStart)return;
  const dx=event.clientX-touchStart.x,dy=event.clientY-touchStart.y;touchStart=null;
  if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)*1.5){showPicture(selected+(dx<0?1:-1));lastSwipe=Date.now();}
 });
 opener.addEventListener('pointercancel',()=>touchStart=null);
 opener.addEventListener('click',event=>{
  if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
  event.preventDefault();if(Date.now()-lastSwipe<500)return;
  showPicture(selected);gallery.showModal();document.documentElement.classList.add('gallery-open');
 });
 gallery.querySelector('.gallery-close')!.addEventListener('click',()=>gallery.close());
 gallery.addEventListener('click',event=>{
  if(event.target!==gallery)return;
  const rect=gallery.getBoundingClientRect();
  if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)gallery.close();
 });
 gallery.addEventListener('close',()=>document.documentElement.classList.remove('gallery-open'));
 showPicture(0);
</script>
<style>
.timer-showcase{padding:1.25rem!important;margin-bottom:2.5rem;border:1px solid var(--line)!important;border-radius:16px;background:linear-gradient(135deg,var(--surface),var(--accent-soft));font-size:inherit;min-width:0}
.showcase-heading{display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:1rem}.showcase-heading p{font-size:.875em;color:var(--accent);letter-spacing:.1em;margin:0 0 .6rem}.showcase-heading h2{font-size:1.8em;line-height:1.3;margin:0}.showcase-heading>span{color:var(--muted);font-size:.875em}.showcase-intro{color:var(--muted);margin:.65rem 0}
.showcase-figure{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,240px);align-items:center;gap:1.25rem;padding:1rem;border:1px solid var(--line);border-radius:12px;background:color-mix(in srgb,var(--accent-soft) 45%,transparent)}.showcase-open{position:relative;display:flex;align-items:center;justify-content:center;height:clamp(170px,34svh,300px);width:auto;max-width:100%;aspect-ratio:var(--picture-ratio);justify-self:center;background:transparent;border:0;border-radius:8px;overflow:hidden;box-shadow:0 4px 18px #0002;touch-action:pan-y}.showcase-open img{display:block;max-width:100%;width:100%;height:100%;object-fit:contain;border-radius:inherit}.enlarge-hint{display:grid;place-items:center;min-width:36px;min-height:36px;box-sizing:border-box;position:absolute;right:.7rem;bottom:.7rem;padding:.35rem .7rem;background:var(--surface);color:var(--accent);border:1px solid var(--line);border-radius:6px;font-size:.875em}
.showcase-figure figcaption{display:flex;flex-direction:column;gap:.25rem;margin:0;line-height:1.6}.showcase-figure figcaption>span{color:var(--muted);font-size:.9em}
.showcase-controls{display:flex;justify-content:flex-end;margin:.35rem 0}.showcase-strip{display:grid;grid-template-columns:44px minmax(0,1fr) 44px;align-items:center;gap:.65rem;margin-top:.75rem}.showcase-step{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0!important;font:inherit;color:var(--accent);background:var(--surface);border:1px solid var(--line);border-radius:8px;min-height:44px;padding:.5rem 1rem;cursor:pointer}.showcase-step:hover{border-color:var(--accent)}.showcase-step[hidden]{display:none}.showcase-controls>span{font-size:.9em;color:var(--muted)}
.showcase-thumbnails{min-width:0;margin:0;display:flex;gap:.75rem;overflow-x:auto;padding:5px 5px 14px;scroll-snap-type:x proximity;overscroll-behavior-inline:contain}.timer-gallery-thumb{position:relative;flex:0 0 96px;display:flex;flex-direction:column;scroll-snap-align:start;border:2px solid var(--line);border-radius:8px;overflow:hidden;background:var(--surface);text-decoration:none!important}.timer-gallery-thumb img{display:block;width:100%;height:auto;aspect-ratio:24/17;object-fit:cover}.timer-gallery-thumb span{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.timer-gallery-thumb[aria-current=true]{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}.timer-gallery-thumb:hover{border-color:var(--accent)}.timer-gallery-thumb[aria-current=true] span{background:var(--accent-soft);color:var(--accent)}
.timer-showcase :is(a,button):focus-visible{outline:3px solid var(--accent);outline-offset:3px}
@media(max-width:760px){.timer-showcase{padding:1rem!important}.showcase-heading h2{font-size:1.5em}.showcase-heading>span,.showcase-heading p{display:none}.showcase-figure{grid-template-columns:minmax(0,1fr);gap:.65rem}.showcase-open{height:clamp(160px,30svh,240px)}.timer-gallery-thumb{flex-basis:82px}.showcase-figure figcaption{min-height:0}}
@media print{.timer-showcase,.screenshot-gallery,.screenshot-gallery::backdrop{display:none!important}:global(html.gallery-open){overflow:visible!important}}
  :global(html.gallery-open){overflow:hidden}
  .screenshot-gallery{position:fixed;inset:0;width:min(1040px,calc(100vw - 2rem));max-width:none;max-height:calc(100dvh - 2rem);margin:auto;padding:1.25rem;border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--text);box-shadow:0 24px 80px #0005;overflow:auto}
  .screenshot-gallery::backdrop{background:#071019bd;backdrop-filter:blur(6px)}
  .gallery-toolbar,.gallery-navigation{display:flex;align-items:center;justify-content:space-between;gap:1rem}.gallery-toolbar h2{font-size:1.1rem;margin:0}.screenshot-gallery button{width:44px;height:44px;padding:0!important;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:44px;padding:.6rem 1rem;border:1px solid var(--line);border-radius:8px;background:var(--accent-soft);color:var(--accent);font:inherit;cursor:pointer}.screenshot-gallery button:hover{border-color:var(--accent)}.screenshot-gallery button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.gallery-close span{font-size:1.5rem;line-height:1}
  .gallery-figure{margin:1.75rem 0}.gallery-figure img{display:block;width:100%;height:auto;max-height:calc(65dvh - 1.5rem);object-fit:contain}.gallery-figure figcaption{font-size:.9rem;line-height:1.6;color:var(--muted);margin-top:1.25rem}.gallery-navigation{font-size:.9rem}
  @media(max-width:480px){.screenshot-gallery{padding:.8rem;width:calc(100vw - 1rem);max-height:calc(100dvh - 1rem)}.gallery-toolbar{gap:.5rem}.gallery-toolbar h2{font-size:1rem}}
  .related-guides{display:flex;flex-wrap:wrap;gap:.75rem;padding-top:2.5rem}.related-guides h2{width:100%;font-size:1.25em}.related-guides a{padding:.75rem 1rem;border:1px solid var(--line);border-radius:8px;background:var(--surface)}

</style>
