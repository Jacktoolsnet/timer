---
import Layout from '../layouts/Layout.astro';
import AdBanner from './AdBanner.astro';
import GuideGallery from './GuideGallery.astro';
import BrandIcon from '../../../shared/BrandIcon.astro';
import { guideCards, guideImages, toolGuides, type ToolGuide } from '../lib/tool-guides';
interface Props { guide: ToolGuide }
const {guide:g} = Astro.props;
const image = guideImages[g.slug];
const related = toolGuides.filter(tool => tool.slug !== g.slug).slice(0, 2);
---
<Layout lang="de" title={g.name + ': Anleitung, Beispiele und Funktionen'} description={g.description} route={'tools/'+g.slug+'/'} homeAlternates={false}>
  <a slot="header-action" class="guide-header-action" href={g.url}>{g.name} öffnen</a>
  <article class="tool-guide">
    <header class="tool-guide-hero">
      <div><p class="eyebrow">{g.tag} · ANLEITUNG</p><h1>{g.title}</h1><p class="guide-lead">{g.lead}</p><a class="guide-primary" href={g.url}>{g.name} öffnen</a></div>
      <div class="tool-identity" aria-hidden="true"><span class="identity-icon">{g.slug === 'messagedrop' ? <img src="/markers/message-marker.svg" width="96" height="120" alt=""/> : <BrandIcon tool={g.slug as 'clock'|'stopwatch'|'calculator'|'breathe'|'relax'|'metronome'} />}</span><strong>{g.name}</strong><span>{g.tag}</span></div>
    </header>
    <nav class="guide-toc" aria-labelledby="toc-heading"><strong id="toc-heading">In dieser Anleitung</strong><div class="toc-grid"><a href="#ueberblick"><span>Funktionen im Überblick</span><small>Was das Tool für dich bereithält</small></a>{g.sections.map(section=><a href={'#'+section.id}><span>{section.title}</span><small>{section.summary}</small></a>)}<a href="#fragen"><span>Fragen & Grenzen</span><small>Wichtige Antworten vor dem Start</small></a></div></nav>
    <section id="ueberblick"><p class="eyebrow">DAS TOOL KENNENLERNEN</p><h2>{g.name}: die wichtigsten Funktionen</h2><div class="feature-grid">{g.features.map(feature=><div><h3>{feature.title}</h3><p>{feature.text}</p></div>)}</div></section>
    <AdBanner lang="de" />
    {g.sections.map((section,index)=><section id={section.id}>
      <h2>{section.title}</h2>
      {index === 0 && image && <figure class="tool-screenshot"><a href={'/images/guides/'+g.slug+'.png'} aria-label={g.name+'-Screenshot vergrößern'}><img src={'/images/guides/'+g.slug+'.png'} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async"/></a><figcaption>{image.caption} Zum Vergrößern anklicken.</figcaption></figure>}
      {index === 0 && g.slug === 'messagedrop' && <figure class="tool-screenshot"><a href="/images/guides/messagedrop.svg" aria-label="MessageDrop-Schaubild vergrößern"><img src="/images/guides/messagedrop.svg" width="1000" height="460" loading="lazy" alt="Schaubild: Auf der Karte einen Ort finden, einen Beitrag vorbereiten und seine Sichtbarkeit vor der Veröffentlichung prüfen."/></a><figcaption>Schematischer Ablauf, keine echte App-Ansicht und keine realen Nutzerdaten. Zum Vergrößern anklicken.</figcaption></figure>}
      {section.paragraphs.map(paragraph=><p>{paragraph}</p>)}
      {section.steps.length > 0 && <ol>{section.steps.map(step=><li>{step}</li>)}</ol>}
      {section.example && <aside class="guide-example"><h3>{section.example.title}</h3><p>{section.example.text}</p></aside>}
    </section>)}
    <section id="fragen"><h2>Häufige Fragen und wichtige Grenzen</h2>{g.faq.map((faq,index)=><details open={index === 0}><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
    <footer class="guide-end"><p class="eyebrow">AUSPROBIEREN STATT NUR LESEN</p><h2>Dein Einstieg mit {g.name}</h2><p>{g.end}</p><a class="guide-primary" href={g.url}>{g.name} öffnen</a><div class="end-links"><a href={'/de/#'+guideCards[g.slug]}>Zur Toolübersicht</a><a href="mailto:jacktoolsnet@gmail.com">Feedback zur Anleitung</a></div></footer>
    <nav class="related-guides" aria-label="Weitere Anleitungen"><h2>Weitere Tools kennenlernen</h2><a href="/de/tools/timer/">Timer: Countdown, Pomodoro und Intervalle</a>{related.map(tool=><a href={'/de/tools/'+tool.slug+'/'}>{tool.name}: Anleitung & Beispiele</a>)}</nav>
  </article>
  <GuideGallery />
</Layout>
<style>
.tool-guide{font-size:calc(1rem * var(--font-scale,1));line-height:1.85;padding-bottom:3rem;overflow-wrap:anywhere}
.tool-guide a:not(.guide-primary){color:var(--accent);text-underline-offset:.22em}.tool-guide a:focus-visible{outline:3px solid var(--accent);outline-offset:4px}
.tool-guide-hero{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:3rem;align-items:center;padding:3rem 0}
.tool-guide h1{font-size:calc(clamp(2rem,4vw,3.3rem) * var(--font-scale,1));line-height:1.18;letter-spacing:-.04em;margin:1.2rem 0}.guide-lead{color:var(--muted)}
.tool-guide .eyebrow{justify-content:flex-start;font-size:.875em}.guide-primary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.75rem 1.25rem;border:1px solid var(--accent);border-radius:8px;background:var(--accent);color:var(--surface);font-weight:600;text-decoration:none;line-height:1.5;margin-top:1rem}.guide-primary:hover{filter:brightness(1.1)}
.tool-identity{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.25rem;min-height:320px;padding:2rem;border:1px solid var(--line);border-radius:24px;background:radial-gradient(ellipse at top,var(--accent-soft),var(--surface))}.identity-icon{display:block;width:112px;height:120px}.identity-icon :global(svg){width:112px;height:112px}.tool-identity strong{font-size:2em;line-height:1.25}.tool-identity>span:last-child{font-size:.875em;letter-spacing:.12em;color:var(--muted)}
.guide-toc{padding:1.5rem;border:1px solid var(--line);border-radius:16px;background:linear-gradient(135deg,var(--surface),var(--accent-soft))}.guide-toc>strong{display:block;font-size:1.15em;margin-bottom:1.2rem}.toc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.tool-guide .toc-grid a{display:flex;flex-direction:column;justify-content:center;gap:.3rem;min-height:88px;min-width:0;padding:1rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);text-decoration:none;line-height:1.5}.toc-grid a>span{font-weight:600}.toc-grid small{font-size:.875em;color:var(--muted)}.tool-guide .toc-grid a:hover{background:var(--accent-soft);border-color:var(--accent)}
.tool-guide section{padding:2.5rem 0;border-bottom:1px solid var(--line);scroll-margin-top:2rem}.tool-guide h2{font-size:1.8em;line-height:1.3;margin:0 0 1.2rem}.tool-guide h3{font-size:1.15em;line-height:1.4;margin:0 0 .8rem}.tool-guide li{margin:.8rem 0;padding-left:.4rem}.tool-guide ol{padding-left:1.5rem}.feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.feature-grid>div{padding:1.5rem;border:1px solid var(--line);background:var(--surface)}.feature-grid p{margin-bottom:0;color:var(--muted)}
.tool-screenshot{margin:1.5rem 0 2rem;padding:1.25rem;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.tool-screenshot a{display:block;max-width:820px;margin:auto}.tool-screenshot img{display:block;width:100%;height:auto}.tool-screenshot figcaption{margin:1rem auto 0;max-width:820px;font-size:.9em;color:var(--muted);line-height:1.7}
.guide-example{padding:1.5rem;border-left:4px solid var(--accent);background:var(--accent-soft);margin:1.8rem 0}.guide-example p{margin-bottom:0}.tool-guide details{padding:1rem 0;border-top:1px solid var(--line)}.tool-guide summary{font-weight:600;cursor:pointer;min-height:44px;align-content:center}
.guide-end{margin-top:2rem;padding:2rem;border:1px solid var(--line);border-radius:16px;background:linear-gradient(135deg,var(--accent-soft),var(--surface))}.end-links{display:flex;flex-wrap:wrap;gap:1rem 2rem;margin-top:1.5rem;font-size:.9em}.related-guides{padding-top:2.5rem;display:flex;gap:.75rem;flex-wrap:wrap}.related-guides h2{width:100%;font-size:1.25em}.related-guides a{padding:.75rem 1rem;border:1px solid var(--line);border-radius:8px;background:var(--surface)}
:global(.header-nav-links:has(.guide-header-action)){grid-template-columns:repeat(3,minmax(0,1fr))}:global(.header-nav .header-nav-links a.guide-header-action){background:var(--accent);color:var(--surface);font-weight:650}:global(.header-nav .header-nav-links a.guide-header-action:hover){background:var(--accent);color:var(--surface);filter:brightness(1.1)}:global(.header-nav .header-nav-links a.guide-header-action:focus-visible){outline:3px solid var(--accent);outline-offset:3px}
:global([data-style=technical]) .guide-toc,:global([data-style=technical]) .toc-grid a,:global([data-style=technical]) .tool-identity,:global([data-style=technical]) .guide-primary,:global([data-style=technical]) .guide-end{border-radius:3px}
@media(max-width:1000px){.toc-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.tool-guide-hero,.feature-grid,.toc-grid{grid-template-columns:minmax(0,1fr)}.tool-guide-hero{gap:1.5rem;padding:2rem 0}.tool-identity{min-height:200px}.tool-guide h2{font-size:1.5em}.guide-toc,.guide-end{padding:1rem}.tool-screenshot{padding:.65rem}.tool-guide-hero .guide-primary{width:100%;box-sizing:border-box}.tool-identity strong{font-size:1.5em}}
@page tool-guide{size:A4;margin:16mm}
@media print{
:global(html:has(.tool-guide)),:global(body:has(.tool-guide)){background:#fff!important;color:#000!important;margin:0!important}:global(body:has(.tool-guide)){page:tool-guide}
:global(body:has(.tool-guide) .site-header),:global(body:has(.tool-guide) .site-footer),:global(body:has(.tool-guide) .ambient-background),:global(body:has(.tool-guide) .skip-link),:global(body:has(.tool-guide) dialog),:global(body:has(.tool-guide) [data-ad-placement]){display:none!important}
:global(body:has(.tool-guide) .site-shell),:global(body:has(.tool-guide) main){display:block!important;width:auto!important;max-width:none!important;min-height:0!important;margin:0!important;padding:0!important;overflow:visible!important}
.tool-guide,.tool-guide *{background:transparent!important;color:#000!important;box-shadow:none!important;text-shadow:none!important;letter-spacing:normal!important;font-family:Arial,Helvetica,sans-serif!important}.tool-guide{font-size:11pt;line-height:1.45;padding:0}.tool-identity,.guide-toc,.tool-screenshot,.end-links,.related-guides,.eyebrow{display:none!important}
.tool-guide-hero{display:block;padding:0 0 4mm;border-bottom:1pt solid #999}.tool-guide-hero::before{content:'Jacktools.net · Anleitung';font-size:10pt}.tool-guide h1{font-size:24pt;line-height:1.15;margin:4mm 0}.tool-guide h2{font-size:15pt;margin:0 0 3mm}.tool-guide h3{font-size:12pt;margin:0 0 2mm}.tool-guide h1,.tool-guide h2,.tool-guide h3,.tool-guide summary{break-after:avoid-page}.tool-guide section{padding:5mm 0;border-bottom:1pt solid #ccc}.tool-guide p,.tool-guide li{orphans:3;widows:3}.tool-guide p{margin:0 0 3mm}.feature-grid{display:block}.feature-grid>div{border:0;padding:3mm 0;break-inside:avoid-page}.guide-example{padding:3mm 4mm;border:1pt solid #999;margin:4mm 0;break-inside:avoid-page}.tool-guide details{padding:3mm 0;break-inside:avoid-page}.tool-guide summary{list-style:none;min-height:0;margin-bottom:2mm}.tool-guide summary::marker{content:''}.tool-guide details::details-content{content-visibility:visible;display:block}.tool-guide details>p{display:block!important}.tool-guide a[href^="https://"]::after{content:' (' attr(href) ')';font-size:9pt;font-weight:normal;overflow-wrap:anywhere}.guide-primary{display:inline;border:0;padding:0;margin:0;font-size:10pt;text-decoration:underline}.guide-end{border:0;padding:5mm 0 0;margin:0}
}
</style>
