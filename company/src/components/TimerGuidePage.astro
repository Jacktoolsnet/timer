---
import Layout from '../layouts/Layout.astro';
import AdBanner from './AdBanner.astro';
import GuideSeo from './GuideSeo.astro';
import RelatedTools from './RelatedTools.astro';
import ToolShowcase from './ToolShowcase.astro';
import { guideTranslator } from '../lib/guide-copy';
import { localizedToolUrl } from '../lib/company-copy';
import type { Language } from '../lib/i18n';
interface Props { lang?: Language }
const { lang = 'de' } = Astro.props;
const t = guideTranslator(lang);
---
<Layout lang={lang} title={t("Online-Timer: Countdown, Pomodoro und Intervalle erklärt")} description={t("Anleitung zum Jacktools Timer: Countdown einstellen, Pomodoro-Pausen planen und Intervalle nutzen. Mit praktischen Beispielen und Hinweisen zu Signaltönen und Speicherung.")} route="tools/timer/" homeAlternates={false} canonicalPath={"/"+lang+"/tools/timer/"} guideSlug="timer" socialImageProject="timer">
  <GuideSeo name={t("Timer")} headline={t("Ein Timer. Drei Arten, Zeit zu planen.")} description={t("Einmal herunterzählen, konzentriert arbeiten oder Aktivphasen und Pausen wiederholen: Der Jacktools Timer verbindet Countdown, Pomodoro und Intervalltimer in einer Browser-Anwendung.")} path={"/"+lang+"/tools/timer/"} lang={lang} toolUrl={localizedToolUrl("https://timer.jacktools.net/de/timer/",lang)} image="/images/timer/gallery/digital-green.png" />
  <a slot="header-action" class="timer-header-action" href={localizedToolUrl("https://timer.jacktools.net/de/timer/",lang)}>{t("Timer öffnen")}</a>
  <article class="timer-guide">
    <header class="guide-hero" data-print-title={"Jacktools.net · "+t("Timer-Anleitung")} data-print-url={"Online: https://jacktools.net/"+lang+"/tools/timer/"}>
      <div>
        <p class="eyebrow">{t("ZEIT & FOKUS · ANLEITUNG")}</p>
        <h1>{t("Ein Timer.")}<br/>{t("Drei Arten, Zeit zu planen.")}</h1>
        <p class="guide-lead">{t("Einmal herunterzählen, konzentriert arbeiten oder Aktivphasen und Pausen wiederholen: Der Jacktools Timer verbindet Countdown, Pomodoro und Intervalltimer in einer Browser-Anwendung. Hier erfährst du, welcher Modus zu deiner Aufgabe passt und wie du ihn einrichtest.")}</p>
        <div class="hero-mode-actions" role="group" aria-label={t("Timer-Modus öffnen")}>
          <a class="hero-mode-button" href={localizedToolUrl("https://timer.jacktools.net/de/timer/",lang)}><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="18" r="11"/><path d="M12 3h8M16 3v4M16 11v7l4 3M25 7l2 2"/></svg><span>{t("Countdown")}</span></a>
          <a class="hero-mode-button" href={localizedToolUrl("https://timer.jacktools.net/de/pomodoro/",lang)}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 13V5h8M19 5h8v8M27 19v8h-8M13 27H5v-8"/><circle cx="16" cy="16" r="5"/></svg><span>{t("Pomodoro")}</span></a>
          <a class="hero-mode-button" href={localizedToolUrl("https://timer.jacktools.net/de/training/",lang)}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 10h22l-5-5M27 22H5l5 5M8 15v3M16 14v5M24 15v3"/></svg><span>{t("Intervalle")}</span></a>
        </div>
      </div>
      <figure class="guide-preview"><div class="guide-dial"><span>{t("FOKUSZEIT")}</span><strong>25:00</strong><span>{t("Eine Aufgabe. Ein Zeitfenster.")}</span></div></figure>
    </header>
    <ToolShowcase lang={lang} />
    <nav class="guide-toc" aria-labelledby="guide-toc-title">
      <div class="toc-heading"><strong id="guide-toc-title">{t("In dieser Anleitung")}</strong></div>
      <div class="toc-grid">
        <a href="#modi"><span class="toc-title">{t("Modi im Vergleich")}</span><span class="toc-description">{t("Den richtigen Timer finden")}</span></a>
        <a href="#countdown"><span class="toc-title">{t("Countdown starten")}</span><span class="toc-description">{t("Eine Zeitspanne festlegen")}</span></a>
        <a href="#pomodoro"><span class="toc-title">{t("Mit Pomodoro arbeiten")}</span><span class="toc-description">{t("Fokus und Pausen verbinden")}</span></a>
        <a href="#intervalle"><span class="toc-title">{t("Intervalle planen")}</span><span class="toc-description">{t("Wiederkehrende Abläufe einrichten")}</span></a>
        <a href="#einstellungen"><span class="toc-title">{t("Ansicht & Speicherung")}</span><span class="toc-description">{t("Den Timer persönlich anpassen")}</span></a>
        <a href="#fragen"><span class="toc-title">{t("Fragen & Grenzen")}</span><span class="toc-description">{t("Antworten und wichtige Hinweise")}</span></a>
      </div>
    </nav>
    <section id="modi">
      <p class="eyebrow">{t("DIE RICHTIGE WAHL")}</p><h2>{t("Countdown, Pomodoro oder Intervalltimer?")}</h2>
      <p>{t("Entscheidend ist nicht nur die Dauer, sondern auch, was danach passieren soll. Ein Countdown endet nach einer einzelnen Zeitspanne. Pomodoro strukturiert Arbeit und Pausen, lässt dir aber die Kontrolle über den nächsten Start. Der Intervalltimer wechselt die vorbereiteten Phasen automatisch.")}</p>
      <div class="mode-grid">
        <div><h3>{t("Countdown")}</h3><p>{t("Für eine einzelne Aufgabe mit festem Ende: etwa zehn Minuten aufräumen, einen Kurzvortrag proben oder eine Teepause begrenzen.")}</p><a href={localizedToolUrl("https://timer.jacktools.net/de/timer/",lang)}>{t("Countdown öffnen")}</a></div>
        <div><h3>{t("Pomodoro")}</h3><p>{t("Für konzentrierte Arbeitsblöcke mit kurzen und langen Pausen. Jede neue Phase startest du selbst – du kannst also erst deine Notizen abschließen.")}</p><a href={localizedToolUrl("https://timer.jacktools.net/de/pomodoro/",lang)}>{t("Pomodoro öffnen")}</a></div>
        <div><h3>{t("Intervalltimer")}</h3><p>{t("Für wiederkehrende Aktivphasen und Pausen, etwa beim Üben oder bei einer Bewegungsroutine. Nach dem Start läuft die Phasenfolge automatisch.")}</p><a href={localizedToolUrl("https://timer.jacktools.net/de/training/",lang)}>{t("Intervalltimer öffnen")}</a></div>
      </div>
    </section>
    <AdBanner lang={lang} />
    <section id="countdown"><h2>{t("So stellst du einen Countdown ein")}</h2>
      <ol><li>{t("Öffne den ")}<a href={localizedToolUrl("https://timer.jacktools.net/de/timer/",lang)}>{t("Countdown-Timer")}</a>{t(" und trage Stunden, Minuten und Sekunden ein. Alternativ kannst du eine Schnellwahl verwenden.")}</li><li>{t("Bestätige eigene Zeitangaben mit „Einstellungen übernehmen“. Das setzt den aktuellen Countdown auf die gewählte Dauer zurück.")}</li><li>{t("Prüfe, ob der Signalton eingeschaltet und die Geräte-Lautstärke passend eingestellt ist. Starte den Countdown über die Start-Taste.")}</li><li>{t("Bei einer Unterbrechung kannst du pausieren und anschließend fortsetzen. Zurücksetzen beginnt wieder bei der eingestellten Dauer.")}</li></ol>
      <aside class="guide-example"><h3>{t("Beispiel: zehn Minuten Ordnung schaffen")}</h3><p>{t("Stelle 00 Stunden, 10 Minuten und 00 Sekunden ein. Nimm dir nur eine Fläche vor, etwa den Schreibtisch. Wenn die Zeit abgelaufen ist, entscheide bewusst, ob du fertig bist oder einen neuen Durchgang starten möchtest. Der Countdown wiederholt sich nicht automatisch.")}</p></aside>
      <p><strong>{t("Wichtig bei Änderungen:")}</strong>{t(" Eine Schnellwahl oder das Übernehmen neuer Einstellungen setzt den aktuellen Timer zurück. Pausiere nicht nur, wenn du die bisherige Restzeit behalten möchtest – ändere die Dauer in diesem Fall erst nach dem Durchgang.")}</p>
    </section>
    <section id="pomodoro"><h2>{t("Fokus und Pausen mit Pomodoro planen")}</h2>
      <p>{t("Im Pomodoro-Modus legst du Fokuszeit, kurze Pause, lange Pause und die Anzahl der Fokusrunden bis zur langen Pause fest. Voreingestellt sind 25 Minuten Fokus, 5 Minuten kurze Pause und 15 Minuten lange Pause nach vier Fokusrunden. Das ist ein Ausgangspunkt, keine feste Vorgabe für deinen Arbeitstag.")}</p>
      <ol><li>{t("Formuliere vor dem Start eine überschaubare Aufgabe, zum Beispiel: „Den ersten Abschnitt überarbeiten“ statt „Das ganze Projekt fertigstellen“.")}</li><li>{t("Öffne ")}<a href={localizedToolUrl("https://timer.jacktools.net/de/pomodoro/",lang)}>{t("Pomodoro")}</a>{t(", passe bei Bedarf Zeiten und Rundenzahl an und übernimm die Einstellungen.")}</li><li>{t("Starte die Fokusphase. Notiere auftauchende Nebenaufgaben, statt sofort zu ihnen zu wechseln.")}</li><li>{t("Nach Ablauf startet die Pause nicht von selbst. Starte die nächste Phase, wenn du bereit bist. „Nächste Phase“ überspringt die aktuelle Phase, wartet aber ebenfalls auf deinen Start.")}</li></ol>
      <aside class="guide-example"><h3>{t("Beispiel: vier Arbeitsblöcke")}</h3><p>{t("Mit den Standardwerten ergeben vier Fokusphasen 100 Minuten Arbeitszeit. Dazwischen liegen drei kurze Pausen mit zusammen 15 Minuten; anschließend folgt die lange Pause mit 15 Minuten. Mit allen Pausen sind das 130 Minuten – zuzüglich deiner manuellen Übergänge.")}</p></aside>
      <p>{t("Die Pomodoro-Anzeige zeigt standardmäßig aufgerundete Minuten und in der letzten Minute Sekunden. Wenn du die genaue Restzeit durchgehend sehen möchtest, kannst du die Sekundenanzeige einschalten.")}</p>
    </section>
    <section id="intervalle"><h2>{t("Wiederkehrende Abläufe mit dem Intervalltimer")}</h2>
      <p>{t("Im Intervallmodus stellst du eine optionale Vorbereitung, die Dauer der Aktivphase, die Pause und die Rundenzahl ein. Die Zeitangaben erfolgen in Sekunden. Anders als bei Pomodoro laufen die Phasen nach dem Start automatisch nacheinander ab. Nach der letzten Aktivphase entfällt die Pause.")}</p>
      <aside class="guide-example"><h3>{t("Beispiel: eine kurze Übungsroutine")}</h3><p>{t("Wähle 10 Sekunden Vorbereitung, 60 Sekunden Aktivphase, 20 Sekunden Pause und 4 Runden. Der Ablauf dauert insgesamt 5 Minuten und 10 Sekunden: 10 Sekunden Vorbereitung + 4 × 60 Sekunden Aktivität + 3 × 20 Sekunden Pause.")}</p></aside>
      <p>{t("Optional helfen Signale für die letzten Sekunden und ein Halbzeit-Signal während der Aktivphase bei der Orientierung. Teste die Töne einmal, bevor du dich auf einen Ablauf verlässt. Mit „Bildschirm wach halten“ kann der Timer auf unterstützten Geräten das Abschalten des Displays während des Laufens verhindern. Das ersetzt keine Prüfung der Geräte- und Browser-Einstellungen.")}</p>
      <a class="text-link" href={localizedToolUrl("https://timer.jacktools.net/de/training/",lang)}>{t("Eigene Intervalle einstellen")}</a>
    </section>
    <section id="einstellungen"><h2>{t("Ansicht und lokale Einstellungen")}</h2>
      <p>{t("Die Fokusansicht rückt die Zeitanzeige in den Mittelpunkt; mit Escape verlässt du sie wieder. Im Einstellungsmenü kannst du unter anderem helle oder dunkle Darstellung, Farben und Schriftgröße anpassen. So lässt sich der Timer auf dem Schreibtisch oder auf einem weiter entfernten Bildschirm besser ablesen.")}</p>
      <p>{t("Wenn du die lokale Speicherung erlaubst, werden Timer-Einstellungen im Browserspeicher abgelegt. Ohne diese Zustimmung gelten Änderungen nur für den aktuellen Besuch. Dafür brauchst du kein Benutzerkonto. Die gespeicherten Werte werden nicht mit einem anderen Gerät synchronisiert. Wenn der Browser die Speicherung blockiert oder du seine Website-Daten löschst, stehen sie beim nächsten Besuch möglicherweise nicht mehr bereit.")}</p>
      <p><strong>{t("Gespeicherte Einstellungen sind kein gespeicherter Lauf:")}</strong>{t(" Beim Neuladen der Seite oder einem Seitenwechsel wird ein laufender Countdown nicht fortgesetzt. Lass die Timer-Seite während der Nutzung geöffnet.")}</p>
    </section>
    <section id="fragen"><h2>{t("Häufige Fragen und wichtige Grenzen")}</h2>
      <details open><summary>{t("Warum höre ich keinen Signalton?")}</summary><p>{t("Prüfe die Ton-Einstellung im Timer, die Lautstärke und ob der Browser-Tab stummgeschaltet ist. Der Ton benötigt eine Benutzerinteraktion, etwa den Start des Timers. Im Hintergrund, bei gesperrtem Gerät oder im Energiesparmodus können Signale verzögert werden oder ausbleiben. Teste einen kurzen Countdown bei sichtbarer Seite.")}</p></details>
      <details><summary>{t("Läuft der Timer bei geschlossenem Browser weiter?")}</summary><p>{t("Verlasse dich darauf nicht. Ein geschlossener Browser oder ein schlafendes Gerät kann nicht zuverlässig alarmieren. Nutze für wichtige Termine einen dafür vorgesehenen Wecker. Der Browser-Timer ist nicht für sicherheitskritische Aufgaben gedacht.")}</p></details>
      <details><summary>{t("Wie wird die verbleibende Zeit berechnet?")}</summary><p>{t("Der Countdown berechnet die Restzeit aus einem festen Endzeitpunkt, statt nur bei jedem Programmtakt eine Sekunde abzuziehen. Das reduziert schleichende Abweichungen durch verzögerte Aktualisierungen. Änderungen der Systemuhr können den Countdown trotzdem beeinflussen; auch ein pünktlicher Signalton ist im Hintergrund nicht garantiert.")}</p></details>
      <details><summary>{t("Welcher Modus startet die nächste Phase automatisch?")}</summary><p>{t("Der Intervalltimer wechselt automatisch zwischen Vorbereitung, Aktivphasen und Pausen. Bei Pomodoro beginnst du jede neue Phase manuell. Ein normaler Countdown endet nach der eingestellten Zeit, ohne automatisch einen neuen Durchgang zu starten.")}</p></details>
      <details><summary>{t("Wann brauche ich statt des Timers eine Stoppuhr?")}</summary><p>{t("Ein Timer zählt eine vorher festgelegte Zeit herunter. Wenn du erst herausfinden möchtest, wie lange eine Aufgabe dauert, nutze die ")}<a href={localizedToolUrl("https://stopwatch.jacktools.net/de/",lang)}>{t("Jacktools Stoppuhr")}</a>{t(": Sie misst die verstrichene Zeit vorwärts.")}</p></details>
    </section>
    <footer class="guide-end" aria-labelledby="start-heading">
      <p class="eyebrow">{t("DEINE ZEIT. DEIN RHYTHMUS.")}</p>
      <h2 id="start-heading">{t("Wie möchtest du starten?")}</h2>
      <p class="start-intro">{t("Eine einzelne Aufgabe, konzentrierte Arbeitsblöcke oder wiederkehrende Abläufe: Wähle den passenden Modus und richte deine Zeit ein.")}</p>
      <div class="start-grid">
        <div class="start-card">
          <span class="start-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><circle cx="16" cy="18" r="11"/><path d="M12 3h8M16 3v4M16 11v7l4 3M25 7l2 2"/></svg></span>
          <h3>{t("Countdown")}</h3><p>{t("Ein Zeitfenster für eine Aufgabe. Dauer einstellen, starten und die verbleibende Zeit im Blick behalten.")}</p>
          <a class="primary" href={localizedToolUrl("https://timer.jacktools.net/de/timer/",lang)}>{t("Countdown starten")}</a>
        </div>
        <div class="start-card">
          <span class="start-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M5 13V5h8M19 5h8v8M27 19v8h-8M13 27H5v-8"/><circle cx="16" cy="16" r="5"/></svg></span>
          <h3>{t("Pomodoro")}</h3><p>{t("Fokus und Erholung verbinden. Arbeitsblöcke mit kurzen und langen Pausen in deinem Tempo planen.")}</p>
          <a class="primary" href={localizedToolUrl("https://timer.jacktools.net/de/pomodoro/",lang)}>{t("Pomodoro starten")}</a>
        </div>
        <div class="start-card">
          <span class="start-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M5 10h22l-5-5M27 22H5l5 5M8 15v3M16 14v5M24 15v3"/></svg></span>
          <h3>{t("Intervalle")}</h3><p>{t("Deinen Ablauf vorbereiten. Aktivphasen und Pausen festlegen und automatisch nacheinander laufen lassen.")}</p>
          <a class="primary" href={localizedToolUrl("https://timer.jacktools.net/de/training/",lang)}>{t("Intervalle starten")}</a>
        </div>
      </div>
      <div class="start-bottom"><a href={"/"+lang+"/#online-timer"}>{t("Zur Toolübersicht")}</a><p>{t("Eine Funktion fehlt oder etwas ist unklar? ")}<a href="mailto:jacktoolsnet@gmail.com">{t("Schreib uns dein Feedback.")}</a></p></div>
    </footer>
    <RelatedTools current="timer" lang={lang} />
  </article>

</Layout>
<script>
  let closedAnswers: HTMLDetailsElement[] = [];
  window.addEventListener('beforeprint', () => {
    closedAnswers = Array.from(document.querySelectorAll<HTMLDetailsElement>('.timer-guide details:not([open])'));
    closedAnswers.forEach(answer => { answer.open = true; });
  });
  window.addEventListener('afterprint', () => {
    closedAnswers.forEach(answer => { answer.open = false; });
    closedAnswers = [];
  });
</script>
<style>
  .timer-guide{font-size:calc(1rem * var(--font-scale,1));line-height:1.85;padding-bottom:3rem;overflow-wrap:anywhere}
  .timer-guide a:not(.primary):not(.hero-mode-button){color:var(--accent);text-decoration:underline;text-underline-offset:.22em}
  .tool-screenshot{margin:1.5rem 0 2rem;padding:1.25rem;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
  .tool-screenshot a{display:block;max-width:820px;margin:auto;border-radius:4px;overflow:hidden}.tool-screenshot a:focus-visible{outline:3px solid var(--accent);outline-offset:4px}.tool-screenshot img{display:block;width:100%;height:auto}.tool-screenshot figcaption{margin:1rem auto 0;max-width:820px;color:var(--muted);font-size:.9em;line-height:1.7}.tool-screenshot figcaption strong{color:var(--text)}
  @media(max-width:760px){.tool-screenshot{padding:.65rem}.tool-screenshot figcaption{font-size:.875em}}
  .hero-mode-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.6rem}
  .timer-guide .hero-mode-button{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:48px;padding:.75rem 1rem;border:1px solid var(--accent);border-radius:8px;background:var(--accent);color:var(--surface);font-weight:600;text-decoration:none;line-height:1.4}
  .hero-mode-button svg{width:24px;height:24px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .timer-guide .hero-mode-button:hover{filter:brightness(1.1)}.timer-guide .hero-mode-button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
  [data-style=technical] .hero-mode-button{border-radius:3px}
  @media(max-width:480px){.hero-mode-actions{display:grid;grid-template-columns:minmax(0,1fr)}.timer-guide .hero-mode-button{justify-content:flex-start}}
  :global(.header-nav-links:has(.timer-header-action)){grid-template-columns:repeat(3,minmax(0,1fr))}
  :global(.header-nav .header-nav-links a.timer-header-action){background:var(--accent);color:var(--surface);font-weight:650;text-decoration:none}
  :global(.header-nav .header-nav-links a.timer-header-action:hover){background:var(--accent);color:var(--surface);filter:brightness(1.1)}
  :global(.header-nav .header-nav-links a.timer-header-action:focus-visible){outline:3px solid var(--accent);outline-offset:3px}
  .guide-hero{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:2.5rem;align-items:center;padding:2rem 0 3rem}
  .timer-guide h1{font-size:calc(clamp(2rem,4vw,3.3rem) * var(--font-scale,1));line-height:1.18;letter-spacing:-.04em;margin:1.2rem 0}
  .guide-lead{color:var(--muted)}.guide-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1.5rem;margin:1.5rem 0}.guide-actions .primary{font-size:inherit}
  .guide-meta,.guide-preview figcaption{font-size:.9em;color:var(--muted)}.guide-preview{margin:0;text-align:center}.guide-preview figcaption{margin-top:1.5rem}
  .guide-dial{aspect-ratio:1;max-width:290px;margin:auto;border:8px solid var(--accent-soft);border-top-color:var(--accent);border-right-color:var(--accent);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.6rem;background:var(--surface)}.guide-dial strong{font-size:3.5em;font-weight:500;line-height:1.2;font-variant-numeric:tabular-nums}.guide-dial span{font-size:.875em;color:var(--muted)}
  .guide-toc{padding:1.5rem;border:1px solid var(--line);border-radius:16px;background:linear-gradient(135deg,var(--surface),var(--accent-soft))}
  .toc-heading{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:.25rem 1rem;margin-bottom:1.2rem}.toc-heading strong{font-size:1.15em}.toc-heading>span{font-size:.875em;color:var(--muted)}
  .toc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}
  .timer-guide .toc-grid a{display:flex;flex-direction:column;justify-content:center;gap:.2rem;min-width:0;min-height:88px;padding:1rem 1.15rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);text-decoration:none;transition:border-color .15s,background .15s,box-shadow .15s}
  .toc-title{font-weight:600;line-height:1.5}.toc-description{font-size:.875em;line-height:1.6;color:var(--muted)}
  .timer-guide .toc-grid a:hover{border-color:var(--accent);background:var(--accent-soft)}.timer-guide .toc-grid a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
  [data-style=technical] .guide-toc,[data-style=technical] .toc-grid a{border-radius:3px}
  @media(min-width:761px) and (max-width:1000px){.toc-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(prefers-reduced-motion:reduce){.timer-guide .toc-grid a{transition:none}}
  .timer-guide section{padding:2.5rem 0;border-bottom:1px solid var(--line);scroll-margin-top:2rem}.timer-guide h2{font-size:1.8em;line-height:1.3;margin:0 0 1.2rem}.timer-guide h3{font-size:1.15em;line-height:1.4;margin:0 0 .8rem}.timer-guide li{padding-left:.4rem;margin:.8rem 0}.timer-guide ol{padding-left:1.5rem}
  .mode-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;margin:1.8rem 0}.mode-grid>div{padding:1.5rem;border:1px solid var(--line);background:var(--surface)}
  .guide-example{border-left:4px solid var(--accent);padding:1.5rem;background:var(--accent-soft);margin:1.8rem 0}.guide-example p{margin-bottom:0}
  .timer-guide details{border-top:1px solid var(--line);padding:1rem 0}.timer-guide summary{font-weight:600;cursor:pointer;min-height:44px;align-content:center}.guide-end{padding-top:3rem}.timer-guide .eyebrow{justify-content:flex-start;font-size:.875em}
  @media(max-width:760px){.guide-hero,.mode-grid{grid-template-columns:minmax(0,1fr)}.guide-hero{padding-top:0;gap:1rem}.guide-preview{max-width:320px;justify-self:center;width:100%}.guide-toc{padding:1rem}.toc-grid{grid-template-columns:minmax(0,1fr)}.timer-guide h2{font-size:1.5em}.guide-dial strong{font-size:3em}}
  .guide-end{margin-top:2rem;padding:2rem;border:1px solid var(--line);border-radius:16px;background:linear-gradient(135deg,var(--accent-soft),var(--surface))}
  .start-intro{color:var(--muted)}.start-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.75rem}
