---
import Layout from '../layouts/Layout.astro';
import NullTopicIllustration from './NullTopicIllustration.astro';
import {blogUi} from '../lib/blog-ui';
import type { BlogPost } from '../lib/blog';
interface Props { post:BlogPost; chapters:string[][] }
const {post,chapters}=Astro.props;
const lang=post.lang;
const ui=blogUi[lang];
const url=new URL(post.path,Astro.site).href;
const organization={'@type':'Organization','@id':new URL('/#organization',Astro.site).href,name:'JackTools.Net',url:new URL('/',Astro.site).href};
---
<Layout lang={lang} title={post.title} description={post.description} route={post.path.slice(4)} homeAlternates={false} canonicalPath={post.path} blogKey={post.key} quietBackground ogType="article">
 <a slot="header-action" class="blog-header-link" href={`/${lang}/blog/`}>{ui.back}</a>
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':[organization,{'@type':'WebPage','@id':url,url,name:post.title,inLanguage:lang,mainEntity:{'@id':url+'#artikel'}},{'@type':'BlogPosting','@id':url+'#artikel',headline:post.title,description:post.description,inLanguage:lang,mainEntityOfPage:{'@id':url},author:{'@id':organization['@id']},publisher:{'@id':organization['@id']},image:new URL(post.image,Astro.site).href,isPartOf:{'@type':'Blog',url:new URL(`/${lang}/blog/`,Astro.site).href,name:'Jacktools Blog'},about:{'@type':'Thing',name:(post.key==='clock'||post.key==='binary')?'Jacktools Clock':'NullTopic'}}]}).replaceAll('<','\\u003c')} />
 <article class="blog-article">
  <div class="article-layout">
   <header class="article-header">
    <p class="article-kicker">{post.category.toLocaleUpperCase(lang)}</p>
    <h1>{post.title}</h1>
    <p class="article-lead">{post.lead}</p>
    <p class="article-byline"><span>{ui.by}</span><span>{post.byline}</span></p>
   </header>
   <figure class="article-cover">{(post.art==='clock'||post.art==='binary')?<img src={post.image} alt={post.coverCaption} width="1000" height="620" style="display:block;width:100%;height:auto" />:<NullTopicIllustration variant={post.art} lang={lang} />}<figcaption>{post.coverCaption}</figcaption></figure>
   <aside class="article-sidebar"><nav aria-labelledby="article-toc-title"><h2 id="article-toc-title">{ui.toc}</h2><ol>{chapters.map(([id,title])=><li><a href={'#'+id}>{title}</a></li>)}</ol></nav></aside>
   <div class="article-body">
    <slot />
    {Astro.slots.has('series') && <nav class="article-series" aria-label={ui.series}><slot name="series" /></nav>}
    <footer class="article-footer"><p>{ui.question}</p><a href="mailto:jacktoolsnet@gmail.com">{ui.feedback}</a><a href={`/${lang}/blog/`}>{ui.all}</a></footer>
   </div>
  </div>
 </article>
</Layout>
<style is:global>
.blog-article{font-size:calc(1rem * var(--font-scale,1));line-height:1.9;overflow-wrap:anywhere;padding:3.5rem 0 4rem}.article-header{grid-area:header;min-width:0;max-width:900px;margin:0 auto 2rem}.article-kicker{font-size:.8em;font-weight:650;letter-spacing:.12em;color:var(--accent);margin:0 0 1rem}.article-header h1{font-size:clamp(2.4em,4.8vw,4em);letter-spacing:-.04em;line-height:1.12;margin:0 0 1.5rem}.article-lead{font-size:1.15em;color:var(--muted);line-height:1.8;margin:0 0 1.5rem}.article-byline{display:flex;gap:.5rem 1.5rem;flex-wrap:wrap;font-size:.85em;color:var(--muted);margin:0}.article-byline>span:first-child{font-weight:650;color:var(--text)}
.article-cover{grid-area:cover;min-width:0;width:100%;max-width:940px;margin:0 auto 3rem}.article-cover figcaption,.article-diagram figcaption{font-size:.85em;line-height:1.7;color:var(--muted);margin:.8rem 0 0;max-width:none}.article-layout{display:grid;grid-template-columns:220px minmax(0,1fr);grid-template-areas:"toc header" "toc cover" "toc body";column-gap:3rem;align-items:start}.article-sidebar{grid-area:toc;align-self:start;position:sticky;top:calc(var(--masthead-height,150px) + 2rem);font-size:.85em;line-height:1.6}.article-sidebar nav{border-top:2px solid var(--accent);padding-top:1rem}.article-sidebar h2{font-size:1em;margin:0 0 1rem}.article-sidebar ol{list-style:none;padding:0;margin:0;display:grid;gap:.35rem}.article-sidebar a{display:block;padding:.55rem 0;color:var(--muted);text-decoration:none}.article-sidebar a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:.2em}
.article-body{grid-area:body;width:100%;max-width:none;min-width:0}.article-body section{scroll-margin-top:calc(var(--masthead-height,150px) + 1rem);margin-bottom:2.75rem}.article-body h2{font-size:1.7em;line-height:1.3;letter-spacing:-.025em;margin:0 0 1.2rem;text-wrap:balance}.article-body p{margin:0 0 1.25rem}.article-body a{color:var(--accent);text-decoration:underline;text-underline-offset:.2em}.article-note{border-left:3px solid var(--accent);padding:1.3rem 1.5rem;background:var(--accent-soft);margin:1.8rem 0}.article-note .note-label{font-size:.8em;font-weight:650;color:var(--accent);margin:0 0 .6rem}.article-note p:last-child{margin:0}.article-diagram{margin:0 0 2.75rem}.conversation-example{list-style:none;padding:0;display:grid;gap:1rem;margin:1.75rem 0}.conversation-example li{padding:1.3rem 1.5rem;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.example-agent{display:flex;align-items:center;gap:.8rem;margin-bottom:.75rem}.example-agent>span{display:grid;place-items:center;width:36px;height:36px;flex:0 0 36px;background:var(--accent-soft);color:var(--accent);border-radius:10px;font-weight:650}.conversation-example p{margin:0}.article-body blockquote{margin:2rem 0;padding:1.5rem 0;border-block:1px solid var(--line);color:var(--accent);font-size:1.45em;line-height:1.5;font-weight:550}.article-body blockquote p{margin:0}.open-questions{margin:1.5rem 0}.open-questions>div{padding:1.25rem 0;border-top:1px solid var(--line)}.open-questions dt{font-weight:650;line-height:1.6}.open-questions dd{margin:.6rem 0 0;color:var(--muted)}.article-conclusion{border-top:2px solid var(--accent);padding-top:2rem}.article-series{padding:1.5rem;border:1px solid var(--line);background:var(--accent-soft);border-radius:12px;margin:2rem 0}.article-series p{margin:0 0 .5rem}.article-series a{display:block;font-weight:600}.article-footer{border-top:1px solid var(--line);padding-top:1.5rem;display:flex;flex-wrap:wrap;gap:.75rem 2rem;font-size:.9em}.article-footer p{width:100%;margin:0}
:is(.header-nav-links:has(.blog-header-link)){grid-template-columns:repeat(3,minmax(0,1fr))}
:is([data-style=technical]) .conversation-example li,:is([data-style=technical]) .example-agent>span{border-radius:3px}
@media(max-width:1000px){.article-layout{grid-template-columns:minmax(0,1fr);grid-template-areas:"header" "cover" "toc" "body";row-gap:0}.article-sidebar{margin-bottom:2rem}.article-sidebar{position:static}.article-sidebar ol{grid-template-columns:repeat(2,minmax(0,1fr));gap:.25rem 1.5rem}.article-body{margin:auto;width:100%}}
@media(max-width:600px){.blog-article{padding-top:2rem}.article-header h1{font-size:2.2em}.article-lead{font-size:1.05em}.article-sidebar ol{grid-template-columns:minmax(0,1fr)}.article-body h2{font-size:1.5em}.article-note,.conversation-example li{padding:1rem}.article-cover{margin-bottom:2rem}}
@page blog-article{size:A4;margin:16mm}
@media print{
:is(body:has(.blog-article)){page:blog-article;background:#fff!important;color:#000!important}:is(body:has(.blog-article) .site-header),:is(body:has(.blog-article) .site-footer),:is(body:has(.blog-article) .ambient-background),:is(body:has(.blog-article) .skip-link),:is(body:has(.blog-article) dialog),:is(body:has(.blog-article) [data-ad-placement]){display:none!important}
:is(body:has(.blog-article) .site-shell),:is(body:has(.blog-article) main){width:auto!important;max-width:none!important;margin:0!important;padding:0!important;min-height:0!important}
.blog-article{font:11pt/1.5 Arial,sans-serif;padding:0;color:#000;--surface:#fff;--text:#000;--accent:#333;--accent-soft:#f3f3f3;--muted:#444;--line:#aaa}.article-header{margin-bottom:5mm}.article-header h1{font-size:26pt;letter-spacing:normal}.article-lead{font-size:12pt}.article-byline{font-size:9pt}.article-cover{margin:0 0 6mm}.article-cover :is(svg){max-height:64mm}.article-cover figcaption,.article-diagram figcaption{font-size:9pt}.article-layout{display:block}.article-sidebar,.article-footer,.article-series{display:none}.article-body{max-width:none}.article-body section{margin-bottom:6mm}.article-body h2{font-size:16pt;break-after:avoid-page}.article-body p{margin:0 0 3mm;orphans:3;widows:3}.article-note,.article-diagram,.conversation-example li,.open-questions>div{break-inside:avoid-page}.article-note{margin:4mm 0;padding:3mm}.conversation-example{gap:3mm}.conversation-example li{padding:3mm}.article-body blockquote{font-size:14pt;margin:4mm 0;padding:3mm 0}.article-conclusion{padding-top:5mm}.article-body a{color:#000}.article-sources a[href^="https://"]::after{content:" (" attr(href) ")";font-size:9pt;font-weight:normal;overflow-wrap:anywhere}
}
</style>
