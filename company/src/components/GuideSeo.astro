---
import type { Language } from '../lib/i18n';
interface Props { lang?:Language; name:string; headline:string; description:string; path:string; toolUrl:string; image:string }
const {name,headline,description,path,toolUrl,image,lang='de'} = Astro.props;
const url = new URL(path,Astro.site).href;
const organization = {'@type':'Organization','@id':new URL('/#organization',Astro.site).href,name:'JackTools.Net',url:new URL('/',Astro.site).href};
const articleId = url+'#anleitung';
const graph = {
  '@context':'https://schema.org',
  '@graph':[
    organization,
    {'@type':'WebPage','@id':url,url,name:headline,inLanguage:lang,isPartOf:{'@type':'WebSite',name:'JackTools.Net',url:new URL('/',Astro.site).href},mainEntity:{'@id':articleId}},
    {'@type':'Article','@id':articleId,headline,description,inLanguage:lang,mainEntityOfPage:{'@id':url},author:{'@id':organization['@id']},publisher:{'@id':organization['@id']},image:new URL(image,Astro.site).href,about:{'@type':'Thing',name,url:toolUrl}},
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(graph).replaceAll('<','\\u003c')} />
