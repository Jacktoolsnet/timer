---
import {toolRedirects} from '../lib/tool-redirects';
export function getStaticPaths(){return Object.entries(toolRedirects).map(([tool,target])=>({params:{tool},props:{target}}));}
interface Props {target:string}
const {target}=Astro.props;
---
<!doctype html>
<html lang="de">
 <head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Weiterleitung · Jacktools</title>
  <meta name="robots" content="noindex, follow"/>
  <link rel="canonical" href={target}/>
  <meta http-equiv="refresh" content={'0;url='+target}/>
 </head>
 <body>
  <p>Du wirst zum Tool weitergeleitet: <a id="tool-destination" href={target}>{target}</a></p>
  <script is:inline>
   const destination=document.getElementById('tool-destination').href;
   window.location.replace(destination+window.location.search+window.location.hash);
  </script>
 </body>
</html>
