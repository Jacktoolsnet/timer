---
import RelaxPreview from '../components/RelaxPreview.astro';
import Layout from '../layouts/Layout.astro';
const spotlights = [
 {id:'timer',name:'Timer',title:'Zeit für das Wesentliche.',lead:'Countdown, Pomodoro oder automatische Intervalle: Plane konzentrierte Arbeit, Pausen und eigene Routinen mit einem anpassbaren Online-Timer.',url:'https://timer.jacktools.net/de/',action:'Direkt zum Timer',caption:'Fokus und Pausen',value:'25:00',note:'Eine Sache nach der anderen.'},
 {id:'clock',name:'Uhr',title:'Deine Zeit. Auf einen Blick.',lead:'Analog, digital oder mit Klappzahlen: Gestalte deine Uhr so, wie sie zu deinem Alltag passt – mit Datum, Zeitzonen und Fokusansicht.',url:'https://clock.jacktools.net/de/',action:'Direkt zur Uhr',caption:'Uhrzeit und Datum',value:'10:24',note:'Deine Uhr. Dein Stil.'},
 {id:'stopwatch',name:'Online-Stoppuhr',title:'Jeder Moment zählt.',lead:'Behalte verstrichene Zeit und Runden im Blick. Eine übersichtliche Stoppuhr für deine kleinen und großen Vorhaben, direkt im Browser.',url:'https://stopwatch.jacktools.net/de/',action:'Direkt zur Stoppuhr',caption:'Zeit im Blick',value:'01:24.36',note:'Starten. Stoppen. Überblick behalten.'},
 {id:'breathe',name:'Breathe',title:'Ein Atemzug. Ein Moment für dich.',lead:'Nimm dir eine ruhige Pause. Breathe begleitet dich mit einstellbaren Atemmustern, einer sanften Kreisanimation und optionalen Atemgeräuschen – ohne Druck.',url:'https://breathe.jacktools.net/de/',action:'Direkt zu Breathe',caption:'Dein Atem. Dein Tempo.',value:'4',note:'Atme sanft und so, wie es angenehm ist.'},
 {id:'relax',name:'Relax',title:'Ruhige Klänge. Dein Moment.',lead:'Gestalte deine eigene Klanglandschaft: sanfte Instrumente, Sommerregen, Wind, Lagerfeuer und Meeresrauschen. Dazu ruhige Animationen – ganz nach deinem Geschmack.',url:'https://relax.jacktools.net/de/',action:'Direkt zu Relax',caption:'Klänge und sanfte Bewegung',value:'relax',note:'Zuhören. Zuschauen. Zur Ruhe kommen.'},
 {id:'message',name:'MessageDrop',title:'Die Welt hat etwas zu erzählen.',lead:'Hinterlasse Nachrichten an realen Orten auf einer globalen Karte und entdecke, was andere dort teilen. Raum für Nachrichten, Bilder und neue Perspektiven.',url:'https://app.messagedrop.de',action:'Direkt zu MessageDrop',caption:'Orte und Nachrichten',value:'MessageDrop',note:'Nachrichten, die ihren Platz finden.'},
 {id:'calculator',name:'Taschenrechner',title:'Jeder Rechenschritt bleibt nachvollziehbar.',lead:'Rechne mit einem editierbaren Rechenstreifen: Prozentwerte, Aufschläge und Steuern lassen sich Schritt für Schritt verfolgen, ändern und als Datei sichern.',url:'https://calculator.jacktools.net/de/',action:'Direkt zum Taschenrechner',caption:'Rechnen mit Überblick',value:'144,00',note:'Deine Zahlen. Dein Rechenweg.'},
];
---
<Layout lang="de" title="Online-Tools: Timer, Uhr & Entspannung" description="Kostenlose Online-Tools ohne Anmeldung: Countdown, Pomodoro, Intervalltimer, Uhr, Stoppuhr und Taschenrechner sowie Atemübungen mit Breathe und Naturgeräusche mit Relax." route="">
  <script type="application/ld+json" set:html={JSON.stringify({
   '@context':'https://schema.org','@graph':[
    {'@type':'Organization','@id':'https://jacktools.net/#organization',name:'Jacktools',url:'https://jacktools.net/'},
    {'@type':'WebSite','@id':'https://jacktools.net/#website',name:'Jacktools',alternateName:'jacktools.net',url:'https://jacktools.net/',inLanguage:'de',publisher:{'@id':'https://jacktools.net/#organization'}},
    {'@type':'ItemList','@id':'https://jacktools.net/#tools',name:'Online-Tools für Zeit, Fokus und Entspannung',itemListElement:[
     ['Online-Timer','https://timer.jacktools.net/de/'],['Online-Uhr mit Datum','https://clock.jacktools.net/de/'],
     ['Online-Stoppuhr mit Rundenzeiten','https://stopwatch.jacktools.net/de/'],['Online-Taschenrechner mit Rechenstreifen','https://calculator.jacktools.net/de/'],['Breathe – Atemübungen online','https://breathe.jacktools.net/de/'],
     ['Relax – Naturgeräusche und Klänge','https://relax.jacktools.net/de/'],['MessageDrop – Nachrichten auf der Karte','https://app.messagedrop.de']
    ].map(([name,url],i)=>({'@type':'ListItem',position:i+1,name,url}))}
   ]
  })} />
  <section class="company-hero" id="company-spotlight" data-tool="timer">
    <div class="hero-copy"><p class="eyebrow">KLEINE TOOLS. GROSSE IDEEN.</p><h1>Online-Tools<br />für deinen <em>Alltag.</em></h1><p class="hero-slogan">Weniger Ablenkung. Mehr Möglichkeiten.</p><p class="hero-lead">Ein guter Helfer muss nicht kompliziert sein. Entdecke Tools für konzentrierte Momente, neue Routinen und Nachrichten, die ihren Platz in der Welt finden.</p><div class="hero-actions"><a class="primary" href="#tools">Unsere Tools entdecken <span aria-hidden="true">↓</span></a><a class="text-link" href="https://timer.jacktools.net/de/" rel="noreferrer">Direkt zum Timer ↗</a></div><p class="hero-note">Für deinen Browser gemacht. In deinem Stil gestaltet.</p></div>
    <div class="hero-art" aria-label="Illustration: Zeit für das Wesentliche"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><div class="art-label">EIN MOMENT FÜR DICH</div><div class="preview-clock"><span>FOKUS</span><strong>25:00</strong><span>Eine Sache nach der anderen.</span></div><span class="floating-label label-focus">◷ Zeit für Fokus</span><span class="floating-label label-message">↗ Raum für Ideen</span><p class="art-footnote">Weniger ist manchmal genau richtig.</p></div>
  </section>
  {spotlights.map(tool=><template data-spotlight={tool.id}>
    <div class="hero-copy"><p class="eyebrow">IM SPOTLIGHT · {tool.name.toUpperCase()}</p><h1>Online-Tools<br />für deinen <em>Alltag.</em></h1><p class="hero-slogan">{tool.title}</p><p class="hero-lead">{tool.lead}</p><div class="hero-actions"><a class="primary" href="#tools">Unsere Tools entdecken <span aria-hidden="true">↓</span></a><a class="text-link" href={tool.url} rel="noreferrer">{tool.action} ↗</a></div><p class="hero-note">Für deinen Browser gemacht. In deinem Stil gestaltet.</p></div>
    <div class:list={['hero-art','spotlight-art','spotlight-'+tool.id]} role="img" aria-label={'Statische Vorschau: '+tool.name}>
      <span class="orbit orbit-one" aria-hidden="true"></span><span class="orbit orbit-two" aria-hidden="true"></span>
      <div class="art-label">{tool.caption}</div>
      {tool.id === 'relax' ? <RelaxPreview/> : tool.id === 'breathe' ? <div class="spotlight-breathe-scene" aria-hidden="true"><div class="company-breathe-scene"><svg viewBox="0 0 100 100" class="company-breathe-ring"><circle cx="50" cy="50" r="48"/><circle class="company-breathe-progress" cx="50" cy="50" r="48" pathLength="100"/></svg><div class="company-breathe-circle"></div><div class="company-breathe-tile"><span>Einatmen</span><strong>4</strong></div></div></div> : tool.id === 'clock' ? <div class="spotlight-clock-scene" aria-hidden="true"><svg viewBox="0 0 240 240" class="company-clock-dial"><circle cx="120" cy="120" r="110"/>{Array.from({length:60},(_,i)=><path d={i%5===0?'M120 20v10':'M120 16v4'} transform={'rotate('+i*6+' 120 120)'} class={i%5===0?'spotlight-hour-mark':'spotlight-minute-mark'}/>)}{Array.from({length:12},(_,i)=>{const n=i+1,a=n*Math.PI/6;return <text x={120+80*Math.sin(a)} y={120-80*Math.cos(a)} class="spotlight-clock-number">{n}</text>})}<path class="company-hour-hand" d="M120 120 78 87"/><path class="company-minute-hand" d="M120 120 163 179"/><circle class="company-clock-hub" cx="120" cy="120" r="4"/></svg></div> : tool.id === 'calculator' ? <div class="company-calculation" aria-hidden="true"><span>DEIN RECHENWEG</span><div><span>Startwert</span><b>100,00</b></div><div><span>+ 20 %</span><b>120,00</b></div><div><span>+ 20 %</span><b>144,00</b></div><p>Ergebnis <strong>144,00</strong></p></div> : tool.id === 'message' ? <div class="spotlight-message-scene" aria-hidden="true"><img src="/markers/message-marker.svg" width="64" height="80" alt=""/><strong>MessageDrop</strong><span>Ein Ort. Eine Nachricht.</span></div> : <div class="preview-clock" aria-hidden="true"><span>{tool.name}</span><strong>{tool.value}</strong><span>{tool.id === 'timer' ? 'Fokuszeit' : tool.id === 'clock' ? 'Deine Zeit. Dein Stil.' : 'Verstrichene Zeit'}</span></div>}
      <p class="art-footnote">{tool.note}</p>
    </div>
  </template>)}
  <script is:inline>
    (() => {
      const hero = document.getElementById('company-spotlight');
      const variants = Array.from(document.querySelectorAll('template[data-spotlight]'));
      function selectSpotlight() {
        if (!hero || !variants.length) return;
        const choice = variants[Math.floor(Math.random() * variants.length)];
        hero.replaceChildren(choice.content.cloneNode(true));
        hero.dataset.tool = choice.dataset.spotlight;
      }
      // Choose while parsing, before the hero is first painted. No persistent storage.
      selectSpotlight();
      window.addEventListener('pageshow', event => { if (event.persisted) selectSpotlight(); });
    })();
  </script>
  <section class="tools-section" id="tools" aria-labelledby="tools-heading"><div class="section-heading"><div><p class="eyebrow">DIE JACKTOOLS.NET-FAMILIE</p><h2 id="tools-heading">Online-Tools für Zeit, Fokus und Entspannung</h2></div><p>Wähle den passenden Helfer – direkt im Browser, ohne Anmeldung.</p></div>
    <nav class="tool-shortcuts" aria-label="Toolübersicht"><a href="#online-timer">Timer</a><a href="#online-uhr">Uhr</a><a href="#online-stoppuhr">Stoppuhr</a><a href="#taschenrechner">Taschenrechner</a><a href="#atemuebungen">Atemübungen</a><a href="#naturgeraeusche">Naturgeräusche</a><a href="#messagedrop">MessageDrop</a></nav>
    <div class="product-grid time-tools-grid">
    <article id="online-timer" class="product-card timer-feature" aria-labelledby="timer-card-title"><div class="product-copy"><span class="product-tag">ZEIT & FOKUS</span><h3 id="timer-card-title">Online-Timer</h3><p>Stelle einen Countdown ein, plane Fokuszeiten mit Pomodoro oder wiederhole Aktivphasen und Pausen mit dem Intervalltimer. Für Küche, Lernen und eigene Routinen.</p><ul class="feature-list"><li>Countdown für kleine und große Vorhaben</li><li><a href="https://timer.jacktools.net/de/pomodoro/">Pomodoro für Fokus und regelmäßige Pausen</a></li><li><a href="https://timer.jacktools.net/de/training/">Intervalltimer für Aktivphasen und Pausen</a></li></ul><a class="primary tool-open" href="https://timer.jacktools.net/de/" rel="noreferrer">Countdown-Timer öffnen <span aria-hidden="true">↗</span></a><p class="product-note">Kostenlos · ohne Benutzerkonto · direkt im Browser</p></div><div class="timer-preview" aria-label="Statische Vorschau des Timers"><div class="preview-tabs"><span>Countdown</span><span class="active">Pomodoro</span><span>Intervall</span></div><div class="small-clock"><span>FOKUSZEIT</span><strong>25:00</strong><span>Runde 1 von 4</span></div><p>Deine Zeit. Dein Rhythmus.</p></div></article>
    <article id="online-uhr" class="product-card timer-feature clock-feature" aria-labelledby="clock-card-title">
      <div class="product-copy"><span class="product-tag">UHRZEIT & DATUM</span><h3 id="clock-card-title">Online-Uhr mit Datum</h3><p>Zeige die Uhrzeit analog, digital oder mit Klappzahlen an. Wähle Datum, Zeitzone und Design – für Schreibtisch, Küche oder Unterricht.</p><ul class="feature-list"><li>Analog, digital oder mit animierten Klappzahlen</li><li>Kalenderblatt und weitere Datumsansichten</li><li>Zeitzonen, Fokusansicht und optionales Bildschirm-Wachhalten</li></ul><a class="primary tool-open" href="https://clock.jacktools.net/de/" rel="noreferrer">Online-Uhr öffnen <span aria-hidden="true">↗</span></a><p class="product-note">Kostenlos · ohne Benutzerkonto · direkt im Browser</p></div>
      <div class="timer-preview clock-preview" role="img" aria-label="Statische Vorschau der Uhr: analoges Zifferblatt und Kalenderblatt">
        <div class="preview-tabs" aria-hidden="true"><span class="active">Analog</span><span>Digital</span><span>Klappzahlen</span></div>
        <div class="company-clock-scene" aria-hidden="true"><svg viewBox="0 0 240 240" class="company-clock-dial"><circle cx="120" cy="120" r="110"/>{Array.from({length:12},(_,i)=><path d="M120 20v8" transform={'rotate('+i*30+' 120 120)'}/>)}<path class="company-hour-hand" d="M120 120 84 96"/><path class="company-minute-hand" d="M120 120 165 60"/><circle class="company-clock-hub" cx="120" cy="120" r="4"/></svg><div class="company-calendar"><span>OKTOBER</span><strong>05</strong><small>Montag · 2026</small></div></div>
        <p>Deine Uhr. Dein Stil.</p>
      </div>
    </article>
    <article id="online-stoppuhr" class="product-card timer-feature stopwatch-feature" aria-labelledby="stopwatch-card-title">
      <div class="product-copy"><span class="product-tag">ZEITMESSUNG & RUNDEN</span><h3 id="stopwatch-card-title">Online-Stoppuhr mit Rundenzeiten</h3><p>Miss verstrichene Zeit, halte einzelne Runden fest und vergleiche Runden- und Gesamtzeiten. Für Übungen, Lernaufgaben oder kleine Experimente.</p><ul class="feature-list"><li>Starten, pausieren und ohne Zeitverlust fortsetzen</li><li>Rundenzeiten kopieren oder als CSV exportieren</li><li>Analoge, digitale oder kombinierte Anzeige und Fokusansicht</li></ul><a class="primary tool-open" href="https://stopwatch.jacktools.net/de/" rel="noreferrer">Stoppuhr öffnen <span aria-hidden="true">↗</span></a><p class="product-note">Kostenlos · ohne Benutzerkonto · direkt im Browser</p></div>
      <div class="timer-preview stopwatch-preview" role="img" aria-label="Statische Vorschau der Stoppuhr mit Zeitmessung und zwei Rundenzeiten"><div class="preview-tabs" aria-hidden="true"><span class="active">Stoppuhr</span><span>Runden</span><span>CSV-Export</span></div><div class="small-clock" aria-hidden="true"><span>VERSTRICHENE ZEIT</span><strong>01:24<span class="preview-hundredths">.36</span></strong><span>Runde 2</span></div><div class="preview-laps" aria-hidden="true"><span>Runde 1 <b>00:42.18</b></span><span>Runde 2 <b>00:42.18</b></span></div></div>
    </article>
    <article id="taschenrechner" class="product-card timer-feature calculator-feature" aria-labelledby="calculator-card-title">
      <div class="product-copy"><span class="product-tag">RECHNEN & NACHVOLLZIEHEN</span><h3 id="calculator-card-title">Online-Taschenrechner mit Rechenstreifen</h3><p>Behalte deinen Rechenweg im Blick. Jeder Schritt nutzt das vorherige Ergebnis und lässt sich benennen, bearbeiten, verschieben oder deaktivieren.</p><ul class="feature-list"><li>Prozentwerte, Aufschläge und Steuern berechnen</li><li>Rechenschritte ändern und Ergebnisse neu berechnen lassen</li><li>Berechnungen als Datei speichern, wieder öffnen oder drucken</li></ul><a class="primary tool-open" href="https://calculator.jacktools.net/de/" rel="noreferrer">Taschenrechner öffnen <span aria-hidden="true">↗</span></a><p class="product-note">Kostenlos · ohne Benutzerkonto · direkt im Browser</p></div>
      <div class="timer-preview calculator-preview" role="img" aria-label="Statische Vorschau eines Rechenstreifens: 100 plus 20 Prozent ergibt 120, anschließend plus 20 Prozent ergibt 144"><div class="preview-tabs" aria-hidden="true"><span class="active">Rechenstreifen</span><span>Prozent</span><span>Drucken</span></div><div class="company-calculation" aria-hidden="true"><span>DEIN RECHENWEG</span><div><span>Startwert</span><b>100,00</b></div><div><span>+ 20 %</span><b>120,00</b></div><div><span>+ 20 %</span><b>144,00</b></div><p>Ergebnis <strong>144,00</strong></p></div><p>Schritt für Schritt. Klar und nachvollziehbar.</p></div>
    </article>
    <article id="atemuebungen" class="product-card timer-feature breathe-feature" aria-labelledby="breathe-card-title">
      <div class="product-copy"><span class="product-tag">ATEM & RUHE</span><h3 id="breathe-card-title">Breathe – Atemübungen online</h3><p>Breathe begleitet deine ruhige Pause mit einem sanften Atemrhythmus. Folge dem wachsenden und schrumpfenden Kreis – in deinem Tempo und ohne Druck.</p><ul class="feature-list"><li>Quadratatmen, 4–7–8 und weitere einstellbare Atemmuster</li><li>Optionales Atemrauschen und sanfte Phasensignale</li><li>Fokusansicht, Vollbild und optionales Bildschirm-Wachhalten</li></ul><a class="primary tool-open" href="https://breathe.jacktools.net/de/" rel="noreferrer">Atemübungen öffnen <span aria-hidden="true">↗</span></a><p class="product-note">Kostenlos · ohne Benutzerkonto · direkt im Browser</p><p class="breathe-product-hint">Atme nur so, wie es angenehm ist. Ein Entspannungstool, kein medizinisches Angebot.</p></div>
      <div class="timer-preview breathe-preview" role="img" aria-label="Statische Vorschau von Breathe: Verlaufskreis mit Atemphase und äußerem Fortschrittsring">
        <div class="preview-tabs" aria-hidden="true"><span class="active">Quadratatmen</span><span>4–7–8</span><span>Dein Rhythmus</span></div>
        <div class="company-breathe-scene" aria-hidden="true"><svg viewBox="0 0 100 100" class="company-breathe-ring"><circle cx="50" cy="50" r="48"/><circle class="company-breathe-progress" cx="50" cy="50" r="48" pathLength="100"/></svg><div class="company-breathe-circle"></div><div class="company-breathe-tile"><span>Einatmen</span><strong>4</strong></div></div>
        <p>Dein Atem. Dein Tempo.</p>
      </div>
    </article>
    <article id="naturgeraeusche" class="product-card timer-feature breathe-feature relax-feature" aria-labelledby="relax-card-title">
     <div class="product-copy"><span class="product-tag">KLANG & ENTSPANNUNG</span><h3 id="relax-card-title">Relax – Naturgeräusche und Klänge</h3><p>Stelle dir deine eigene Klanglandschaft zusammen. Sanfte Instrumente und Naturgeräusche treffen auf ruhige, farbige Animationen – zum Zuhören, Zuschauen und Abschalten.</p><ul class="feature-list"><li>Sieben Instrumente: vom Windspiel bis zu Klangschalen, Harfe und Gong</li><li>Regen, Wind, Rauschen, Lagerfeuer und Meeresrauschen frei kombinieren</li><li>Klang-Presets, eigene Lautstärken und einzeln schaltbare Animationen</li><li>Fokusansicht und Schlafmodus mit sanftem Ausblenden bei begrenzter Dauer</li></ul><a class="primary tool-open" href="https://relax.jacktools.net/de/" rel="noreferrer">Naturgeräusche öffnen <span aria-hidden="true">↗</span></a><p class="product-note">Kostenlos · ohne Werbung · ohne Tracking · direkt im Browser</p><p class="breathe-product-hint">Höre leise und so, wie es angenehm ist. Ein Entspannungstool, kein medizinisches Angebot.</p></div>
     <div class="timer-preview relax-preview" role="img" aria-label="Statische Vorschau von Relax: farbige Formen und sanfte Meereswellen"><div class="preview-tabs" aria-hidden="true"><span>Instrumente</span><span class="active">Naturklänge</span><span>Deine Mischung</span></div><RelaxPreview/><p>Zuhören. Zuschauen. Zur Ruhe kommen.</p></div>
    </article>
    <article id="messagedrop" class="product-card timer-feature message-card" aria-labelledby="message-card-title"><div class="message-art timer-preview" role="img" aria-label="Stilisierte Karte mit MessageDrop-Markern für Nachrichten, Bilder und Orte"><svg class="message-map" viewBox="0 0 600 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect class="map-ground" width="600" height="300"/><path class="map-park" d="M420 0h180v155c-55 25-87-15-110-40S400 50 420 0Z"/><path class="map-water" d="M560-20c-80 65 70 100-10 165s-35 115 25 175"/><g class="map-blocks"><path d="M40 35h95v55H40zM175 25h110v65H175zM325 20h60v85h-60zM25 135h110v60H25zM170 140h115v55H170zM330 150h80v60h-80zM35 240h100v50H35zM175 245h110v55H175zM335 255h110v45H335z"/></g><g class="map-roads"><path d="M-20 112 630 120M-20 225 630 240M150-20 155 330M300-20 310 330M410-20 475 330"/></g><path class="map-path" d="m70 60 140 105 150 10 110-95"/></svg><img class="message-marker marker-message" src="/markers/message-marker.svg" width="44" height="55" alt="" aria-hidden="true" loading="lazy" /><img class="message-marker marker-image" src="/markers/image-marker.svg" width="40" height="50" alt="" aria-hidden="true" loading="lazy" /><img class="message-marker marker-location" src="/markers/location-marker.svg" width="36" height="45" alt="" aria-hidden="true" loading="lazy" /></div><div class="product-copy"><span class="product-tag">ORTE & NACHRICHTEN</span><h3 id="message-card-title">MessageDrop – Nachrichten auf der Karte</h3><p>Die Welt hat etwas zu erzählen. Hinterlasse Nachrichten an realen Orten auf einer globalen Karte und entdecke, was andere dort teilen.</p><a class="primary tool-open" href="https://app.messagedrop.de" rel="noreferrer">MessageDrop öffnen <span aria-hidden="true">↗</span></a><p class="product-note">Kostenlos · ohne Benutzerkonto · direkt im Browser</p></div></article>
    </div>
    <aside class="tool-suggestion"><h3>Fehlt dir ein Helfer?</h3><p>Wir entwickeln die Sammlung weiter. Teile uns mit, welches Tool deinen Alltag leichter machen würde.</p><a class="text-link" href="mailto:jacktoolsnet@gmail.com">Eine Idee vorschlagen ↗</a></aside>
  </section>
  <section class="idea-section" id="idee"><p class="eyebrow">DIE IDEE DAHINTER</p><h2>Tools sollen helfen.<br /><em>Nicht im Weg stehen.</em></h2><p>Wir mögen klare Oberflächen, sinnvolle Funktionen und die Freiheit, Dinge auf die eigene Art zu machen. Deshalb kannst du auch diese Seite anpassen: Farbe, Stil, Hell- oder Dunkelmodus und Schriftgröße findest du oben im Einstellungsmenü.</p><div class="values-grid"><div><span>01 / EINFACH</span><h3>Weniger drumherum.</h3><p>Das Wesentliche im Mittelpunkt. Damit du schnell findest, was du brauchst.</p></div><div><span>02 / PERSÖNLICH</span><h3>So, wie du es magst.</h3><p>Ein ruhiges Design, das sich deinen Vorlieben anpassen lässt.</p></div><div><span>03 / NEUGIERIG</span><h3>Immer Raum für Ideen.</h3><p>Aus kleinen Gedanken können hilfreiche Tools werden. Wir bleiben neugierig.</p></div></div></section>
</Layout>
