# No file needed for the defaults: local API in dev, backend.jacktools.net in production.
# In development this is the server-side proxy target; browser requests stay same-origin.
# Public API address ONLY. Never put ROOT_* or database credentials here.
# Optional production override:
# PUBLIC_BACKEND_URL=https://backend.jacktools.net
# For a different local API, put this in .env.development.local (not the general .env):
# PUBLIC_BACKEND_URL=http://127.0.0.1:4340
