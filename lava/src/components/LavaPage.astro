---
import ToolInformation from '../../../shared/ToolInformation.astro';
import {toolSeo} from '../../../shared/seo';
import Layout from '../layouts/Layout.astro';
import { type Language } from '../lib/i18n';
interface Props {lang: Language}
const {lang}=Astro.props;
const labels={
de:['Lavalampe','Ein wenig Licht. Ein Moment für dich.','Lass die Gedanken ziehen und die Lava fließen. Ganz ohne Ton, ganz ohne Eile.','Farbwelt','Glut','Amethyst','Lagune','Rosenlicht','Geschwindigkeit','Helligkeit','Starten','Pausieren','Fokusansicht','Vollbild ist hier nicht verfügbar.','Langsame Lichtbewegung zum Entspannen. Bei Unwohlsein pausieren.','Bewegung ist reduziert. Starte die Animation, wenn du möchtest.'],
en:['Lava lamp','A little light. A moment for yourself.','Let your thoughts drift and the lava flow. No sound, no hurry.','Colour world','Ember','Amethyst','Lagoon','Rose glow','Speed','Brightness','Start','Pause','Focus view','Fullscreen is unavailable here.','Slow moving light for a quiet break. Pause if uncomfortable.','Reduced motion is enabled. Start the animation if you wish.'],
es:['Lámpara de lava','Un poco de luz. Un momento para ti.','Deja fluir tus pensamientos y la lava. Sin sonido, sin prisa.','Colores','Brasa','Amatista','Laguna','Luz rosa','Velocidad','Brillo','Iniciar','Pausar','Vista de enfoque','Pantalla completa no disponible.','Luz en movimiento lento para descansar. Pausa si te incomoda.','Movimiento reducido activado. Inicia la animación si lo deseas.'],
fr:['Lampe à lave','Un peu de lumière. Un moment pour toi.','Laisse tes pensées et la lave suivre leur cours. Sans son, sans hâte.','Couleurs','Braise','Améthyste','Lagon','Lueur rose','Vitesse','Luminosité','Démarrer','Pause','Vue de concentration','Le plein écran est indisponible ici.','Une lumière lente pour une pause tranquille. Arrête en cas de gêne.','Mouvement réduit activé. Lance l’animation si tu le souhaites.']
};
const t=labels[lang];
const seo=toolSeo.lava[lang];
const materialLabels={de:['Silber / Metall','Kupfer','Gold','Ölschimmer'],en:['Silver / metal','Copper','Gold','Oil shimmer'],es:['Plata / metal','Cobre','Oro','Brillo de aceite'],fr:['Argent / métal','Cuivre','Or','Reflets d’huile']}[lang];
const rainbowLabel={de:'Regenbogen',en:'Rainbow',es:'Arcoíris',fr:'Arc-en-ciel'}[lang];
const settingsTitle={de:'Einstellungen',en:'Settings',es:'Ajustes',fr:'Réglages'}[lang];
---
<Layout lang={lang} title={seo.title} description={seo.description} route="">
<section class="lava-intro"><p class="eyebrow">JACKTOOLS / RELAX</p><h1>{seo.heading}</h1><p class="lava-tagline">{t[1]}</p><p class="intro-copy">{seo.description}</p></section>
<section class="lava-tool" aria-label={t[0]}>
 <div class="lava-stage" id="lava-stage">
  <div class="ambient" aria-hidden="true"></div>
  <div class="lava-liquid" aria-hidden="true"><canvas id="lava-canvas"></canvas><div class="fallback"><i></i><i></i><i></i></div></div>
  <button class="stage-focus" id="lava-fullscreen" data-error={t[13]}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg><span>{t[12]}</span></button>
  <button class="stage-play" id="lava-toggle" data-start={t[10]} data-pause={t[11]} aria-label={t[10]} title={t[10]} aria-pressed="false"><svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z"/></svg><svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg></button>

  <button class="fullscreen-exit" id="exit-fullscreen" aria-label={lang === 'de' ? 'Fokus verlassen' : lang === 'es' ? 'Salir del enfoque' : lang === 'fr' ? 'Quitter la concentration' : 'Leave focus'}>×</button>
 </div>
 <section class="settings-card relax-settings lava-controls" aria-labelledby="lava-settings-title">
 <h2 id="lava-settings-title">{settingsTitle}</h2>
 <div class="relax-settings-grid">
  <section class="settings-tile"><h3>{t[3]}</h3>
   <div class="relax-field"><details id="lava-colour-picker" class="sound-dropdown"><summary aria-label={t[3]}><span id="lava-colour-value">{t[4]}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
    <fieldset class="instrument-options"><legend class="sr-only">{t[3]}</legend>{['ember','amethyst','lagoon','rose','rainbow','silver','copper','gold','oil'].map((color,i)=><label><input type="radio" name="lava-color" value={i} checked={i===0}/><span class="lava-swatch" data-lava-color={color} aria-hidden="true"></span><span class="instrument-option-copy"><strong>{i>4?materialLabels[i-5]:i===4?rainbowLabel:t[i+4]}</strong></span><svg class="instrument-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4 10-10"/></svg></label>)}</fieldset>
   </details></div>
  </section>
  <section class="settings-tile"><h3>{t[8]}</h3><label class="relax-field" for="lava-speed"><span class="sr-only">{t[8]}</span><input id="lava-speed" type="range" min="0.25" max="1.75" step="0.05" value="1"/><output id="speed-value">1×</output></label></section>
  <section class="settings-tile"><h3>{t[9]}</h3><label class="relax-field" for="lava-brightness"><span class="sr-only">{t[9]}</span><input id="lava-brightness" type="range" min="25" max="100" value="85"/><output id="brightness-value">85 %</output></label></section>
 </div>
 <p id="lava-status" role="status" data-reduced={t[15]}></p>
 </section>
</section>
<ToolInformation lang={lang} tool="lava" />
<noscript><p>JavaScript is required for the animation. / Für die Animation wird JavaScript benötigt.</p></noscript>
<script src="../scripts/lava.ts"></script>
</Layout>
<style is:global>
.lava-intro{text-align:center;margin:2rem auto;max-width:650px}.lava-intro h1{font-size:clamp(2.5rem,6vw,4rem);margin:.4rem}.lava-tagline{font-size:1.25rem}.lava-tool{max-width:1050px;margin:0 auto 3rem}.lava-stage{position:relative;height:570px;overflow:hidden;border-radius:28px;background:radial-gradient(ellipse at 50% 70%,#30202b 0,#15121e 45%,#0c0b12 100%);display:grid;place-items:center;isolation:isolate;--glow:#ff703e;--brightness:.85}.ambient{position:absolute;width:340px;height:320px;top:130px;background:var(--glow);filter:blur(100px);opacity:.13;pointer-events:none}.lava-liquid{position:absolute;inset:0;filter:brightness(var(--brightness))}.lava-liquid canvas{width:100%;height:100%;display:block}.lava-controls{margin-top:28px}.lava-controls .relax-settings-grid{align-items:stretch}.lava-controls .relax-field{position:relative;display:grid;gap:10px;font-size:calc(13px * var(--font-scale,1))}.lava-controls input[type=range]{width:100%;accent-color:var(--accent);margin:8px 0}.lava-controls output{color:var(--muted);font-size:calc(12px * var(--font-scale,1));font-variant-numeric:tabular-nums}#lava-colour-picker .instrument-options{max-height:340px;overflow-y:auto;overscroll-behavior:contain}[data-lava-color=silver]{background:linear-gradient(135deg,#515c6b,#f4f7ff,#7a879a)}[data-lava-color=copper]{background:linear-gradient(135deg,#733723,#f6b18b,#a95332)}[data-lava-color=gold]{background:linear-gradient(135deg,#8a5d14,#fff0a0,#c39029)}[data-lava-color=oil]{background:linear-gradient(135deg,#222336,#aa6cde,#4ddbc6,#ec9dbd)}.lava-stage[data-material=oil] .fallback i{background:linear-gradient(135deg,#554577,#68cbbf,#b379bc)}.lava-swatch{width:16px;height:16px;flex-shrink:0;border-radius:50%;background-color:#ff763f}[data-lava-color=amethyst]{background:#b784ff}[data-lava-color=lagoon]{background:#50e8cc}[data-lava-color=rose]{background:#ff80b5}[data-lava-color=rainbow]{background:conic-gradient(#ff6060,#ffd94b,#51e68b,#4cb7ff,#b67aff,#ff6060)}.lava-stage[data-rainbow=true] .fallback{background:linear-gradient(135deg,#411c5c,#173c50,#4f2920)}.lava-stage[data-rainbow=true] .fallback i{background:linear-gradient(150deg,#ff7676,#b784ff,#50e8cc)}.stage-focus,.stage-play{position:absolute;z-index:3;display:flex;align-items:center;justify-content:center;color:#f7f2ff;background:#211a2cde;border:1px solid #84758f80;backdrop-filter:blur(8px)}.stage-focus{top:18px;right:18px;gap:8px;padding:10px 14px;border-radius:12px;font-size:.85rem;min-height:44px}.stage-focus svg{width:18px;height:18px}.stage-play{bottom:24px;left:50%;transform:translateX(-50%);width:52px;height:52px;border-radius:50%;box-shadow:0 4px 18px #0005}.stage-play .play-icon{fill:currentColor;stroke:none;width:24px;height:24px;margin-left:1px}.stage-play .pause-icon{stroke-width:3;display:none}.stage-play[aria-pressed=true] .play-icon{display:none}.stage-play[aria-pressed=true] .pause-icon{display:block}.lava-stage:fullscreen .stage-focus{display:none}.lava-note,#lava-status{font-size:.85rem;opacity:.8}.fullscreen-exit{display:none;position:absolute;z-index:4;top:20px;right:20px;background:#18131f;color:white;border:1px solid #84758f;border-radius:50%;width:44px;height:44px;font-size:28px}.lava-stage:fullscreen{height:100%;border-radius:0}.lava-stage:fullscreen .fullscreen-exit{display:block}.fallback{display:none;position:absolute;inset:0;background:radial-gradient(ellipse at bottom,var(--glow),#21102c 70%)}.fallback i{position:absolute;left:25%;top:15%;width:15%;height:30%;border-radius:48% 52% 65% 35%;background:var(--glow);box-shadow:0 0 28px var(--glow)}.fallback i:nth-child(2){top:70%;left:50%;width:25%}.fallback i:nth-child(3){top:8%;left:70%;width:10%;height:18%}.no-webgl .fallback{display:block}@media(max-width:600px){.lava-stage{height:510px}.lava-sliders{grid-template-columns:1fr;gap:.5rem}.lava-intro{padding:0 8px}.lava-colours span{padding:8px 10px}}
</style>
