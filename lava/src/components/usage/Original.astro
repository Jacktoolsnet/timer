---
import UsageLanguageNav from '../../../../shared/UsageLanguageNav.astro';
import Layout from '../../layouts/Layout.astro';
import {usageCopy} from '../../lib/usage';
interface Props {lang:'de'|'en'}
const {lang}=Astro.props;
const de=lang==='de', t=usageCopy[lang];
---
<Layout lang={lang} title={t.title} description={de?'Bedienung, Einstellungen und technische Grenzen der Jacktools-Lavalampe.':'Controls, preferences and technical limits of the Jacktools lava lamp.'} route="usage" noindex legal>
 <article class="legal-page">
  <h1>{t.title}</h1>
  <UsageLanguageNav lang={lang}/>
  <p>{de?'Stand: 20. Oktober 2026. Die deutsche Fassung ist die Originalfassung; Englisch ist eine Übersetzung.':'Last updated: 20 October 2026. German is the original; English is a translation.'}</p>
  <p>{t.intro}</p>
  {t.sections.map(section=><section><h2>{section.title}</h2><ul>{section.items.map(item=><li>{item}</li>)}</ul></section>)}
  <p><a href={'/'+lang+'/privacy/'}>{de?'Datenschutzerklärung':'Privacy notice'}</a></p>
  <p class="legal-back"><a href={'/'+lang+'/'}>← Lava</a></p>
 </article>
</Layout>
